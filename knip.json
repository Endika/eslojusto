{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,ts}"]
    },
    "api": {
      "entry": ["src/handlers/*.ts", "infra/app.ts"],
      "ignoreDependencies": ["esbuild"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  }
}
