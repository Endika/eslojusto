{
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "description": "One entry per attached page, in order: its kind, the number of its document and its readability.",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "The number given before the page."
          },
          "kind": {
            "type": "string",
            "enum": ["electricity_bill", "electricity_contract", "price_change_notice", "other"],
            "description": "electricity_bill: a household electricity bill (factura de la luz), any of its pages. electricity_contract: the supply contract or its particular or general conditions. price_change_notice: a notice that the prices or conditions change. other: anything else, such as a gas bill, a phone bill or an ID card."
          },
          "document": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Number the documents in order of appearance; all pages of one document get the same number."
          },
          "readability": {
            "type": "object",
            "description": "ok: legible enough to transcribe, in whatever language. Otherwise the main reason the page cannot be used: handwritten (the values are written by hand), blurry, dark, cropped (the part with the values is cut off), not_electricity_document (not about a household electricity supply), foreign_jurisdiction (a supply outside Spain; never because of its language), unknown_format (about an electricity supply, but no kind of document you know).",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "ok",
                  "handwritten",
                  "blurry",
                  "dark",
                  "cropped",
                  "not_electricity_document",
                  "foreign_jurisdiction",
                  "unknown_format"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "required": ["value", "confidence"],
            "additionalProperties": false
          },
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "description": "Leave it out: each bill gives its own period in its fields."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["page", "kind", "document", "readability", "confidence"],
        "additionalProperties": false
      }
    },
    "electricity_bill": {
      "type": "object",
      "description": "Household electricity bills (facturas de la luz), one entry per bill. Leave the section out when no attached document is one.",
      "properties": {
        "bills": {
          "type": "array",
          "description": "Every bill (factura), one entry each, with its own figures; past twelve, the twelve most recent.",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "document": {
                "type": "integer",
                "minimum": 1,
                "maximum": 25,
                "description": "The number of the document (as given in pages) of the bill this row belongs to."
              },
              "retailerName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The retailer (comercializadora): its company name as printed."
              },
              "market": {
                "type": "string",
                "enum": ["pvpc", "free"],
                "description": "pvpc when the bill says it is billed at the regulated price (precio voluntario para el pequeño consumidor, PVPC); free for a free-market contract (mercado libre)."
              },
              "invoiceNumber": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "The bill number (nº de factura) as printed."
              },
              "issuedOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date the bill was issued (fecha de emisión, de factura)."
              },
              "dueOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date it is charged or must be paid by (fecha de cargo, fecha límite de pago, vencimiento)."
              },
              "readingFrom": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the first reading of the period (lectura anterior, desde)."
              },
              "readingTo": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the last reading of the period (lectura actual, hasta)."
              },
              "billedDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 366,
                "description": "Days billed, only if printed (días facturados)."
              },
              "readingKind": {
                "type": "string",
                "enum": ["real", "estimated"],
                "description": "real when the last reading is real (lectura real); estimated when it is estimated (estimada)."
              },
              "supplyFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "description": "The supply point code (CUPS) exactly as printed, which starts with ES and has 20 to 22 characters."
              },
              "postcode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5,
                "pattern": "^[0-9]{5}$",
                "description": "The postcode (código postal) of the supply address, five digits. Never the rest of the address."
              },
              "accessTariff": {
                "type": "string",
                "enum": ["2.0TD", "3.0TD", "6.1TD", "other"],
                "description": "The access tariff (peaje de acceso, tarifa de acceso): 2.0TD, 3.0TD, 6.1TD or other."
              },
              "selfConsumption": {
                "type": "string",
                "enum": ["none", "without_surplus", "with_surplus"],
                "description": "none when the bill shows no self-consumption (autoconsumo); without_surplus (sin excedentes); with_surplus when it bills or offsets surplus energy (excedentes, compensación)."
              },
              "contractedPowerP1": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "Contracted power in P1 (potencia contratada punta), in kW."
              },
              "contractedPowerP2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "Contracted power in P2 (potencia contratada valle), in kW."
              },
              "maxPowerUsedP1": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "Highest power demanded in P1 in the last 12 months (potencia máxima demandada), in kW."
              },
              "maxPowerUsedP2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "The same in P2, in kW."
              },
              "tollsAndChargesPower": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "What the bill says the tolls and charges (peajes y cargos) come to within the power term."
              },
              "tollsAndChargesEnergy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "The same within the energy term."
              },
              "socialBonusFunding": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Funding of the social bonus (financiación del bono social), its amount."
              },
              "socialBonusCategory": {
                "type": "string",
                "enum": ["vulnerable", "severe"],
                "description": "Only when the bill applies the social bonus discount: vulnerable or severe (vulnerable severo)."
              },
              "socialBonusPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "The social bonus discount rate, 42,5 % is 42.5."
              },
              "socialBonusKwh": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000,
                "description": "kWh the discount applies to, if printed."
              },
              "socialBonusAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "The social bonus discount (descuento bono social), as a positive."
              },
              "excessPowerAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Charge for power above the contracted (exceso de potencia)."
              },
              "electricityTaxBase": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Base of the electricity tax (impuesto eléctrico, IEE)."
              },
              "electricityTaxPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Its rate as printed, 5,11269632 % is 5.11269632."
              },
              "electricityTaxAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Its amount."
              },
              "meterAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Meter rental (alquiler de equipos de medida), its amount."
              },
              "meterDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 366,
                "description": "Days of meter rental billed, if printed."
              },
              "meterPhase": {
                "type": "string",
                "enum": ["single", "three"],
                "description": "single (monofásico) or three (trifásico), only if printed."
              },
              "exitPenaltyAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "A penalty for ending the contract (penalización por baja, por resolución anticipada)."
              },
              "vatBase": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "VAT base (base imponible del IVA)."
              },
              "vatPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "VAT rate, 21 % is 21."
              },
              "vatAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "VAT amount (cuota de IVA)."
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Total of the bill (total factura, total a pagar)."
              },
              "commitmentEndOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date the commitment ends (fin de permanencia), if printed."
              }
            },
            "required": ["document", "confidence"],
            "additionalProperties": false
          }
        },
        "powerLines": {
          "type": "array",
          "description": "Every line of the power term (término de potencia), one per period and per stretch when the price changes within the bill.",
          "maxItems": 24,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "document": {
                "type": "integer",
                "minimum": 1,
                "maximum": 25,
                "description": "The number of the document (as given in pages) of the bill this row belongs to."
              },
              "period": {
                "type": "string",
                "enum": ["p1", "p2"],
                "description": "p1 (punta) or p2 (valle)."
              },
              "kw": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "kW billed."
              },
              "price": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "Price per kW as printed, with every decimal."
              },
              "unit": {
                "type": "string",
                "enum": ["per_kw_day", "per_kw_year"],
                "description": "per_kw_day (€/kW día) or per_kw_year (€/kW año)."
              },
              "days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 366,
                "description": "Days of the line."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Amount of the line."
              }
            },
            "required": ["document", "period", "amount", "confidence"],
            "additionalProperties": false
          }
        },
        "energyLines": {
          "type": "array",
          "description": "Every line of the energy term (término de energía), one per period and per stretch when the price changes within the bill.",
          "maxItems": 36,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "document": {
                "type": "integer",
                "minimum": 1,
                "maximum": 25,
                "description": "The number of the document (as given in pages) of the bill this row belongs to."
              },
              "period": {
                "type": "string",
                "enum": ["p1", "p2", "p3"],
                "description": "p1 (punta), p2 (llano) or p3 (valle)."
              },
              "kwh": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000,
                "description": "kWh billed."
              },
              "price": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "Price per kWh as printed, with every decimal."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Amount of the line."
              }
            },
            "required": ["document", "period", "amount", "confidence"],
            "additionalProperties": false
          }
        },
        "otherLines": {
          "type": "array",
          "description": "Every other line of the bill that is not power, energy, social bonus, meter rental, exceso de potencia, taxes or a penalty: services, discounts and regularisations of earlier bills.",
          "maxItems": 24,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "document": {
                "type": "integer",
                "minimum": 1,
                "maximum": 25,
                "description": "The number of the document (as given in pages) of the bill this row belongs to."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "service",
                  "discount",
                  "regularization_charge",
                  "regularization_refund",
                  "other"
                ],
                "description": "service (a product or service besides the energy), discount (descuento), regularization_charge (regularización cobrada), regularization_refund (regularización a tu favor, abono), other."
              },
              "serviceLabel": {
                "type": "string",
                "enum": ["maintenance", "insurance", "pack", "other"],
                "description": "For a service only: maintenance (mantenimiento, servicio técnico, asistencia), insurance (seguro, protección de pagos), pack (pack, servicio combinado), other."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Its amount, as a positive."
              }
            },
            "required": ["document", "kind", "amount", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "electricity_contract": {
      "type": "object",
      "description": "The electricity supply contract (contrato de suministro) and its conditions. Leave the section out when no attached document is one.",
      "properties": {
        "signedOn": {
          "type": "object",
          "description": "Date of the contract.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "retailerName": {
          "type": "object",
          "description": "The retailer (comercializadora): its company name as printed.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "priceType": {
          "type": "object",
          "description": "fixed (precio fijo), variable (precio variable, revisable) or indexed (indexado al mercado).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["fixed", "variable", "indexed"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "durationMonths": {
          "type": "object",
          "description": "Duration of the contract in months.",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "renews": {
          "type": "object",
          "description": "true when it says it extends itself (prórroga tácita, renovación automática); false when it says it does not.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "exitPenaltyText": {
          "type": "object",
          "description": "The clause on a penalty for ending the contract early (penalización, resolución anticipada). Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "agreedPrices": {
          "type": "array",
          "description": "Every agreed price (precios pactados), one per term and period.",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "term": {
                "type": "string",
                "enum": ["power", "energy"],
                "description": "power (potencia) or energy (energía)."
              },
              "period": {
                "type": "string",
                "enum": ["p1", "p2", "p3"],
                "description": "p1, p2 or p3."
              },
              "price": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "The price as printed, with every decimal."
              },
              "unit": {
                "type": "string",
                "enum": ["per_kw_day", "per_kw_year", "per_kwh"],
                "description": "per_kw_day, per_kw_year or per_kwh."
              }
            },
            "required": ["term", "period", "price", "confidence"],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "array",
          "description": "Every additional service the contract includes and its cost.",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              },
              "serviceLabel": {
                "type": "string",
                "enum": ["maintenance", "insurance", "pack", "other"],
                "description": "For a service only: maintenance (mantenimiento, servicio técnico, asistencia), insurance (seguro, protección de pagos), pack (pack, servicio combinado), other."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Its cost in euros per month, if printed."
              }
            },
            "required": ["concept", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "price_change_notice": {
      "type": "object",
      "description": "A notice that the contract’s prices or conditions change (comunicación de modificación de precios o condiciones). Leave the section out when no attached document is one.",
      "properties": {
        "sentOn": {
          "type": "object",
          "description": "Date of the notice.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "appliesFrom": {
          "type": "object",
          "description": "Date the change applies from.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "separateFromBill": {
          "type": "object",
          "description": "true when it is a notice of its own; false when it is printed on a bill.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "priceChanges": {
          "type": "array",
          "description": "Every price it changes, one per term and period.",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "term": {
                "type": "string",
                "enum": ["power", "energy"],
                "description": "power or energy."
              },
              "period": {
                "type": "string",
                "enum": ["p1", "p2", "p3"],
                "description": "p1, p2 or p3."
              },
              "before": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "The price until the change."
              },
              "after": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "The price from the change."
              },
              "unit": {
                "type": "string",
                "enum": ["per_kw_day", "per_kw_year", "per_kwh"],
                "description": "per_kw_day, per_kw_year or per_kwh."
              }
            },
            "required": ["term", "period", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["pages"],
  "additionalProperties": false
}
