            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "invoiceOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the invoice."
              },
              "fee": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "The agency’s own fee (honorarios), before VAT."
              },
              "vat": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "VAT (IVA) of the invoice."
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Total of the invoice (total factura), outlays included."
              }
            },
            "required": ["total", "confidence"],
            "additionalProperties": false
          }
        },
        "agencySupplied": {
          "type": "array",
          "description": "Every outlay the agency paid and passed on (suplidos, provisión de fondos aplicada), one entry each.",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "concept": {
                "type": "string",
                "enum": ["ajd", "registry", "notary", "valuation", "other"],
                "description": "ajd (the stamp duty, Actos Jurídicos Documentados, modelo 600), registry (the land registry), notary, valuation (tasación), other."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Its amount, in euros."
              }
            },
            "required": ["concept", "amount", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "valuation_invoice": {
      "type": "object",
      "description": "Every invoice for the valuation of the home (tasación). Leave the section out when no attached document is one.",
      "properties": {
        "valuationInvoices": {
          "type": "array",
          "description": "Every valuation invoice, one entry each.",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "invoiceOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the invoice."
              },
              "base": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Taxable base (base imponible, honorarios, derechos de arancel)."
              },
              "vat": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "VAT (IVA) of the invoice."
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Total of the invoice (total factura), outlays included."
              }
            },
            "required": ["total", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ajd_form": {
      "type": "object",
      "description": "Every stamp duty or transfer tax return (modelo 600, autoliquidación de Actos Jurídicos Documentados o de Transmisiones Patrimoniales). Leave the section out when no attached document is one.",
      "properties": {
        "ajdForms": {
          "type": "array",
          "description": "Every return, one entry each.",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "concept": {
                "type": "string",
                "enum": ["loan", "purchase"],
                "description": "What it taxes: loan (the mortgage loan, préstamo hipotecario, constitución de hipoteca) or purchase (the purchase of the home, compraventa)."
              },
              "accruedOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date the tax accrued (fecha de devengo)."
              },
              "taxBase": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Taxable base (base imponible)."
              },
              "amountPaid": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Amount paid (total a ingresar, cuota)."
              },
              "paidOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date it was paid, if printed."
              },
              "paidByLender": {
                "type": "boolean",
                "description": "true when it shows the lender as the taxpayer (sujeto pasivo); false when it shows the borrower or buyer."
              }
            },
            "required": ["concept", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fein": {
      "type": "object",
      "description": "The European Standardised Information Sheet (Ficha Europea de Información Normalizada, FEIN). Leave the section out when no attached document is one.",
      "properties": {
        "deliveredOn": {
          "type": "object",
          "description": "Date it was handed over (fecha de entrega), if stated.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "principal": {
          "type": "object",
          "description": "Capital of the loan it offers.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "initialRate": {
          "type": "object",
          "description": "Initial nominal annual rate it offers.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fiae": {
      "type": "object",
      "description": "The Standardised Warnings Sheet (Ficha de Advertencias Estandarizadas, FiAE). Leave the section out when no attached document is one.",
      "properties": {
        "deliveredOn": {
          "type": "object",
          "description": "Date it was handed over (fecha de entrega), if stated.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transparency_deed": {
      "type": "object",
      "description": "The notarial act on the information given before the loan (acta notarial de transparencia, art. 15 Ley 5/2019). Leave the section out when no attached document is one.",
      "properties": {
        "actOn": {
          "type": "object",
          "description": "Date of the act.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "amountCharged": {
          "type": "object",
          "description": "What it bills the borrower (honorarios del acta), only if printed.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prepayment_statement": {
      "type": "object",
      "description": "Every statement of an early repayment, a change to a fixed rate or a move to another lender (liquidación de amortización anticipada, novación, subrogación). Leave the section out when no attached document is one.",
      "properties": {
        "operations": {
          "type": "array",
          "description": "Every operation, one entry each.",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the operation."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "partial_prepayment",
                  "full_prepayment",
                  "fixed_rate_novation",
                  "creditor_subrogation"
                ],
                "description": "partial_prepayment (amortización parcial), full_prepayment (cancelación, amortización total), fixed_rate_novation (novación a tipo fijo), creditor_subrogation (subrogación a otra entidad)."
              },
              "principal": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Capital repaid or switched (capital amortizado)."
              },
              "feeCharged": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Compensation or fee charged for it (compensación, comisión por amortización anticipada o por conversión)."
              },
              "feeConcept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept of that charge exactly as printed."
              },
              "premiumRefunded": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Insurance premium refunded (prima no consumida, extorno), if printed."
              }
            },
            "required": ["on", "kind", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["pages"],
  "additionalProperties": false
}
