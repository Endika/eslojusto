    "employment_payslips": {
      "type": "object",
      "description": "Payslips (nóminas) and their earnings lines. Leave the section out when no attached document is one.",
      "properties": {
        "payslips": {
          "type": "array",
          "description": "Every payslip; past six, the six most recent.",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "description": "Month of its pay period."
              },
              "periodStart": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "First day of the period."
              },
              "periodEnd": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Last day of the period."
              },
              "daysWorked": {
                "type": "integer",
                "minimum": 0,
                "maximum": 366,
                "description": "Days it pays."
              },
              "incidents": {
                "type": "boolean",
                "description": "Whether it shows an incident or absence. Never which."
              },
              "totalAccrued": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Total gross (total devengado)."
              },
              "partTimeCoefficient": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Part-time coefficient, as a %."
              },
              "agreementName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "description": "Collective agreement."
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Professional group or category."
              }
            },
            "required": ["month", "confidence"],
            "additionalProperties": false
          }
        },
        "lines": {
          "type": "array",
          "description": "Every earnings line (devengo) of those payslips; past sixty, the most recent; never deductions.",
          "maxItems": 60,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "description": "Month of its payslip."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept as printed."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Amount."
              },
              "category": {
                "type": "string",
                "enum": [
                  "salary",
                  "fixed_complement",
                  "variable",
                  "overtime",
                  "complementary_hours",
                  "in_kind",
                  "extra_pay",
                  "prorated_extra_pay",
                  "expenses",
                  "one_off",
                  "other"
                ],
                "description": "salary (base), fixed_complement (monthly plus: antigüedad, convenio), variable (incentivos), overtime, complementary_hours, in_kind, extra_pay (a full one), prorated_extra_pay, expenses (dietas), one_off (atrasos, bonus), other."
              }
            },
            "required": ["month", "concept", "amount", "category", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "employment_work_history": {
      "type": "object",
      "description": "Work history (vida laboral). Leave the section out when no attached document is one.",
      "properties": {
        "contracts": {
          "type": "array",
          "description": "Every row; past fifteen, the fifteen most recent.",
          "maxItems": 15,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "startDate": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Start (alta)."
              },
              "endDate": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "End (baja); omit while active."
