              "employerName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Only for a company employer: its name."
              },
              "accountCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 15,
                "pattern": "^[0-9]{2}[ /-]?[0-9]{7}[ /-]?[0-9]{2}$",
                "description": "Employer account code (C.C.C.)."
              },
              "partTimeCoefficient": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000,
                "description": "Part-time coefficient (C.T.P.), per thousand."
