{
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "description": "One entry per attached page, in order: its kind, the number of its document and its readability.",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "The number given before the page."
          },
          "kind": {
            "type": "string",
            "enum": ["insurance_policy", "insurance_renewal_notice", "other"],
            "description": "insurance_policy: an insurance policy (póliza), its particular, general or special conditions, certificate or premium receipt. insurance_renewal_notice: a notice that the policy renews or changes (aviso de renovación, de modificación de la prima o de las condiciones). other: anything else, such as an ID card, a claim report or a payslip."
          },
          "document": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Number the documents in order of appearance; all pages of one document get the same number."
          },
          "readability": {
            "type": "object",
            "description": "ok: legible enough to transcribe, in whatever language. Otherwise the main reason the page cannot be used: handwritten (the values are written by hand), blurry, dark, cropped (the part with the values is cut off), not_insurance_document (not about an insurance policy), foreign_jurisdiction (a policy under the law of another country; never because of its language), unknown_format (about an insurance policy, but no kind of document you know).",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "ok",
                  "handwritten",
                  "blurry",
                  "dark",
                  "cropped",
                  "not_insurance_document",
                  "foreign_jurisdiction",
                  "unknown_format"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "required": ["value", "confidence"],
            "additionalProperties": false
          },
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "description": "Leave it out: no insurance page has a month of its own."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["page", "kind", "document", "readability", "confidence"],
        "additionalProperties": false
      }
    },
    "insurance_policy": {
      "type": "object",
      "description": "Insurance policy (póliza: condiciones particulares, generales o especiales, certificado o recibo de la póliza). Leave the section out when no attached document is one.",
      "properties": {
        "line": {
          "type": "object",
          "description": "The line of insurance (ramo): home (hogar, multirriesgo del hogar), car (automóvil, vehículo, moto), life (vida), health (salud, asistencia sanitaria), funeral (decesos), other.",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["home", "car", "life", "health", "funeral", "other"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "carCover": {
          "type": "object",
          "description": "For a motor policy only: compulsory_only (solo responsabilidad civil obligatoria) or with_voluntary (also voluntary covers: terceros ampliado, todo riesgo, lunas, robo, asistencia).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["compulsory_only", "with_voluntary"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "insurerName": {
          "type": "object",
          "description": "The insurer (aseguradora, entidad aseguradora): its company name as printed.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "intermediaryType": {
          "type": "object",
          "description": "Who the intermediary (mediador, agente, corredor) is, if one appears: person (a natural person) or company.",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["person", "company"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "intermediaryCompanyName": {
          "type": "object",
          "description": "Only when the intermediary is a company: its name as printed. Never the name of a person.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "concludedOn": {
          "type": "object",
          "description": "Date the policy was taken out or issued (fecha de emisión, de contratación).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "effectiveOn": {
          "type": "object",
          "description": "Date the current period starts (fecha de efecto).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "expiresOn": {
          "type": "object",
          "description": "Date the current period ends (fecha de vencimiento).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "renews": {
          "type": "object",
          "description": "true when the policy says it extends itself each year (prórroga tácita, renovación automática); false when it says it does not.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "premiumNet": {
          "type": "object",
          "description": "Net premium of the period (prima neta).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "premiumSurcharges": {
          "type": "object",
          "description": "Surcharges (recargos: Consorcio, otros), added up as printed.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "premiumTaxes": {
          "type": "object",
          "description": "Taxes on the premium (impuestos, IPS).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "premiumTotal": {
          "type": "object",
          "description": "Total premium of the period (prima total, total recibo).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "proportionalRuleExcluded": {
          "type": "object",
          "description": "true when the policy says the proportional rule does not apply (sin regla proporcional, a primer riesgo, valor total); false when it says it applies.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "proportionalRuleMarginPercent": {
          "type": "object",
          "description": "Margin before the proportional rule applies (margen de tolerancia por infraseguro), 15 % is 15, if stated.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "channel": {
          "type": "object",
          "description": "How the policy was taken out, only if the document states it: online (por internet), phone (por teléfono), in_person (en oficina, presencial), other.",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["online", "phone", "in_person", "other"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "nonRenewalClauseText": {
          "type": "object",
          "description": "The clause on how either party can stop the policy from renewing (oposición a la prórroga, duración del contrato). Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "sumsInsured": {
          "type": "array",
          "description": "Every sum insured (suma asegurada, capital asegurado), one entry each.",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "kind": {
                "type": "string",
                "enum": ["building", "contents", "liability", "vehicle", "other"],
                "description": "building (continente), contents (contenido), liability (responsabilidad civil), vehicle (valor del vehículo), other."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "The sum, in euros."
              }
            },
            "required": ["kind", "amount", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "insurance_renewal_notice": {
      "type": "object",
      "description": "Notice of the policy’s renewal or of changes to it (aviso de renovación, comunicación de modificación de la prima o de las condiciones). Leave the section out when no attached document is one.",
      "properties": {
        "noticeOn": {
          "type": "object",
          "description": "Date of the notice.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "noticeMedium": {
          "type": "object",
          "description": "How it was sent: letter, email, sms, app or other.",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["letter", "email", "sms", "app", "other"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "expiresOn": {
          "type": "object",
          "description": "Date the current period ends, from which the renewal applies (vencimiento).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "previousPremium": {
          "type": "object",
          "description": "Total premium of the period that ends.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "newPremium": {
          "type": "object",
          "description": "Total premium of the new period.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "coverChanges": {
          "type": "object",
          "description": "true when it announces changes to covers, excesses or conditions besides the premium (coberturas, franquicias); false when it says there are none.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "changesText": {
          "type": "object",
          "description": "What it says changes, besides the premium. Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["pages"],
  "additionalProperties": false
}
