{
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "description": "One entry per attached page, in order: its kind, the number of its document and its readability.",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "The number given before the page."
          },
          "kind": {
            "type": "string",
            "enum": [
              "lease",
              "rent_update_notice",
              "rent_receipt",
              "agency_invoice",
              "deposit_return",
              "other"
            ],
            "description": "lease: a residential lease contract (contrato de arrendamiento) or its annex. rent_update_notice: a notice that the rent goes up or down (actualización de renta), as a letter, burofax, email, message or a note on a receipt. rent_receipt: a rent receipt (recibo) or a bank statement showing the rent paid. agency_invoice: an invoice or receipt for a fee charged when renting (honorarios, gestión, reserva, estudio de solvencia). deposit_return: a deposit return, end-of-lease settlement or key handover record (devolución de la fianza, entrega de llaves). other: anything else, such as an ID card or a payslip."
          },
          "document": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Number the documents in order of appearance; all pages of one document get the same number."
          },
          "readability": {
            "type": "object",
            "description": "ok: legible enough to transcribe, in whatever language. Otherwise the main reason the page cannot be used: handwritten (the values are written by hand), blurry, dark, cropped (the part with the values is cut off), not_rental_document (not about renting a home), foreign_jurisdiction (a tenancy document for a home outside Spain; never because of its language), unknown_format (about renting a home, but no kind of document you know).",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "ok",
                  "handwritten",
                  "blurry",
                  "dark",
                  "cropped",
                  "not_rental_document",
                  "foreign_jurisdiction",
                  "unknown_format"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "required": ["value", "confidence"],
            "additionalProperties": false
          },
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "description": "For a rent receipt page only: the month it is for, as YYYY-MM."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["page", "kind", "document", "readability", "confidence"],
        "additionalProperties": false
      }
    },
    "lease": {
      "type": "object",
      "description": "Residential lease contract (contrato de arrendamiento de vivienda), with its annexes. Leave the section out when no attached document is one.",
      "properties": {
        "signedOn": {
          "type": "object",
          "description": "Date the contract was signed (fecha del contrato, «en … a … de …»).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "startDate": {
          "type": "object",
          "description": "Date the lease starts (fecha de inicio, entrada en vigor), if stated.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "postcode": {
          "type": "object",
          "description": "Postcode (código postal) of the rented home: five digits.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5,
              "pattern": "^[0-9]{5}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "landlordType": {
          "type": "object",
          "description": "person: the landlord (arrendador) is a natural person. company: a company or other legal entity (S.L., S.A., sociedad, fondo, SOCIMI, cooperativa, fundación).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["person", "company"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "landlordCompanyName": {
          "type": "object",
          "description": "Only when the landlord is a company: its name as printed. Never the name of a person.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "agencyNamed": {
          "type": "object",
          "description": "true when an estate agency or intermediary (agencia, inmobiliaria, API) appears in the contract; false when none does.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "use": {
          "type": "object",
          "description": "What the contract says the home is for: main_home (vivienda habitual y permanente), seasonal (temporada: estudios, trabajo, vacaciones), room (alquiler de habitación), other_use (uso distinto de vivienda: local, oficina, garaje), protected (vivienda protegida, VPO), old_rent (renta antigua, before 1985).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["main_home", "seasonal", "room", "other_use", "protected", "old_rent"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "agreedMonths": {
          "type": "object",
          "description": "Agreed duration in months (duración pactada), only if stated: one year is 12.",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "initialRent": {
          "type": "object",
          "description": "Monthly rent agreed at the start (renta mensual), in euros.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "updateClauseText": {
          "type": "object",
          "description": "The clause about how the rent is updated each year (actualización de la renta). Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "updateClauseIndex": {
          "type": "object",
          "description": "The label that matches that clause: ipc (IPC, índice de precios de consumo, «IPC general»), irav (Índice de Referencia para la Actualización de Arrendamientos de Vivienda), igc (Índice de Garantía de Competitividad), fixed_percent (a fixed percentage a year), unspecified_index (an update with no index or percentage named), none (it says the rent is not updated), other (any other rule).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["ipc", "irav", "igc", "fixed_percent", "unspecified_index", "none", "other"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "updateFixedPercent": {
          "type": "object",
          "description": "For a fixed_percent clause only: the percentage a year, 3 for «un 3 %».",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "deposit": {
          "type": "object",
          "description": "Deposit (fianza legal), in euros.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "advanceMonths": {
          "type": "object",
          "description": "Monthly rents paid in advance at signing (mensualidades por adelantado), beyond the first month, only if stated.",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "necessityClause": {
          "type": "object",
          "description": "true when a clause lets the landlord end the lease early to live in the home (necesidad del arrendador, artículo 9.3 LAU); false when there is none.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "feesText": {
          "type": "object",
          "description": "What the contract says about agency, management or formalisation fees (honorarios, gastos de gestión) and who pays them. Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "chargesClauseText": {
          "type": "object",
          "description": "The clause that passes community fees, IBI, waste rates or other costs on to the tenant (gastos generales, tributos). Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "guarantees": {
          "type": "array",
          "description": "Every guarantee besides the deposit (garantía adicional): a cash sum, a bank guarantee (aval bancario) or a rent insurance.",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "kind": {
                "type": "string",
                "enum": ["cash", "bank_guarantee", "insurance", "other"],
                "description": "cash (depósito o garantía en metálico), bank_guarantee (aval bancario), insurance (seguro de impago), other."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Its amount, in euros, if stated."
              },
              "months": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24,
                "description": "Its size in whole monthly rents, if stated that way."
              }
            },
            "required": ["kind", "confidence"],
            "additionalProperties": false
          }
        },
        "charges": {
          "type": "array",
          "description": "Every cost passed on to the tenant besides the rent, as the contract states it.",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "kind": {
                "type": "string",
                "enum": ["community", "property_tax", "waste", "other"],
                "description": "community (gastos de comunidad), property_tax (IBI), waste (tasa de basuras), other."
              },
              "annualAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "What it comes to a year, in euros, only if stated as such."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              }
            },
            "required": ["kind", "confidence"],
            "additionalProperties": false
          }
        },
        "utilities": {
          "type": "array",
          "description": "Every utility the contract assigns (suministros).",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "kind": {
                "type": "string",
                "enum": ["electricity", "water", "gas", "internet", "other"],
                "description": "electricity, water, gas, internet or other."
              },
              "payer": {
                "type": "string",
                "enum": ["tenant", "landlord"],
                "description": "Who pays it according to the contract."
              }
            },
            "required": ["kind", "payer", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rent_update_notice": {
      "type": "object",
      "description": "Notice of a rent update (comunicación de actualización de renta), by letter, burofax, email, message or a note on a receipt. Leave the section out when no attached document is one.",
      "properties": {
        "notices": {
          "type": "array",
          "description": "Every update notice, one entry each.",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "noticeOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the notice."
              },
              "medium": {
                "type": "string",
                "enum": ["letter", "burofax", "email", "messaging", "receipt_note", "other"],
                "description": "How it was sent."
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "The percentage of the update, as printed."
              },
              "indexNamed": {
                "type": "string",
                "enum": ["ipc", "irav", "igc", "other"],
                "description": "The index it names: ipc, irav, igc or other."
              },
              "referenceMonth": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "description": "The month of the index it cites, as YYYY-MM."
              },
              "previousRent": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Monthly rent before the update."
              },
              "newRent": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Monthly rent after the update."
              },
              "appliesFrom": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date from which the new rent applies."
              }
            },
            "required": ["confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rent_receipt": {
      "type": "object",
      "description": "Rent receipt or bank statement line for the rent (recibo de alquiler). Leave the section out when no attached document is one.",
      "properties": {
        "receipts": {
          "type": "array",
          "description": "Every monthly receipt, one entry each, with each part only as printed.",
          "maxItems": 36,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "description": "The month the receipt is for, as YYYY-MM."
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Total of the receipt."
              },
              "rent": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Rent (renta)."
              },
              "community": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Community fees (comunidad)."
              },
              "propertyTax": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "IBI."
              },
              "waste": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Waste rate (basuras)."
              },
              "utilities": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Utilities (suministros: luz, agua, gas)."
              },
              "other": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Any other line, added up."
              }
            },
            "required": ["month", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "agency_invoice": {
      "type": "object",
      "description": "Invoice or receipt for a fee charged when renting (factura de honorarios, gestión, reserva o estudio de solvencia). Leave the section out when no attached document is one.",
      "properties": {
        "invoices": {
          "type": "array",
          "description": "Every invoice, one entry each.",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "issuedOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the invoice."
              },
              "issuer": {
                "type": "string",
                "enum": ["agency", "landlord", "other"],
                "description": "Who issues it: agency, landlord or other."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              },
              "conceptKind": {
                "type": "string",
                "enum": [
                  "agency_fee",
                  "formalisation",
                  "solvency_check",
                  "reservation",
                  "management",
                  "other"
                ],
                "description": "agency_fee (honorarios de agencia, comisión), formalisation (formalización del contrato), solvency_check (estudio de solvencia, scoring), reservation (reserva, señal), management (gestión, gastos de gestión), other."
              },
              "base": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Taxable base (base imponible)."
              },
              "vat": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "VAT amount (IVA), in euros."
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Total."
              }
            },
            "required": ["conceptKind", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "deposit_return": {
      "type": "object",
      "description": "Deposit return or end-of-lease settlement (devolución de la fianza, liquidación, acta de entrega de llaves). Leave the section out when no attached document is one.",
      "properties": {
        "keysReturnedOn": {
          "type": "object",
          "description": "Date the keys were handed back (entrega de llaves).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "deposit": {
          "type": "object",
          "description": "Deposit it says was held (fianza).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "closingDocumentSigned": {
          "type": "object",
          "description": "true when the document is signed by both parties as the end of the lease; false when it is not.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "returns": {
          "type": "array",
          "description": "Every payment returning money, one entry each.",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Date of the payment."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Amount returned."
              }
            },
            "required": ["amount", "confidence"],
            "additionalProperties": false
          }
        },
        "deductions": {
          "type": "array",
          "description": "Every amount kept back from the deposit, one entry each.",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Amount kept back."
              },
              "kind": {
                "type": "string",
                "enum": ["damage", "cleaning", "unpaid_rent", "unpaid_bills", "wear", "other"],
                "description": "damage (desperfectos), cleaning (limpieza), unpaid_rent (rentas impagadas), unpaid_bills (suministros pendientes), wear (desgaste, pintura), other."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              }
            },
            "required": ["amount", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["pages"],
  "additionalProperties": false
}
