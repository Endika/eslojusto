{
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "description": "One entry per attached page, in order: its kind, the number of its document and its readability.",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "The number given before the page."
          },
          "kind": {
            "type": "string",
            "enum": [
              "credit_agreement",
              "credit_precontract_info",
              "amortization_schedule",
              "early_repayment_statement",
              "revolving_agreement",
              "card_statement",
              "other"
            ],
            "description": "credit_agreement: a consumer credit contract (préstamo personal, financiación de un coche, compra a plazos) or its conditions. credit_precontract_info: the Información Normalizada Europea (INE, SECCI) given before it. amortization_schedule: a repayment schedule (cuadro de amortización). early_repayment_statement: a statement of an early repayment (liquidación de amortización o cancelación anticipada). revolving_agreement: the contract of a revolving card or credit line. card_statement: a monthly statement (extracto) of such a card. other: anything else, such as an ID card, a mortgage or a payslip."
          },
          "document": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Number the documents in order of appearance; all pages of one document get the same number."
          },
          "readability": {
            "type": "object",
            "description": "ok: legible enough to transcribe, in whatever language. Otherwise the main reason the page cannot be used: handwritten (the values are written by hand), blurry, dark, cropped (the part with the values is cut off), not_credit_document (not about a consumer credit), foreign_jurisdiction (a credit under the law of another country; never because of its language), unknown_format (about a consumer credit, but no kind of document you know).",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "ok",
                  "handwritten",
                  "blurry",
                  "dark",
                  "cropped",
                  "not_credit_document",
                  "foreign_jurisdiction",
                  "unknown_format"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "required": ["value", "confidence"],
            "additionalProperties": false
          },
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "description": "For a card statement page only: the month it is for, as YYYY-MM."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["page", "kind", "document", "readability", "confidence"],
        "additionalProperties": false
      }
    },
    "credit_agreement": {
      "type": "object",
      "description": "Consumer credit contract (préstamo personal, financiación de un coche o de una compra a plazos) and its conditions. Leave the section out when no attached document is one.",
      "properties": {
        "product": {
          "type": "object",
          "description": "personal_loan (préstamo personal), car_loan (financiación de un vehículo), revolving (tarjeta o línea de pago aplazado).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["personal_loan", "car_loan", "revolving"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "lenderName": {
          "type": "object",
          "description": "The lender (prestamista): its company name as printed.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "intermediaryType": {
          "type": "object",
          "description": "The credit intermediary (concesionario, tienda), if one appears: person or company.",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["person", "company"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "intermediaryCompanyName": {
          "type": "object",
          "description": "Only when the intermediary is a company: its name as printed. Never the name of a person.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "agreedOn": {
          "type": "object",
          "description": "Date of the contract (fecha del contrato, «en … a … de …»).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "principal": {
          "type": "object",
          "description": "Amount of credit (importe total del crédito, capital prestado), in euros.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "netDisbursed": {
          "type": "object",
          "description": "Amount actually handed over or paid into the account (importe entregado, neto), only if printed apart from the capital.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "cashPrice": {
          "type": "object",
          "description": "Cash price of the goods financed (precio al contado), if stated.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "goods": {
          "type": "object",
          "description": "The goods or service financed (bien financiado), as printed.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "nominalRate": {
          "type": "object",
          "description": "Nominal annual interest rate (TIN, tipo deudor), 7,99 % is 7.99.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "rateType": {
          "type": "object",
          "description": "fixed (tipo fijo) or variable (tipo variable, referenciado).",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["fixed", "variable"]
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "declaredApr": {
          "type": "object",
          "description": "The APR the document states (TAE), 8,29 % is 8.29.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "declaredTotalPayable": {
          "type": "object",
          "description": "Total amount payable the contract states (importe total adeudado).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "instalmentCount": {
          "type": "object",
          "description": "Number of instalments (número de cuotas).",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "instalmentAmount": {
          "type": "object",
          "description": "Amount of each regular instalment (importe de la cuota).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "firstDueOn": {
          "type": "object",
          "description": "Due date of the first instalment (primera cuota, primer vencimiento).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "balloonAmount": {
          "type": "object",
          "description": "A last payment larger than the instalments (cuota final, valor futuro garantizado).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "balloonDueOn": {
          "type": "object",
          "description": "Its due date, only if printed.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "agreedEndOn": {
          "type": "object",
          "description": "Date the credit ends (fecha de vencimiento final), if stated.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "insurancePremium": {
          "type": "object",
          "description": "Premium of an insurance linked to the credit (prima del seguro), in euros.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "insuranceSingle": {
          "type": "object",
          "description": "true for a single premium for the whole term (prima única); false for a periodic one.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "insuranceFinanced": {
          "type": "object",
          "description": "true when that premium is added to the capital (financiada).",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "insuranceRequired": {
          "type": "object",
          "description": "true when the contract says the insurance is required to grant the credit; false when it says it is optional.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "earlyRepaymentClauseText": {
          "type": "object",
          "description": "The clause on early repayment (reembolso o amortización anticipada) and its compensation. Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "withdrawalClauseText": {
          "type": "object",
          "description": "The clause on the right of withdrawal (derecho de desistimiento). Copy it word for word, at most the first characters that fit; never summarise or judge it.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "charges": {
          "type": "array",
          "description": "Every charge (comisión, gasto) the document states, one entry each.",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "kind": {
                "type": "string",
                "enum": ["opening", "study", "management", "other"],
                "description": "opening (comisión de apertura), study (comisión de estudio), management (gastos de gestión, tramitación), other."
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "The concept exactly as printed."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Its amount, in euros."
              },
              "how": {
                "type": "string",
                "enum": ["deducted", "financed", "paid"],
                "description": "deducted (descontada del importe entregado), financed (sumada al capital) or paid (pagada aparte), if stated."
              }
            },
            "required": ["kind", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
