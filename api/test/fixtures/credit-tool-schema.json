    "amortization_schedule": {
      "type": "object",
      "description": "Repayment schedule (cuadro de amortización), one row per instalment. Leave the section out when no attached document is one.",
      "properties": {
        "schedule": {
          "type": "array",
          "description": "Every row in the order printed; past 96, the first 96.",
          "maxItems": 96,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "dueOn": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Due date."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Instalment (cuota)."
              },
              "interest": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Interest part (intereses)."
              },
              "principal": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Capital part (amortización, capital)."
              },
              "balance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Capital outstanding after it (capital pendiente)."
              },
              "fees": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Charges or premium in the row, if any."
              }
            },
            "required": ["dueOn", "amount", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
