{
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "description": "One entry per attached page, in order: its kind, the number of its document and its readability.",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "The number given before the page."
          },
          "kind": {
            "type": "string",
            "enum": ["price_change_notice", "other"],
            "description": "price_change_notice: a letter that the contract’s prices change or renew, with the new and the current prices. other: anything else, such as a bill or a contract."
          },
          "document": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Number the documents in order of appearance; all pages of one document get the same number."
          },
          "readability": {
            "type": "object",
            "description": "ok: legible enough to transcribe, in whatever language. Otherwise the main reason the page cannot be used: handwritten (the values are written by hand), blurry, dark, cropped (the part with the values is cut off), not_electricity_document (not about a household electricity supply), foreign_jurisdiction (a supply outside Spain; never because of its language), unknown_format (about an electricity supply, but no kind of document you know).",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "ok",
                  "handwritten",
                  "blurry",
                  "dark",
                  "cropped",
                  "not_electricity_document",
                  "foreign_jurisdiction",
                  "unknown_format"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "required": ["value", "confidence"],
            "additionalProperties": false
          },
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "description": "Leave it out."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["page", "kind", "document", "readability", "confidence"],
        "additionalProperties": false
      }
    },
    "price_change_notice": {
      "type": "object",
      "description": "A letter announcing that the contract’s prices change, with the new and the current prices (carta de renovación o de modificación de precios). Leave the section out when no attached document is one.",
      "properties": {
        "sentOn": {
          "type": "object",
          "description": "Date of the letter.",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "appliesFrom": {
          "type": "object",
          "description": "Date the new prices apply from, or the renewal date (fecha de renovación).",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "separateFromBill": {
          "type": "object",
          "description": "true when it is a letter of its own; false when it is printed on a bill.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "isRenewal": {
          "type": "object",
          "description": "true when the letter says the contract is renewed (renovación).",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "fixedPrice": {
          "type": "object",
          "description": "true only when the letter says the price is fixed (precio fijo); leave it out when it does not say.",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "contractedPowerP1": {
          "type": "object",
          "description": "Contracted power in P1, in kW.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "contractedPowerP2": {
          "type": "object",
          "description": "Contracted power in P2, in kW.",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "annualConsumptionKwh": {
          "type": "object",
          "description": "Annual consumption the estimate is based on, in kWh (consumo anual).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "estimatedCostCurrentWithoutTax": {
          "type": "object",
          "description": "Estimated annual cost at the current prices, without taxes (sin impuestos).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "estimatedCostCurrentWithTax": {
          "type": "object",
          "description": "Estimated annual cost at the current prices, with taxes (con impuestos).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "estimatedCostNewWithoutTax": {
          "type": "object",
          "description": "Estimated annual cost at the new prices, without taxes (sin impuestos).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "estimatedCostNewWithTax": {
          "type": "object",
          "description": "Estimated annual cost at the new prices, with taxes (con impuestos).",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "required": ["value", "confidence"],
          "additionalProperties": false
        },
        "priceChanges": {
          "type": "array",
          "description": "Every price it changes, one per term and period; all for an energy price not split by period.",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "term": {
                "type": "string",
                "enum": ["power", "energy"],
                "description": "power or energy."
              },
              "period": {
                "type": "string",
                "enum": ["p1", "p2", "p3", "all"],
                "description": "p1, p2 or p3; all for one price for all the energy."
              },
              "before": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "The current price, until the change."
              },
              "after": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000,
                "description": "The new price, from the change."
              },
              "unit": {
                "type": "string",
                "enum": ["per_kw_day", "per_kw_year", "per_kwh"],
                "description": "per_kw_day, per_kw_year or per_kwh, as printed."
              }
            },
            "required": ["term", "period", "confidence"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["pages"],
  "additionalProperties": false
}
