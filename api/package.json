{
  "name": "eslojusto-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "type:check": "tsc --noEmit",
    "test:run": "vitest run",
    "synth": "cdk synth --quiet -c stripePriceId=price_ci_placeholder -c alertEmail=ci@example.com",
    "eval": "tsx eval/run.ts"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-ssm": "^3.1160.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
