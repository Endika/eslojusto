{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "./stryker/noise-ignorer.mjs"],
  "ignorers": ["noise"],
  "reporters": ["clear-text"],
  "clearTextReporter": {
    "logTests": false
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "disableTypeChecks": false
}
