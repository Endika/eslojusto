---
import Base from '../layouts/Base.astro';
import { NORMS } from '../engine/rental/data/norms';
import { LAST_UPDATED } from './../content/updated';
import { breadcrumbList } from '../content/structured-data';
import { faqNode } from '../content/faq';
import { REVIEW, RENTAL_PAGES, type RentalPageId } from '../content/rental-pages';
import { formatLongDay } from '../content/rent-indices';
import { link } from '../i18n/languages';

// A page on one question about a rental: the explanation (the slot), its questions and the pages
// next to it. Spanish only, like its prose; it exists only in a PUBLIC_RENTAL=1 build.
interface Props {
  id: RentalPageId;
}
const { id } = Astro.props;
const page = RENTAL_PAGES[id];
const href = (path: string) => link('es', path.replace(/^\//, ''));
const checkedOn = LAST_UPDATED[page.path];
if (!checkedOn) throw new Error(`${page.path} needs its date in LAST_UPDATED.`);

const home = new URL(import.meta.env.BASE_URL, Astro.site);
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: REVIEW.name, path: REVIEW.path },
  { name: page.name, path: page.path },
];
const next = [
  { name: REVIEW.name, path: REVIEW.path },
  ...page.related.map((r) => ({ name: RENTAL_PAGES[r].name, path: RENTAL_PAGES[r].path })),
];
---

<Base
  title={page.title}
  description={page.description}
  path={page.path}
  lang="es"
  langs={['es']}
  section="settlement"
  structuredData={[breadcrumbList(home, crumbs), faqNode(page.faq)]}
>
  <main class="document rent" id="content">
    <nav class="crumbs" aria-label="Estás en">
      <ol>
        {crumbs.map(({ name, path }, i) =>
          i < crumbs.length - 1 ? (
            <li>
              <a href={href(path)}>{name}</a>
            </li>
          ) : (
            <li>
              <span aria-current="page">{name}</span>
            </li>
          ),
        )}
      </ol>
    </nav>
    <header class="document__head">
      <h1 class="document__title">{page.h1}</h1>
      <p class="guide__lead">{page.lead}</p>
      <p class="guide__sources">
        <span>
          Revisado el <time datetime={checkedOn}>{formatLongDay(checkedOn)}</time>
        </span>
        <span>
          Fuentes: <a href={NORMS.lau.url}>Ley de Arrendamientos Urbanos</a> ·{' '}
          <a href={NORMS.rdl29_2026.url}>Real Decreto-ley 29/2026</a>
        </span>
        <a href={link('es', 'aviso-legal/')}>Quién lo hace</a>
      </p>
    </header>

    <div class="document__sheets">
      <slot />

      <section class="sheet sheet--text" aria-labelledby="preguntas">
        <h2 id="preguntas">Preguntas frecuentes</h2>
        <div class="faq-list">
          {page.faq.map(({ question, answer }) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav class="sheet sheet--text" aria-labelledby="sigue">
        <h2 id="sigue">Sigue leyendo</h2>
        <ul class="next-pages">
          {next.map(({ name, path }) => (
            <li>
              <a href={href(path)}>{name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Base>

<style>
  .next-pages {
    padding-inline-start: 0;
    list-style: none;
  }
  .next-pages li {
    padding-block: 0.375rem;
  }
  .next-pages a {
    font: 620 1.0625rem / 1.3 var(--f-grotesque);
  }
</style>
