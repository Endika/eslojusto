---
import Base from '../layouts/Base.astro';
import { NORMS } from '../engine/rental/data/norms';
import { example, formatLongDay, latest, monthRows } from '../content/rent-indices';
import { TOPIC_PATH, topicPage, type TopicId } from '../content/rental-topics';
import { faqNode } from '../content/faq';
import { breadcrumbList } from '../content/structured-data';
import { LAST_UPDATED } from '../content/updated';
import { link } from '../i18n/languages';

// One of the rental guides: Spanish only, like the case pages. It exists only in a PUBLIC_RENTAL=1
// build, so its date is in LAST_UPDATED only then.
interface Props {
  id: TopicId;
}
const { id } = Astro.props;
const path = TOPIC_PATH[id];
const checkedOn = LAST_UPDATED[path];
if (!checkedOn) throw new Error(`${path} needs its date in LAST_UPDATED.`);
const irav = latest('irav', monthRows());
if (!irav) throw new Error('The rental guides need a published IRAV.');
const page = topicPage(id, { norms: NORMS, checkedOn, irav: irav.figure.rate, example: example() });
const href = (to: string) => link('es', to.replace(/^\//, ''));

const home = new URL(import.meta.env.BASE_URL, Astro.site);
const structuredData = [
  breadcrumbList(home, [
    { name: 'Inicio', path: '/' },
    { name: 'Revisa tu alquiler', path: '/alquiler/' },
    { name: page.crumb, path },
  ]),
  faqNode(page.faq.map(({ question, answer }) => ({ question, answer }))),
];
---

<Base
  title={page.title}
  description={page.description}
  path={path}
  lang="es"
  langs={['es']}
  section="settlement"
  structuredData={structuredData}
>
  <main class="document rent" id="content">
    <nav class="crumbs" aria-label="Estás en">
      <ol>
        <li>
          <a href={href('/')}>Inicio</a>
        </li>
        <li>
          <a href={href('/alquiler/')}>Revisa tu alquiler</a>
        </li>
        <li>
          <span aria-current="page">{page.crumb}</span>
        </li>
      </ol>
    </nav>
    <header class="document__head">
      <h1 class="document__title">{page.h1}</h1>
      <p class="guide__lead">{page.lead}</p>
      <p class="guide__sources">
        <time datetime={checkedOn}>Revisado el {formatLongDay(checkedOn)}</time>
        <a href={href('/aviso-legal/')}>Quién está detrás</a>
      </p>
    </header>

    <div class="document__sheets">
      {page.sections.map((section) => (
        <section class="sheet sheet--text" aria-labelledby={section.id} data-topic={section.id}>
          <h2 id={section.id}>{section.heading}</h2>
          {section.paragraphs.map((text) => (
            <p>{text}</p>
          ))}
          {section.table && (
            <div
              class="table-scroll"
              role="region"
              aria-labelledby={`${section.id}-tabla`}
              tabindex="0"
            >
              <table class="rates rates--text">
                <caption id={`${section.id}-tabla`} class="visually-hidden">
                  {section.table.caption}
                </caption>
                <thead>
                  <tr>
                    {section.table.head.map((name) => (
                      <th scope="col">{name}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr data-cap={row.id}>
                      <th scope="row">{row.cells[0]}</th>
                      <td>{row.cells[1]}</td>
                      <td>
                        <ul class="sources">
                          {row.sources.map((s) => (
                            <li>
                              <a href={s.url}>{s.citation}</a>
                            </li>
                          ))}
                        </ul>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {section.status && (
            <p class="status" role="note">
              {section.status}
            </p>
          )}
          {section.list && (
            <ul>
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.example?.map((text, i) => (
            <p class="example">
              {i === 0 && <span class="example__label">Ejemplo.</span>} {text}
            </p>
          ))}
          {section.after?.map((text) => (
            <p>{text}</p>
          ))}
          {section.links && (
            <ul class="next-pages">
              {section.links.map(({ label, path: to }) => (
                <li>
                  <a href={href(to)}>{label}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <section class="sheet sheet--text" aria-labelledby="normas">
        <h2 id="normas">Normas</h2>
        <ul class="sources sources--wrap">
          {page.sources.map((s) => (
            <li>
              <a href={s.url}>{s.citation}</a>{' '}
              <span class="rules__status" data-status={s.statusCode}>
                {s.status}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="sheet sheet--text" aria-labelledby="preguntas">
        <h2 id="preguntas">Preguntas frecuentes</h2>
        <div class="faq-list">
          {page.faq.map(({ anchor, question, answer }) => (
            <details class="faq-item" id={anchor}>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav class="sheet sheet--text" aria-labelledby="sigue">
        <h2 id="sigue">Sigue leyendo</h2>
        <ul class="next-pages">
          {page.related.map(({ label, path: to }) => (
            <li>
              <a href={href(to)}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Base>

<style>
  /* The caps table holds words, not figures: they read from the start. */
  .rates--text :is(th, td) {
    text-align: start;
  }
</style>
