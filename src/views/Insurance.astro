---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InsuranceForm from '../components/InsuranceForm.astro';
import InsuranceResult from '../components/InsuranceResult.astro';
import { INSURANCE_BETA } from '../content/sections';
import { formatLongDay } from '../content/rent-indices';
import { breadcrumbList, trail } from '../content/structured-data';
import { DOCUMENTS } from '../documents/config';
import { LAST_UPDATED } from '../content/updated';
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);
// A build with the documents API offers the letters and, when there is one to sell, the pass.
const documents = DOCUMENTS !== null;

// Each tab's share of the rail follows how many sheets its section holds (the result counts two).
// The second column is the section's first step, whose id is its URL fragment.
const sections = [
  ['cause', 'poliza', '01', 3],
  ['dates', 'contratacion', '02', 2],
  ['salary', 'renovacion', '03', 3],
  ['result', 'resultado', '04', 2],
] as const;

// The day the page's rules and norms were last checked; it exists only in a build with the page.
const checkedOn = LAST_UPDATED['/seguros/'];
if (!checkedOn) throw new Error('/seguros/ needs its date in LAST_UPDATED.');
const home = new URL(import.meta.env.BASE_URL, Astro.site);
const crumbs = trail(lang, { name: tx('home.insurance'), path: '/seguros/' });
---

<Base
  title={tx('insurance.title')}
  description={tx('insurance.description')}
  path="/seguros/"
  lang={lang}
  section="cause"
  structuredData={[breadcrumbList(home, lang, crumbs)]}
  calculator={documents}
>
  <nav class="tabs" slot="tabs" aria-label={tx('tabs.nav')}>
    <ol>
      {/* Only a section already reached is a link; one still ahead is plain text until then. */}
      {sections.map(([id, step, number, weight], i) => (
        <li style={`--weight: ${weight}`} data-tone={id}>
          {i === 0 ? (
            <a class="tab" data-tab={id} data-state="current" href={`#${step}`} aria-current="step">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`insurance.tab.${step}`)}</span>
            </a>
          ) : (
            <span class="tab" data-tab={id} data-state="pending" aria-disabled="true">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`insurance.tab.${step}`)}</span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <main id="content">
    <div class="desk">
      <header class="desk__head">
        <Breadcrumbs lang={lang} crumbs={crumbs} />
        <h1 class="desk__title">{tx('insurance.h1')}</h1>
        <p class="desk__lead">{tx('insurance.lead')}</p>
        {INSURANCE_BETA && (
          <p class="desk__beta">
            <span class="beta">{tx('insurance.beta')}</span>
            {tx('insurance.beta_note')}
          </p>
        )}
        <p class="desk__reviewed">
          <time datetime={checkedOn}>
            {t(lang, 'insurance.reviewed', { fecha: formatLongDay(checkedOn) })}
          </time>
        </p>
      </header>
      <noscript>
        <div class="sheet sheet--notice">
          <p class="help">{tx('insurance.no_js')}</p>
        </div>
      </noscript>
      <InsuranceForm lang={lang} />
      <InsuranceResult lang={lang} documents={documents} />
    </div>
  </main>
</Base>

<script>
  import '../scripts/insurance';
</script>
