---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';
import type { Variables } from '../i18n/interpolate';
import {
  COLUMNS,
  FIRST_MONTH,
  NORMS_CHECKED_ON,
  PATH,
  SERIES,
  checkedOn,
  example,
  formatDay,
  formatEuros,
  formatLongDay,
  formatMonth,
  formatRate,
  inePage,
  lastChanged,
  latest,
  monthRows,
} from '../content/rent-indices';
import { capsCopy } from '../content/rent-caps';
import { NORMS } from '../engine/rental/data/norms';
import { RENTAL_BUILD } from '../content/sections';
import { breadcrumbList, trail } from '../content/structured-data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key, vars?: Variables) => t(lang, key, vars);

const rows = monthRows();
const irav = latest('irav', rows);
const ipc = latest('ipc', rows);
const flash = latest('ipcFlash', rows);
const igc = latest('igc', rows);
if (!irav || !ipc) throw new Error('The rent indices page needs a published IRAV and CPI.');
const ex = example();
const nextIravMonth = rows.findLast((r) => r.irav === null && r.month > irav.month)?.month;

const caps = capsCopy(lang, NORMS, {
  checkedOn: NORMS_CHECKED_ON,
  iravRate: irav.figure.rate,
  example: ex,
});
const percent = (n: number) => `${n}\u00a0%`;

const latestItems = [
  ['latest_irav', irav, 'irav'],
  ['latest_ipc', ipc, 'ipc'],
  ['latest_flash', flash && flash.month > ipc.month ? flash : null, 'ipcFlash'],
  ['latest_igc', igc, 'igc'],
] as const;

const faq = (
  [
    ['what_is_irav', {}],
    [
      'which_month',
      {
        dia: formatLongDay(ex.anniversary),
        mes: formatMonth(ex.month),
        publicado: formatLongDay(ex.figure.publishedOn),
      },
    ],
    ['irav_or_ipc', { decreto: caps.faqIravOrIpc }],
    ['flash', {}],
    ['no_clause', { decretos: caps.faqNoClause }],
    ['igc_negative', {}],
  ] as const
).map(([id, vars]) => ({
  anchor: `faq-${id.replaceAll('_', '-')}`,
  question: tx(`rent_indices.faq.${id}`),
  answer: tx(`rent_indices.faq.${id}_answer`, vars),
}));

const home = new URL(import.meta.env.BASE_URL, Astro.site);
const page = new URL(link(lang, PATH.slice(1)), Astro.site);
// Under the rental review when the build has it; straight under the home when it does not.
const crumbs = trail(
  lang,
  ...(RENTAL_BUILD ? [{ name: tx('home.rent'), path: '/alquiler/' }] : []),
  { name: tx('rent_indices.h1'), path: PATH },
);
const variable = (name: string, description: string) => ({
  '@type': 'PropertyValue',
  name,
  description,
  unitText: '%',
});
const structuredData = [
  {
    '@type': 'Dataset',
    '@id': `${page.href}#datos`,
    name: tx('rent_indices.dataset_name'),
    description: tx('rent_indices.dataset_description'),
    url: page.href,
    inLanguage: lang,
    isAccessibleForFree: true,
    temporalCoverage: `${FIRST_MONTH}/${rows[0]?.month ?? FIRST_MONTH}`,
    dateModified: lastChanged(rows),
    creator: {
      '@type': 'Organization',
      name: 'Instituto Nacional de Estadística (INE)',
      url: 'https://www.ine.es/',
    },
    publisher: { '@type': 'Organization', name: 'eslojusto.es', url: home.href },
    isBasedOn: [SERIES.irav, SERIES.ipc, SERIES.igc].map(inePage),
    variableMeasured: [
      variable('IRAV', SERIES.irav.citation),
      variable('IPC', SERIES.ipc.citation),
      variable('IGC', SERIES.igc.citation),
    ],
  },
  breadcrumbList(home, lang, crumbs),
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<Base
  title={tx('rent_indices.title', { mes: formatMonth(irav.month).replace(' de ', ' ') })}
  description={tx('rent_indices.description', {
    mes: formatMonth(irav.month),
    irav: formatRate(irav.figure.rate, 'irav'),
    ipc: formatRate(ipc.figure.rate, 'ipc'),
  })}
  path={PATH}
  lang={lang}
  section="settlement"
  structuredData={structuredData}
>
  <main class="document rent" id="content">
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <header class="document__head">
      <h1 class="document__title">{tx('rent_indices.h1')}</h1>
      <p class="guide__lead">{tx('rent_indices.lead')}</p>
      <p class="guide__sources">
        <span>{tx('rent_indices.checked', { fecha: formatDay(checkedOn()) })}</span>
        <span>
          {tx('rent_indices.sources')}:{' '}
          <a href={inePage(SERIES.irav)}>{tx('rent_indices.source_irav')}</a> ·{' '}
          <a href={inePage(SERIES.ipc)}>{tx('rent_indices.source_ipc')}</a> ·{' '}
          <a href={inePage(SERIES.igc)}>{tx('rent_indices.source_igc')}</a>
        </span>
        <a href={link('es', 'aviso-legal/')}>{tx('rent_indices.who')}</a>
      </p>
    </header>

    <div class="document__sheets">
      <section class="sheet sheet--text" aria-labelledby="ultimo">
        <h2 id="ultimo">{tx('rent_indices.latest', { mes: formatMonth(irav.month) })}</h2>
        <dl class="data-list latest">
          {latestItems.map(
            ([key, item, column]) =>
              item && (
                <div>
                  <dt>{tx(`rent_indices.${key}`, { mes: formatMonth(item.month) })}</dt>
                  <dd>
                    <span class="latest__rate">{formatRate(item.figure.rate, column)}</span>
                    <a class="latest__date" href={item.figure.url}>
                      {tx('rent_indices.published_on', {
                        fecha: formatDay(item.figure.publishedOn),
                      })}
                    </a>
                  </dd>
                </div>
              ),
          )}
        </dl>
        {nextIravMonth && <p>{tx('rent_indices.next', { mes: formatMonth(nextIravMonth) })}</p>}
      </section>

      <section class="sheet sheet--text" aria-labelledby="cada-mes">
        <h2 id="cada-mes">{tx('rent_indices.table_title')}</h2>
        <p>{tx('rent_indices.table_lead')}</p>
        <div class="table-scroll" role="region" aria-labelledby="tabla-indices" tabindex="0">
          <table class="rates">
            <caption id="tabla-indices" class="visually-hidden">
              {tx('rent_indices.caption')}
            </caption>
            <thead>
              <tr>
                <th scope="col">{tx('rent_indices.col_month')}</th>
                {COLUMNS.map((c) => (
                  <th scope="col" aria-describedby={c === 'igc' ? 'nota-igc' : undefined}>
                    {tx(`rent_indices.col_${c}`)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr data-month={row.month}>
                  <th scope="row">
                    <time datetime={row.month}>{formatMonth(row.month)}</time>
                  </th>
                  {COLUMNS.map((c) => {
                    const f = row[c];
                    return f ? (
                      <td>
                        <span class="rates__rate">{formatRate(f.rate, c)}</span>
                        <a class="rates__date" href={f.url}>
                          <span class="visually-hidden">{tx('rent_indices.cell_published')} </span>
                          <time datetime={f.publishedOn}>{formatDay(f.publishedOn)}</time>
                        </a>
                      </td>
                    ) : (
                      <td class="rates__pending">{tx('rent_indices.cell_pending')}</td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{tx('rent_indices.note_flash')}</p>
        <p id="nota-igc">
          {tx('rent_indices.note_igc', {
            min: percent(0),
            max: percent(2),
          })}{' '}
          <a href={caps.igcClamp.url}>{caps.igcClamp.citation}</a>
        </p>
      </section>

      <section class="sheet sheet--text" aria-labelledby="topes">
        <h2 id="topes">{tx('rent_indices.caps_title')}</h2>
        <p>{tx('rent_indices.caps_lead')}</p>
        <dl class="data-list caps">
          {caps.rows.map(({ id, when, rule, sources }) => (
            <div data-cap={id}>
              <dt>{when}</dt>
              <dd>
                <p>{rule}</p>
                <ul class="sources">
                  {sources.map((s) => (
                    <li>
                      <a href={s.url}>{s.citation}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
        <p class="status" role="note">
          {caps.status}
        </p>
        {caps.now && <p>{caps.now}</p>}
        {caps.repealed && <p>{caps.repealed}</p>}
        <p>{tx('rent_indices.notice')}</p>
        <p class="folio">
          Art. <span>18</span> LAU
        </p>
      </section>

      <section class="sheet sheet--text" aria-labelledby="ejemplo">
        <h2 id="ejemplo">{tx('rent_indices.example_title')}</h2>
        <p class="example">
          <span class="example__label">{tx('rent_indices.example_label')}</span>{' '}
          {tx('rent_indices.example', {
            renta: formatEuros(ex.rent),
            dia: formatLongDay(ex.anniversary),
            mes: formatMonth(ex.month),
            irav: formatRate(ex.figure.rate, 'irav'),
            publicado: formatDay(ex.figure.publishedOn),
            maximo: formatEuros(ex.maxRent),
          })}
        </p>
        {caps.exampleLater && <p class="example">{caps.exampleLater}</p>}
      </section>

      {RENTAL_BUILD ? (
        <section class="sheet sheet--text" aria-labelledby="revisa">
          <h2 id="revisa">{tx('rent_indices.check_title')}</h2>
          <p>
            {tx('rent_indices.check')}{' '}
            <a href={link(lang, 'alquiler/')}>{tx('rent_indices.check_link')}</a>
          </p>
        </section>
      ) : (
        <section class="sheet sheet--text" aria-labelledby="proximamente">
          <h2 id="proximamente">{tx('rent_indices.soon_title')}</h2>
          <p>{tx('rent_indices.soon')}</p>
        </section>
      )}

      <section class="sheet sheet--text" aria-labelledby="preguntas">
        <h2 id="preguntas">{tx('rent_indices.faq')}</h2>
        <div class="faq-list">
          {faq.map(({ anchor, question, answer }) => (
            <details class="faq-item" id={anchor}>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
</Base>
