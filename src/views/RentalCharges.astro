---
import RentalTopic from './RentalTopic.astro';
import { NORMS } from '../engine/rental/data/norms';
import { REVIEW, decreeStatus, chargesExample } from '../content/rental-pages';
import { formatEuros, formatLongDay } from '../content/rent-indices';
import { link } from '../i18n/languages';

const ex = chargesExample();
const rdl29 = NORMS.rdl29_2026;
const href = (path: string) => link('es', path.replace(/^\//, ''));
---

<RentalTopic id="charges">
  <section class="sheet sheet--text" aria-labelledby="pacto">
    <h2 id="pacto">Solo con pacto por escrito y su importe anual</h2>
    <p>
      El casero solo puede cobrarte los gastos generales del edificio, los tributos o los servicios
      sin contador si lo pactasteis por escrito y con su importe anual a la fecha del contrato (art.
      20.1 LAU, en su redacción anterior al Real Decreto-ley 29/2026).
    </p>
    <p>
      Si el contrato no los menciona o no da un importe al año, la revisión lo señala para que lo
      mires.
    </p>
    <p class="folio">
      Art. <span>20.1</span> LAU
    </p>
  </section>

  <section class="sheet sheet--text" aria-labelledby="subida">
    <h2 id="subida">Cuánto pueden subir: el doble que la renta</h2>
    <p>
      Los gastos no pueden subir más del doble de lo que puede subir la renta (art. 20 LAU). La
      revisión compara cada gasto de cada año con ese tope.
    </p>
    <p class="folio">
      Art. <span>20</span> LAU
    </p>
  </section>

  <section class="sheet sheet--text" aria-labelledby="ibi">
    <h2 id="ibi">El IBI y las tasas</h2>
    <p>
      El Real Decreto-ley 29/2026, en vigor desde el {formatLongDay(rdl29.inForceSince)} y{' '}
      {decreeStatus(rdl29)}, dice que los tributos de la vivienda, como el IBI, no pueden cargarse
      al inquilino, salvo que sea el inquilino quien tiene que pagarlos (art. 20 LAU, en la
      redacción del Real Decreto-ley 29/2026). La revisión lo aplica a los contratos firmados desde
      esa fecha; en los anteriores, lo da como información.
    </p>
    <p class="status" role="note">
      Estado de la norma: {decreeStatus(rdl29)}. Si el Congreso la deroga, esta página cambiará.
    </p>
    <p class="folio">
      Art. <span>20</span> LAU · RDL 29/2026
    </p>
  </section>

  <section class="sheet sheet--text" aria-labelledby="ejemplo">
    <h2 id="ejemplo">Ejemplo resuelto</h2>
    <p>
      Un contrato fija {formatEuros(ex.agreed)} al año de comunidad. El primer año, el casero cobra{' '}
      {formatEuros(ex.charged)}.
    </p>
    <p class="example">
      <span class="example__label">Las cuentas</span> Aún no ha podido haber ninguna subida, así que
      el máximo es lo pactado, {formatEuros(ex.agreed)}. {formatEuros(ex.charged)} −{' '}
      {formatEuros(ex.agreed)} = {formatEuros(ex.over)} de más.
    </p>
    <p class="folio">
      Art. <span>20</span> LAU
    </p>
  </section>

  <section class="sheet sheet--text" aria-labelledby="revision">
    <h2 id="revision">Comprueba lo que te cobran</h2>
    <p>
      La <a href={href(REVIEW.path)}>revisión del alquiler</a> compara cada gasto de cada año con lo
      pactado y con el tope de subida, y te dice cuánto has pagado de más.
    </p>
  </section>
</RentalTopic>
