---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocumentStart from '../components/DocumentStart.astro';
import MortgageForm from '../components/MortgageForm.astro';
import MortgageResult from '../components/MortgageResult.astro';
import { MORTGAGE_BETA } from '../content/sections';
import { formatLongDay } from '../content/rent-indices';
import { breadcrumbList, trail } from '../content/structured-data';
import { LAST_UPDATED } from '../content/updated';
import { DOCUMENTS } from '../documents/config';
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);
// With the documents API the visit opens on the choice between uploading and typing; the tabs and
// the form wait until it is made, and the result offers the letters and, when there is one to sell,
// the pass. A deed runs past what one read takes, so the upload says which of its pages to send
// and how to tell them.
const documents = DOCUMENTS !== null;
const pageGuide = {
  lead: tx('mortgage.documents.guide.lead'),
  pages: [
    {
      name: tx('mortgage.documents.guide.first'),
      signs: tx('mortgage.documents.guide.first_signs'),
      figure: 'cover',
    },
    {
      name: tx('mortgage.documents.guide.clauses'),
      signs: tx('mortgage.documents.guide.clauses_signs'),
      figure: 'clauses',
    },
    {
      name: tx('mortgage.documents.guide.invoices'),
      signs: tx('mortgage.documents.guide.invoices_signs'),
      figure: 'invoice',
    },
  ],
  caption: tx('mortgage.documents.guide.caption'),
} as const;

// Each tab's share of the rail follows how much its section asks, kept close so that every name
// still fits on a phone.
// The second column is the section's first step, whose id is its URL fragment.
const sections = [
  ['cause', 'hipoteca', '01', 3],
  ['salary', 'clausula-gastos', '02', 3],
  ['settlement', 'facturas', '03', 3],
  ['dates', 'amortizacion', '04', 3],
  ['result', 'resultado', '05', 2],
] as const;

// The day the page's rules and norms were last checked; it exists only in a build with the page.
const checkedOn = LAST_UPDATED['/hipoteca/'];
if (!checkedOn) throw new Error('/hipoteca/ needs its date in LAST_UPDATED.');
const home = new URL(import.meta.env.BASE_URL, Astro.site);
const crumbs = trail(lang, { name: tx('home.mortgage'), path: '/hipoteca/' });
---

<Base
  title={tx('mortgage.title')}
  description={tx('mortgage.description')}
  path="/hipoteca/"
  lang={lang}
  section="cause"
  structuredData={[breadcrumbList(home, lang, crumbs)]}
  calculator={documents}
>
  <nav class="tabs" slot="tabs" aria-label={tx('tabs.nav')} hidden={documents}>
    <ol>
      {/* Only a section already reached is a link; one still ahead is plain text until then. */}
      {sections.map(([id, step, number, weight], i) => (
        <li style={`--weight: ${weight}`} data-tone={id}>
          {i === 0 ? (
            <a class="tab" data-tab={id} data-state="current" href={`#${step}`} aria-current="step">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`mortgage.tab.${step}`)}</span>
            </a>
          ) : (
            <span class="tab" data-tab={id} data-state="pending" aria-disabled="true">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`mortgage.tab.${step}`)}</span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <main id="content">
    <div class="desk">
      <header class="desk__head">
        <Breadcrumbs lang={lang} crumbs={crumbs} />
        <h1 class="desk__title">{tx('mortgage.h1')}</h1>
        <p class="desk__lead">{tx('mortgage.lead')}</p>
        {MORTGAGE_BETA && (
          <p class="desk__beta">
            <span class="beta">{tx('mortgage.beta')}</span>
            {tx('mortgage.beta_note')}
          </p>
        )}
        <p class="desk__reviewed">
          <time datetime={checkedOn}>
            {t(lang, 'mortgage.reviewed', { fecha: formatLongDay(checkedOn) })}
          </time>
        </p>
      </header>
      <noscript>
        <div class="sheet sheet--notice">
          <p class="help">{tx('mortgage.no_js')}</p>
        </div>
      </noscript>
      {documents && <DocumentStart lang={lang} review="mortgage" pageGuide={pageGuide} />}
      <MortgageForm lang={lang} hidden={documents} />
      <MortgageResult lang={lang} documents={documents} />
    </div>
  </main>
</Base>

<script>
  import '../scripts/mortgage';
</script>
