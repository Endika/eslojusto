---
import CalculatorPage from './CalculatorPage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalPayGuide from '../components/FinalPayGuide.astro';
import { DOCUMENTS } from '../documents/config';
import { faqPage } from '../content/faq';
import { breadcrumbList, calculatorApp, trail } from '../content/structured-data';
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);

const home = new URL(import.meta.env.BASE_URL, Astro.site);
const page = new URL(link(lang, 'finiquito/'), Astro.site);
const documents = DOCUMENTS !== null;
const crumbs = trail(lang, { name: tx('home.final_pay'), path: '/finiquito/' });
---

<CalculatorPage
  lang={lang}
  title={tx('final_pay.title')}
  description={tx('final_pay.description')}
  path="/finiquito/"
  structuredData={[
    calculatorApp(home, page, lang),
    breadcrumbList(home, lang, crumbs),
    faqPage(lang, { documents }),
  ]}
  h1={tx('final_pay.h1')}
  lead={tx(documents ? 'final_pay.lead_documents' : 'final_pay.lead')}
>
  <Breadcrumbs slot="head" lang={lang} crumbs={crumbs} />
  <FinalPayGuide lang={lang} documents={documents} />
</CalculatorPage>

<script>
  import '../scripts/final-pay';
</script>
