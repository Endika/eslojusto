---
import CalculatorPage from './CalculatorPage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { HUBS, LANDINGS, type LandingId } from '../content/landings';
import { faqNode } from '../content/faq';
import { breadcrumbList, trail } from '../content/structured-data';
import { ET, LGSS, SOURCES } from '../engine/sources';
import { t, type Key } from '../i18n';
import { link } from '../i18n/languages';

// A page for one case: the calculator with the case marked, then its own explanation (the page's
// sheets, in the slot), its questions and the pages next to it. Spanish only, like its prose.
interface Props {
  id: LandingId;
}
const { id } = Astro.props;
const page = LANDINGS[id];
const tx = (key: Key) => t('es', key);
const href = (path: string) => link('es', path.replace(/^\//, ''));

const home = new URL(import.meta.env.BASE_URL, Astro.site);
const hub = HUBS[page.hub];
const isHub = hub.path === page.path;
const crumbs = trail(
  'es',
  { name: hub.name, path: hub.path },
  ...(isHub ? [] : [{ name: page.name, path: page.path }]),
);
// The hub first, unless this page is the hub, then the pages the map pairs it with.
const next = [
  ...(isHub ? [] : [{ name: hub.anchor, path: hub.path }]),
  ...page.related
    .map((r) => ({ name: LANDINGS[r].name, path: LANDINGS[r].path }))
    .filter(({ path }) => path !== hub.path),
];
---

<CalculatorPage
  lang="es"
  langs={['es']}
  title={page.title}
  description={page.description}
  path={page.path}
  structuredData={[breadcrumbList(home, 'es', crumbs), faqNode(page.faq)]}
  h1={page.h1}
  lead={page.lead}
  cause={page.cause}
  benefitFirst={page.benefitFirst}
>
  <Breadcrumbs slot="head" lang="es" crumbs={crumbs} />

  <article class="guide" data-tone="legal" aria-labelledby="guide-title">
    <header class="guide__head">
      <h2 class="guide__title" id="guide-title">
        {page.guideTitle}
      </h2>
      <p class="guide__sources">
        <span>{tx('guide.updated')}</span>
        <span>
          {tx('guide.sources')}: <a href={ET}>{tx('guide.source_et')}</a> ·{' '}
          <a href={SOURCES.cgpjGuide.url}>{tx('guide.source_cgpj')}</a> ·{' '}
          <a href={LGSS}>{tx('guide.source_lgss')}</a> ·{' '}
          <a href={SOURCES.sepeAmounts.url}>{tx('guide.source_sepe')}</a>
        </span>
        <a href={link('es', 'aviso-legal/')}>{tx('guide.who')}</a>
      </p>
    </header>

    <div class="guide__sheets">
      <slot />

      <section class="sheet sheet--text" aria-labelledby="case-faq">
        <h2 id="case-faq">{tx('guide.faq')}</h2>
        <div class="faq-list">
          {page.faq.map(({ question, answer }) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav class="sheet sheet--text" aria-labelledby="case-next">
        <h2 id="case-next">Sigue leyendo</h2>
        <ul class="next-pages">
          {next.map(({ name, path }) => (
            <li>
              <a href={href(path)}>{name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</CalculatorPage>

<script>
  import '../scripts/final-pay';
</script>
