---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TelecomForm from '../components/TelecomForm.astro';
import BillsResult from '../components/BillsResult.astro';
import { BILLS_BETA } from '../content/sections';
import { formatLongDay } from '../content/rent-indices';
import { breadcrumbList, trail } from '../content/structured-data';
import { LAST_UPDATED } from '../content/updated';
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);

// Each tab's share of the rail follows how much its section asks, kept close so that every name
// still fits on a phone. The second column is the section's first step, whose id is its URL
// fragment.
const sections = [
  ['cause', 'permanencia', '01', 3],
  ['salary', 'baja', '02', 3],
  ['settlement', 'terminal', '03', 3],
  ['result', 'resultado', '04', 2],
] as const;

// The day the page's rules were last checked; it exists only in a build with the page.
const checkedOn = LAST_UPDATED['/facturas/permanencia/'];
if (!checkedOn) throw new Error('/facturas/permanencia/ needs its date in LAST_UPDATED.');
const home = new URL(import.meta.env.BASE_URL, Astro.site);
const crumbs = trail(
  lang,
  { name: tx('bills.crumb'), path: '/facturas/' },
  { name: tx('bills.telecom.crumb'), path: '/facturas/permanencia/' },
);
---

<Base
  title={tx('bills.telecom.title')}
  description={tx('bills.telecom.description')}
  path="/facturas/permanencia/"
  lang={lang}
  section="cause"
  structuredData={[breadcrumbList(home, lang, crumbs)]}
>
  <nav class="tabs" slot="tabs" aria-label={tx('tabs.nav')}>
    <ol>
      {/* Only a section already reached is a link; one still ahead is plain text until then. */}
      {sections.map(([id, step, number, weight], i) => (
        <li style={`--weight: ${weight}`} data-tone={id}>
          {i === 0 ? (
            <a class="tab" data-tab={id} data-state="current" href={`#${step}`} aria-current="step">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`bills.telecom.tab.${step}`)}</span>
            </a>
          ) : (
            <span class="tab" data-tab={id} data-state="pending" aria-disabled="true">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`bills.telecom.tab.${step}`)}</span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <main id="content">
    <div class="desk">
      <header class="desk__head">
        <Breadcrumbs lang={lang} crumbs={crumbs} />
        <h1 class="desk__title">{tx('bills.telecom.h1')}</h1>
        <p class="desk__lead">{tx('bills.telecom.lead')}</p>
        {BILLS_BETA && (
          <p class="desk__beta">
            <span class="beta">{tx('bills.beta')}</span>
            {tx('bills.beta_note')}
          </p>
        )}
        <p class="desk__reviewed">
          <time datetime={checkedOn}>
            {t(lang, 'bills.reviewed', { fecha: formatLongDay(checkedOn) })}
          </time>
        </p>
      </header>
      <noscript>
        <div class="sheet sheet--notice">
          <p class="help">{tx('bills.no_js')}</p>
        </div>
      </noscript>
      <TelecomForm lang={lang} />
      <BillsResult lang={lang} review="telecom" />
    </div>
  </main>
</Base>

<script>
  import '../scripts/telecom';
</script>
