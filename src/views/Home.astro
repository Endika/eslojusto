---
import Base from '../layouts/Base.astro';
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';
import { homeGraph } from '../content/structured-data';
import { DOCUMENTS } from '../documents/config';
import { EMPLOYMENT_BETA, EMPLOYMENT_BUILD, RENTAL_BUILD } from '../content/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);
// With a review section built, its card is live and labelled as a beta.
const comingSoon = [
  ...(EMPLOYMENT_BUILD ? [] : ([['salary', tx('home.contract')]] as const)),
  ...(RENTAL_BUILD ? [] : ([['settlement', tx('home.rent')]] as const)),
] as const;
const home = new URL(import.meta.env.BASE_URL, Astro.site);
const documents = DOCUMENTS !== null;
---

<Base
  title={tx('home.title')}
  description={tx('home.description')}
  path="/"
  lang={lang}
  section="dates"
  structuredData={homeGraph(home, lang)}
>
  <main class="home" id="content">
    <div class="home__head">
      <h1 class="home__title">{tx('home.h1')}</h1>
      <p class="home__lead">{tx(RENTAL_BUILD ? 'home.lead_rental' : 'home.lead')}</p>
      <p class="home__note">{tx(documents ? 'home.note_documents' : 'home.note')}</p>
    </div>

    <ul class="index" aria-label={tx('home.index')}>
      <li class="item index__live" data-tone="cause">
        <section class="sheet" data-tone="dates" aria-labelledby="index-final-pay">
          <h2 class="index__name" id="index-final-pay">
            <a href={link(lang, 'finiquito/')}>{tx('home.final_pay')}</a>
          </h2>
          <p class="index__text">
            {tx(documents ? 'home.final_pay_text_documents' : 'home.final_pay_text')}
          </p>
          <p class="index__citation">{tx('home.final_pay_citation')}</p>
        </section>
        <span class="item__tab" aria-hidden="true"></span>
      </li>
      <li class="item index__live" data-tone="holidays">
        <section class="sheet" data-tone="dates" aria-labelledby="index-benefit">
          <h2 class="index__name" id="index-benefit">
            {/* The benefit's pages are Spanish legal prose, published only in Spanish for now. */}
            <a href={link('es', 'paro/')}>{tx('home.benefit')}</a>
          </h2>
          <p class="index__text">{tx('home.benefit_text')}</p>
          <p class="index__citation">{tx('home.benefit_citation')}</p>
        </section>
        <span class="item__tab" aria-hidden="true"></span>
      </li>
      {RENTAL_BUILD && (
        <li class="item index__live" data-tone="settlement">
          <section class="sheet" data-tone="dates" aria-labelledby="index-rental">
            <h2 class="index__name" id="index-rental">
              <a href={link(lang, 'alquiler/')}>{tx('home.rent')}</a>{' '}
              <span class="beta">{tx('home.beta')}</span>
            </h2>
            <p class="index__text">{tx('home.rent_text')}</p>
            <p class="index__citation">{tx('home.rent_citation')}</p>
            <p class="index__more">
              <a href={link(lang, 'alquiler/irav-ipc/')}>{tx('home.rent_indices')}</a>
            </p>
          </section>
          <span class="item__tab" aria-hidden="true"></span>
        </li>
      )}
      {EMPLOYMENT_BUILD && (
        <li class="item index__live" data-tone="salary">
          <section class="sheet" data-tone="dates" aria-labelledby="index-employment">
            <h2 class="index__name" id="index-employment">
              <a href={link(lang, 'contrato/')}>{tx('home.contract')}</a>{' '}
              {EMPLOYMENT_BETA && <span class="beta">{tx('home.beta')}</span>}
            </h2>
            <p class="index__text">{tx('home.contract_text')}</p>
            <p class="index__citation">{tx('home.contract_citation')}</p>
          </section>
          <span class="item__tab" aria-hidden="true"></span>
        </li>
      )}
      {comingSoon.map(([tone, name]) => (
        <li class="item index__soon" data-tone={tone}>
          <section
            class="sheet"
            data-tone="dates"
            aria-label={t(lang, 'home.coming_soon_aria', { nombre: name })}
          >
            <h2 class="index__name">{name}</h2>
            <p class="index__status">{tx('home.coming_soon')}</p>
            {tone === 'settlement' && (
              <p class="index__more">
                <a href={link(lang, 'alquiler/irav-ipc/')}>{tx('home.rent_indices')}</a>
              </p>
            )}
          </section>
          <span class="item__tab" aria-hidden="true" />
        </li>
      ))}
    </ul>
  </main>
</Base>
