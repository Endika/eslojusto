---
import Base from '../layouts/Base.astro';
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';
import { homeGraph } from '../content/structured-data';
import { DOCUMENTS } from '../documents/config';
import {
  EMPLOYMENT_BETA,
  EMPLOYMENT_BUILD,
  HOUSEHOLD_BETA,
  HOUSEHOLD_BUILD,
  INSURANCE_BETA,
  INSURANCE_BUILD,
  RENTAL_BUILD,
} from '../content/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);

interface Review {
  id: string;
  name: Key;
  href: string;
  situation: Key;
  citation: Key;
  beta: boolean;
}
interface Group {
  id: string;
  tone: string;
  label: Key;
  // A section is live with its review in hand; until then it is a name on the «próximamente» line.
  sections: (Review | Key)[];
  more?: { href: string; label: Key };
}

const groups: Group[] = [
  {
    id: 'work',
    tone: 'cause',
    label: 'home.group_work',
    sections: [
      {
        id: 'final-pay',
        name: 'home.final_pay',
        href: link(lang, 'finiquito/'),
        situation: 'home.final_pay_situation',
        citation: 'home.final_pay_citation',
        beta: false,
      },
      {
        id: 'benefit',
        name: 'home.benefit',
        // The benefit's pages are Spanish legal prose, published only in Spanish for now.
        href: link('es', 'paro/'),
        situation: 'home.benefit_situation',
        citation: 'home.benefit_citation',
        beta: false,
      },
      EMPLOYMENT_BUILD
        ? {
            id: 'employment',
            name: 'home.contract',
            href: link(lang, 'contrato/'),
            situation: 'home.contract_situation',
            citation: 'home.contract_citation',
            beta: EMPLOYMENT_BETA,
          }
        : 'home.contract',
      // Unlike the others it is not even a name on the «próximamente» line until its switch is on.
      ...(HOUSEHOLD_BUILD
        ? [
            {
              id: 'household',
              name: 'home.household' as const,
              href: link(lang, 'empleada-de-hogar/'),
              situation: 'home.household_situation' as const,
              citation: 'home.household_citation' as const,
              beta: HOUSEHOLD_BETA,
            },
          ]
        : []),
    ],
  },
  {
    id: 'housing',
    tone: 'settlement',
    label: 'home.group_housing',
    sections: [
      RENTAL_BUILD
        ? {
            id: 'rental',
            name: 'home.rent',
            href: link(lang, 'alquiler/'),
            situation: 'home.rent_situation',
            citation: 'home.rent_citation',
            beta: true,
          }
        : 'home.rent',
      'home.mortgage',
    ],
    more: { href: link(lang, 'alquiler/irav-ipc/'), label: 'home.rent_indices' },
  },
  {
    id: 'money',
    tone: 'salary',
    label: 'home.group_money',
    // With the insurance review live, credit alone is still to come.
    sections: [
      ...(INSURANCE_BUILD
        ? [
            {
              id: 'insurance',
              name: 'home.insurance',
              href: link(lang, 'seguros/'),
              situation: 'home.insurance_situation',
              citation: 'home.insurance_citation',
              beta: INSURANCE_BETA,
            } satisfies Review,
            'home.credit' as const,
          ]
        : ['home.finance' as const]),
      'home.bills',
    ],
  },
];

const live = (group: Group) => group.sections.filter((s): s is Review => typeof s !== 'string');
const soon = (group: Group) =>
  group.sections.filter((s): s is Key => typeof s === 'string').map(tx);

const home = new URL(import.meta.env.BASE_URL, Astro.site);
const documents = DOCUMENTS !== null;
---

<Base
  title={tx('home.title')}
  description={tx('home.description')}
  path="/"
  lang={lang}
  section="dates"
  structuredData={homeGraph(home, lang)}
>
  <main class="home" id="content">
    <div class="home__head">
      <h1 class="home__title">{tx('home.h1')}</h1>
      <p class="home__lead">{tx('home.lead')}</p>
    </div>

    <div class="index">
      {groups.map((group) => (
        <section class="group" data-tone={group.tone} aria-labelledby={`group-${group.id}`}>
          <h2 class="group__label" id={`group-${group.id}`}>
            {tx(group.label)}
          </h2>
          {live(group).length > 0 && (
            <ul class="group__cards">
              {live(group).map((review) => (
                <li class="card">
                  <article class="sheet" data-tone="dates" aria-labelledby={`card-${review.id}`}>
                    <h3 class="card__name" id={`card-${review.id}`}>
                      <a href={review.href}>{tx(review.name)}</a>
                    </h3>
                    <p class="card__situation">{tx(review.situation)}</p>
                    <p class="card__meta">
                      <span class="card__citation">{tx(review.citation)}</span>
                      <span class="card__go">
                        {review.beta && <span class="beta">{tx('home.beta')}</span>}
                        <span class="card__review" aria-hidden="true">
                          {tx('home.review')}
                          <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 12h15m-6-6 6 6-6 6" />
                          </svg>
                        </span>
                      </span>
                    </p>
                  </article>
                  <span class="card__tab" aria-hidden="true" />
                </li>
              ))}
            </ul>
          )}
          {group.more && (
            <p class="group__more">
              <a href={group.more.href}>{tx(group.more.label)}</a>
            </p>
          )}
          {soon(group).length > 0 && (
            <p class="group__soon">
              {t(lang, 'home.coming_soon', { secciones: soon(group).join(', ') })}
            </p>
          )}
        </section>
      ))}
    </div>

    <p class="home__note">{tx(documents ? 'home.note_documents' : 'home.note')}</p>
  </main>
</Base>
