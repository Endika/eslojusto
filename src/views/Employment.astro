---
import Base from '../layouts/Base.astro';
import EmploymentForm from '../components/EmploymentForm.astro';
import EmploymentResult from '../components/EmploymentResult.astro';
import DocumentStart from '../components/DocumentStart.astro';
import EmploymentGuide from '../components/EmploymentGuide.astro';
import { DOCUMENTS } from '../documents/config';
import { EMPLOYMENT_NORMS } from '../engine/employment/data/norms';
import { MINIMUM_WAGE } from '../engine/employment/data/minimum-wage';
import { EMPLOYMENT_BETA } from '../content/sections';
import { formatLongDay } from '../content/rent-indices';
import { employmentFaqEntries } from '../content/employment-faq';
import { faqNode } from '../content/faq';
import { employmentApp } from '../content/structured-data';
import { LAST_UPDATED } from '../content/updated';
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);

// Each tab's share of the rail follows how many sheets its section holds (the result counts two).
// The second column is the section's first step, whose id is its URL fragment.
const sections = [
  ['cause', 'relacion', '01', 1],
  ['dates', 'modalidad', '02', 2],
  ['salary', 'salario', '03', 2],
  ['holidays', 'jornada', '04', 1],
  ['settlement', 'prueba', '05', 5],
  ['result', 'resultado', '06', 2],
] as const;
// With the documents API the visit opens on the choice between uploading and typing; the tabs and
// the form wait until it is made.
const documents = DOCUMENTS !== null;

// The day the page's rules and norms were last checked; it exists only in a build with the page.
const checkedOn = LAST_UPDATED['/contrato/'];
if (!checkedOn) throw new Error('/contrato/ needs its date in LAST_UPDATED.');
const home = new URL(import.meta.env.BASE_URL, Astro.site);
const page = new URL(link(lang, 'contrato/'), Astro.site);
const structuredData = [
  employmentApp(home, page, lang),
  faqNode(
    employmentFaqEntries(lang, EMPLOYMENT_NORMS, {
      documents,
      checkedOn,
      minimumWage: MINIMUM_WAGE,
    }),
  ),
];
---

<Base
  title={tx('employment.title')}
  description={tx('employment.description')}
  path="/contrato/"
  lang={lang}
  section="cause"
  structuredData={structuredData}
  calculator={documents}
>
  <nav class="tabs" slot="tabs" aria-label={tx('tabs.nav')} hidden={documents}>
    <ol>
      {/* Only a section already reached is a link; one still ahead is plain text until then. */}
      {sections.map(([id, step, number, weight], i) => (
        <li style={`--weight: ${weight}`} data-tone={id}>
          {i === 0 ? (
            <a class="tab" data-tab={id} data-state="current" href={`#${step}`} aria-current="step">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`employment.tab.${step}`)}</span>
            </a>
          ) : (
            <span class="tab" data-tab={id} data-state="pending" aria-disabled="true">
              <span class="tab__number">{number}</span>
              <span class="tab__name">{tx(`employment.tab.${step}`)}</span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <main id="content">
    <div class="desk">
      <header class="desk__head">
        <h1 class="desk__title">{tx('employment.h1')}</h1>
        <p class="desk__lead">{tx('employment.lead')}</p>
        {EMPLOYMENT_BETA && (
          <p class="desk__beta">
            <span class="beta">{tx('employment.beta')}</span>
            {tx('employment.beta_note')}
          </p>
        )}
        <p class="desk__reviewed">
          <time datetime={checkedOn}>
            {t(lang, 'employment.reviewed', { fecha: formatLongDay(checkedOn) })}
          </time>
        </p>
      </header>
      <noscript>
        <div class="sheet sheet--notice">
          <p class="help">{tx('employment.no_js')}</p>
        </div>
      </noscript>
      {documents && <DocumentStart lang={lang} review="employment" />}
      <EmploymentForm lang={lang} hidden={documents} />
      <EmploymentResult lang={lang} documents={documents} />
    </div>
    <EmploymentGuide lang={lang} checkedOn={checkedOn} documents={documents} />
  </main>
</Base>

<script>
  import '../scripts/employment';
</script>
