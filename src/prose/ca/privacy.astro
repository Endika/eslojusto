// The allowlist (src/analytics/sanitize.ts) and the event catalogue (src/analytics/events.ts), in
// plain words. Keep all three in step: the analytics e2e asserts the exact keys.
const tracked = [
  {
    when: 'Amb cada avís',
    what: 'La data i l’hora de cada avís i un número a l’atzar que només existeix mentre la pàgina és oberta. L’adreça de la pàgina sense paràmetres: el domini, la ruta i el full on ets. El teu navegador i la seva versió, i el teu sistema (Windows, Android…). El tipus de dispositiu (ordinador, mòbil o tauleta) i la mida de la finestra. El domini del web d’on vens (per exemple «www.google.com»), sense l’adreça completa. Si arribes des d’un enllaç de campanya, el seu origen, el seu mitjà i el seu nom (utm_source, utm_medium, utm_campaign), només quan són un codi curt de lletres, números i guions. I tres dades tècniques de PostHog: la clau del projecte d’eslojusto.es, la versió del seu codi i una marca que li demana que no creï cap perfil.',
  },
  {
    when: 'En obrir una pàgina',
    what: 'Que l’has oberta i l’idioma principal del teu navegador, només la part general: «ja», no «ja-JP».',
  },
  {
    when: 'En deixar una pàgina',
    what: 'Quant de temps vas ser a la pàgina i fins on vas baixar.',
  },
  {
    when: 'Si fas servir el traductor del navegador',
    what: 'L’idioma al qual tradueixes la pàgina, per exemple «ar».',
  },
  {
    when: 'A cada full de la revisió',
    what: 'Que l’obres i, en acabar-lo, quant vas trigar en un tram ampli: menys de 10 segons, de 10 a 30, de 30 a 60, de 60 a 180 o més de 180. Si tornes enrere, de quin full a quin.',
  },
  {
    when: 'Si una dada no s’accepta',
    what: 'El nom del camp, per exemple «data de baixa». Mai el que hi vas escriure.',
  },
  {
    when: 'Si obres una ajuda',
    what: 'Quina pregunta freqüent obres, o de quina partida mires «Com es calcula».',
  },
  {
    when: 'En revisar',
    what: 'La causa del final del contracte, el tipus de contracte temporal, com cobres les pagues extraordinàries i si comptes les vacances en dies feiners o naturals i, si són feiners, si treballes 5, 6 o un altre nombre de dies a la setmana, tal com els tries a les opcions. Quantes partides porten la xifra de la teva quitança i quantes surten per sota, coincideixen, per sobre o sense poder-se comprovar. Si et descompten més preavís del màxim. Si es mostra el que pagaria un acomiadament improcedent, sense la xifra. Si el resultat surt en resum o amb el detall del passi. Si la diferència és zero, menor de 100 €, de 100 a 500 €, de 500 a 2.000 € o més gran. Quantes vegades has revisat en aquesta pàgina, quant vas trigar en trams i, si revises una altra vegada, el nom dels camps que vas canviar. De l’atur, només si l’estimació no s’aplica a la teva causa, si porta xifres o si surt sense, i quants altres contractes hi vas afegir, en un tram: 0, 1, 2 o 3 o més. Mai quants fills o filles tens a càrrec ni cap data d’aquests contractes. De l’ERTE i de si t’han pagat, només el nom de la pregunta si la canvies, mai la resposta. El que marquis sobre un possible acomiadament nul (embaràs, permisos, baixa mèdica…) no s’envia mai, ni tan sols si has marcat alguna cosa.',
  },
  {
    when: 'En prémer «Tornar a començar»',
    what: 'Que l’has premut.',
  },
  {
    when: tx('privacy.rental.tracked_sheets'),
    what: tx('privacy.rental.tracked_sheets_what'),
  },
  {
    when: tx('privacy.rental.tracked_scope'),
    what: tx('privacy.rental.tracked_scope_what'),
  },
  {
    when: tx('privacy.rental.tracked_review'),
    what: tx('privacy.rental.tracked_review_what'),
  },
  {
    when: tx('privacy.employment.tracked_sheets'),
    what: tx('privacy.employment.tracked_sheets_what'),
  },
  {
    when: tx('privacy.employment.tracked_scope'),
    what: tx('privacy.employment.tracked_scope_what'),
  },
  {
