---
// source: c76c3a602e8c
import { t, type Key } from '../../i18n';
import type { Lang } from '../../i18n/languages';
import { DOCUMENTS } from '../../documents/config';
import { PASS_DAYS, PASS_READS } from '../../documents/contract';
import {
  BILLS_BETA,
  BILLS_BUILD,
  CREDIT_BETA,
  CREDIT_BUILD,
  EMPLOYMENT_BETA,
  EMPLOYMENT_BUILD,
  ERTE_BUILD,
  HOUSEHOLD_BUILD,
  INSURANCE_BETA,
  INSURANCE_BUILD,
  MORTGAGE_BETA,
  MORTGAGE_BUILD,
  RENTAL_BUILD,
} from '../../content/sections';
import { erteCopy } from '../../content/erte';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tx = (key: Key, vars?: Record<string, string>) => t(lang, key, vars);

const email = 'hola@eslojusto.es';
// The owner's details (art. 10 LSSI), on every build: the duty covers the whole site.
const owner = {
  titular: tx('legal.owner_name'),
  nif: tx('legal.owner_id'),
  domicilio: tx('legal.owner_address'),
};
// The pass and its conditions exist only in a build with the documents API.
const documents = DOCUMENTS !== null;
// The rental review and its paragraphs exist only in a PUBLIC_RENTAL=1 build.
const rental = RENTAL_BUILD;
// The contract review exists only in a PUBLIC_EMPLOYMENT=1 build; so do the paragraphs about it.
const employment = EMPLOYMENT_BUILD;
// The household review exists only in a PUBLIC_HOUSEHOLD=1 build; so do the paragraphs about it.
const household = HOUSEHOLD_BUILD;
// The ERTE page exists only in a PUBLIC_ERTE=1 build; so do the paragraphs about it.
const erte = ERTE_BUILD;
const erteText = erteCopy(lang);
// The credit and insurance reviews exist only in a PUBLIC_CREDIT=1 or PUBLIC_INSURANCE=1 build; so
// do the paragraphs about each.
const credit = CREDIT_BUILD;
const insurance = INSURANCE_BUILD;
// The mortgage review exists only in a PUBLIC_MORTGAGE=1 build; so do the paragraphs about it.
const mortgage = MORTGAGE_BUILD;
// The bills reviews exist only in a PUBLIC_BILLS=1 build; so do the paragraphs about them.
const bills = BILLS_BUILD;
---

<div class="document__sheets">
  <section class="sheet sheet--text">
    <h2 id="al-quien">{tx('legal_notice.who')}</h2>
    <p>
      eslojusto.es is a project by Endika Iglesias. For any question about the website, write to{' '}
      <a href={`mailto:${email}`}>{email}</a>.
    </p>
    <p>{tx('legal_notice.owner')}</p>
    <dl class="data-list" data-owner>
      <div>
        <dt>{tx('legal.owner_name_label')}</dt>
        <dd>{owner.titular}</dd>
      </div>
      <div>
        <dt>{tx('legal.owner_id_label')}</dt>
        <dd>{owner.nif}</dd>
      </div>
      {owner.domicilio && (
        <div>
          <dt>{tx('legal.owner_address_label')}</dt>
          <dd>{owner.domicilio}</dd>
        </div>
      )}
      <div>
        <dt>{tx('legal.owner_contact_label')}</dt>
        <dd>
          <a href={`mailto:${email}`}>{email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="sheet sheet--text">
    <h2 id="al-que-hace">{tx('legal_notice.what_it_does')}</h2>
    <p>
      It compares the figures in your final settlement (finiquito) with the minimum set by law, item
      by item. The formulas follow the Workers' Statute (Estatuto de los Trabajadores) and the
      CGPJ's practical guide for calculating severance pay (v0.6, July 2026), and each figure comes
      with the article it is taken from.
    </p>
    <p>
      When a rule allows two calculations, it gives the range between them. What your collective
      agreement may improve, such as more days of holiday or a different accrual of the extra
      payments (pagas extra), is compared with the legal minimum and flagged. When a detail is
      missing without which there is no legal figure, such as the notice period for a resignation,
      it marks it as “can't be checked” instead of giving a figure it cannot know.
    </p>
    {documents && (
      <p>
        If you upload a document, an AI model copies its details into the form. It does not
        calculate anything: you confirm each detail before reviewing, and the figures are calculated
        by the same tool as when you type them in.
      </p>
    )}
  </section>

  <section class="sheet sheet--text">
    <h2 id="al-no-hace">{tx('legal_notice.what_it_does_not')}</h2>
    <ul>
      <li>It is not legal advice. It gives general information about what the law says.</li>
      <li>
        It does not know your collective agreement, and it does not review net pay, bonuses
        (pluses), overtime or commissions.
      </li>
      <li>
        It does not decide whether the grounds for a dismissal are justified. That is for a court to
        decide.
      </li>
      <li>It does not tell you what to do with your final settlement.</li>
    </ul>
    <p>
      It does not replace an employment law firm, a labour relations adviser (graduado social) or a
      trade union, who can review your case with your documents and your collective agreement.
    </p>
  </section>

  {rental && (
    <section class="sheet sheet--text">
      <h2 id="al-alquiler">
        {tx('legal_notice.rental')} <span class="beta">{tx('rental.beta')}</span>
      </h2>
      <p>{tx('legal_notice.rental.does')}</p>
      <p>{tx('legal_notice.rental.pending')}</p>
      <p>{tx('legal_notice.rental.does_not')}</p>
      <p>
        {tx('legal_notice.rental.beta')} <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  )}

  {employment && (
    <section class="sheet sheet--text">
      <h2 id="al-contrato">
        {tx('legal_notice.employment')}
        {EMPLOYMENT_BETA && <span class="beta">{tx('employment.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.employment.does')}</p>
      <p>{tx('legal_notice.employment.does_not')}</p>
      {EMPLOYMENT_BETA && (
        <p>
          {tx('legal_notice.employment.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {household && (
    <section class="sheet sheet--text">
      <h2 id="al-hogar">
        {tx('legal_notice.household')} <span class="beta">{tx('household.beta')}</span>
      </h2>
      <p>{tx('legal_notice.household.does')}</p>
      <p>{tx('legal_notice.household.does_not')}</p>
      <p>
        {tx('legal_notice.household.beta')} <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  )}

  {credit && (
    <section class="sheet sheet--text">
      <h2 id="al-financiacion">
        {tx('legal_notice.credit')}
        {CREDIT_BETA && <span class="beta">{tx('credit.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.credit.does')}</p>
      <p>{tx('legal_notice.credit.does_not')}</p>
      {CREDIT_BETA && (
        <p>
          {tx('legal_notice.credit.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {insurance && (
    <section class="sheet sheet--text">
      <h2 id="al-seguros">
        {tx('legal_notice.insurance')}
        {INSURANCE_BETA && <span class="beta">{tx('insurance.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.insurance.does')}</p>
      <p>{tx('legal_notice.insurance.does_not')}</p>
      {INSURANCE_BETA && (
        <p>
          {tx('legal_notice.insurance.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {mortgage && (
    <section class="sheet sheet--text">
      <h2 id="al-hipoteca">
        {tx('legal_notice.mortgage')}
        {MORTGAGE_BETA && <span class="beta">{tx('mortgage.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.mortgage.does')}</p>
      <p>{tx('legal_notice.mortgage.does_not')}</p>
      {MORTGAGE_BETA && (
        <p>
          {tx('legal_notice.mortgage.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {bills && (
    <section class="sheet sheet--text">
      <h2 id="al-facturas">
        {tx('legal_notice.bills')}
        {BILLS_BETA && <span class="beta">{tx('bills.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.bills.does')}</p>
      <p>{tx('legal_notice.bills.does_not')}</p>
      {BILLS_BETA && (
        <p>
          {tx('legal_notice.bills.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {erte && (
    <section class="sheet sheet--text">
      <h2 id="al-erte">
        {erteText.legal.title} <span class="beta">{erteText.page.beta}</span>
      </h2>
      <p>{erteText.legal.does}</p>
      <p>{erteText.legal.doesNot}</p>
      <p>
        {erteText.legal.beta} <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  )}

  {documents && (
    <section class="sheet sheet--text">
      <h2 id="condiciones">{tx('legal_notice.conditions')}</h2>
      <p>
        {tx('legal_notice.seller', owner)}{' '}
        {owner.domicilio && <>{tx('legal_notice.seller_address', owner)} </>}
        For any question about a purchase, write to <a href={`mailto:${email}`}>{email}</a>.
      </p>
      <ul>
        <li>
          What you buy: a digital pass that lasts {PASS_DAYS} days from payment and is only valid in
          the browser you pay with. During that time you can redo or correct your review, read up to{' '}
          {PASS_READS} document packs and download, as many times as you like and without paying
          again, a PDF report with the review of your final settlement and a template letter
          “received, not agreed” (recibí no conforme), with your figures if something is missing.
          The report and the letter are generated on your device with the details of your review,
          which we do not store anywhere.
        </li>
        {rental && <li>{tx('legal_notice.rental.pass', { dias: String(PASS_DAYS) })}</li>}
        {employment && <li>{tx('legal_notice.employment.pass', { dias: String(PASS_DAYS) })}</li>}
        {mortgage && <li>{tx('legal_notice.mortgage.pass', { dias: String(PASS_DAYS) })}</li>}
        {bills && <li>{tx('legal_notice.bills.pass', { dias: String(PASS_DAYS) })}</li>}
        <li>
          Where it is valid: the pass is stored only in that browser. On another device, in a
          private window or if you clear your browsing data, it is lost.
        </li>
        <li>
          Price: 4,99 € including IVA (VAT). A single payment by card or Bizum on Stripe's page,
          with no subscription or later charges.
        </li>
        <li>
          Delivery: immediate, when you return from the payment; download the report and the letter
          then. If you do not see the downloads, “Already paid?” in the result recovers the pass,
          but only in the browser you paid with.
        </li>
        <li>
          Withdrawal: it is digital content delivered immediately. Before paying, we ask you to tick
          that you want to receive it now and that you know you thereby lose the 14-day right of
          withdrawal (art. 103.m of the consolidated text of the Ley General para la Defensa de los
          Consumidores y Usuarios, the general consumer protection law).
        </li>
        <li>
          If something goes wrong, for example if you cannot download the report or you are charged
          twice, write to <a href={`mailto:${email}`}>{email}</a> and the corresponding amount is
          refunded.
        </li>
        <li>
          The report gives general information about the law and is not legal advice. The letter is
          a template: whether to use it or not is your decision.
        </li>
      </ul>
    </section>
  )}

  <section class="sheet sheet--text">
    <h2 id="al-errores">{tx('legal_notice.errors')}</h2>
    <p>
      Severance pay figures are checked against cases calculated with the CGPJ's calculator. If you
      see a figure that does not match the law, you can write to{' '}
      <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </section>
</div>
