---
// source: c76c3a602e8c
import { t, type Key } from '../../i18n';
import type { Lang } from '../../i18n/languages';
import { DOCUMENTS } from '../../documents/config';
import { PASS_DAYS, PASS_READS } from '../../documents/contract';
import {
  BILLS_BETA,
  BILLS_BUILD,
  CREDIT_BETA,
  CREDIT_BUILD,
  EMPLOYMENT_BETA,
  EMPLOYMENT_BUILD,
  ERTE_BUILD,
  HOUSEHOLD_BUILD,
  INSURANCE_BETA,
  INSURANCE_BUILD,
  MORTGAGE_BETA,
  MORTGAGE_BUILD,
  RENTAL_BUILD,
} from '../../content/sections';
import { erteCopy } from '../../content/erte';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tx = (key: Key, vars?: Record<string, string>) => t(lang, key, vars);

const email = 'hola@eslojusto.es';
// The owner's details (art. 10 LSSI), on every build: the duty covers the whole site.
const owner = {
  titular: tx('legal.owner_name'),
  nif: tx('legal.owner_id'),
  domicilio: tx('legal.owner_address'),
};
// The pass and its conditions exist only in a build with the documents API.
const documents = DOCUMENTS !== null;
// The rental review and its paragraphs exist only in a PUBLIC_RENTAL=1 build.
const rental = RENTAL_BUILD;
// The contract review exists only in a PUBLIC_EMPLOYMENT=1 build; so do the paragraphs about it.
const employment = EMPLOYMENT_BUILD;
// The household review exists only in a PUBLIC_HOUSEHOLD=1 build; so do the paragraphs about it.
const household = HOUSEHOLD_BUILD;
// The ERTE page exists only in a PUBLIC_ERTE=1 build; so do the paragraphs about it.
const erte = ERTE_BUILD;
const erteText = erteCopy(lang);
// The credit and insurance reviews exist only in a PUBLIC_CREDIT=1 or PUBLIC_INSURANCE=1 build; so
// do the paragraphs about each.
const credit = CREDIT_BUILD;
const insurance = INSURANCE_BUILD;
// The mortgage review exists only in a PUBLIC_MORTGAGE=1 build; so do the paragraphs about it.
const mortgage = MORTGAGE_BUILD;
// The bills reviews exist only in a PUBLIC_BILLS=1 build; so do the paragraphs about them.
const bills = BILLS_BUILD;
---

<div class="document__sheets">
  <section class="sheet sheet--text">
    <h2 id="al-quien">{tx('legal_notice.who')}</h2>
    <p>
      eslojusto.es مشروع يعود إلى Endika Iglesias. لأي استفسار بشأن الموقع، اكتب إلى
      <a href={`mailto:${email}`}>{email}</a>.
    </p>
    <p>{tx('legal_notice.owner')}</p>
    <dl class="data-list" data-owner>
      <div>
        <dt>{tx('legal.owner_name_label')}</dt>
        <dd>{owner.titular}</dd>
      </div>
      <div>
        <dt>{tx('legal.owner_id_label')}</dt>
        <dd>{owner.nif}</dd>
      </div>
      {owner.domicilio && (
        <div>
          <dt>{tx('legal.owner_address_label')}</dt>
          <dd>{owner.domicilio}</dd>
        </div>
      )}
      <div>
        <dt>{tx('legal.owner_contact_label')}</dt>
        <dd>
          <a href={`mailto:${email}`}>{email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="sheet sheet--text">
    <h2 id="al-que-hace">{tx('legal_notice.what_it_does')}</h2>
    <p>
      تقارن أرقام تسويتك النهائية <bdi>(finiquito)</bdi> بالحد الأدنى الذي يحدّده القانون، بندًا
      بندًا. وتتبع الصيغ نظام العمال <bdi>(Estatuto de los Trabajadores)</bdi> والدليل العملي لحساب
      التعويضات الصادر عن المجلس العام للسلطة القضائية <bdi>(CGPJ)</bdi> (الإصدار v0.6، يوليو 2026)،
      ويحمل كل رقم المادة القانونية التي يستند إليها.
    </p>
    <p>
      عندما تحتمل قاعدةٌ ما طريقتين للحساب، تعطي الهامش بينهما. وما يمكن أن تحسّنه اتفاقيتك الجماعية{' '}
      <bdi>(convenio colectivo)</bdi>، مثل أيام إجازة أكثر أو طريقة أخرى لتراكم الدفعات الإضافية{' '}
      <bdi>(pagas extra)</bdi>، يُقارَن بالحد الأدنى القانوني وتنبّه الأداة إليه. وعندما تنقص معلومة
      لا يوجد من دونها رقم قانوني، مثل مهلة الإشعار المسبق <bdi>(preaviso)</bdi> في الاستقالة، تضع
      عليها علامة «لا يمكن التحقق منه» بدلًا من إعطاء رقم لا يمكنها معرفته.
    </p>
    {documents && (
      <p>
        إذا رفعت مستندًا، ينسخ نموذج ذكاء اصطناعي بياناته إلى النموذج. ولا يحسب شيئًا: أنت تؤكّد كل
        معلومة قبل المراجعة، والأرقام تحسبها الأداة نفسها التي تحسبها عندما تكتب البيانات بنفسك.
      </p>
    )}
  </section>

  <section class="sheet sheet--text">
    <h2 id="al-no-hace">{tx('legal_notice.what_it_does_not')}</h2>
    <ul>
      <li>ليست استشارة قانونية. تقدّم معلومات عامة عمّا يقوله القانون.</li>
      <li>
        لا تعرف اتفاقيتك الجماعية، ولا تراجع الراتب الصافي، ولا العلاوات <bdi>(pluses)</bdi>، ولا
        الساعات الإضافية، ولا العمولات.
      </li>
      <li>لا تقرّر ما إذا كان سبب الفصل مبرَّرًا. هذا تقرّره المحكمة.</li>
      <li>لا تقول لك ماذا تفعل بتسويتك النهائية.</li>
    </ul>
    <p>
      لا تحلّ محلّ مكتب محاماة متخصص في قانون العمل، أو مكتب مستشار في شؤون العمل
      <bdi>(graduado social)</bdi>، أو نقابة، إذ يمكنهم مراجعة حالتك بمستنداتك واتفاقيتك الجماعية.
    </p>
  </section>

  {rental && (
    <section class="sheet sheet--text">
      <h2 id="al-alquiler">
        {tx('legal_notice.rental')} <span class="beta">{tx('rental.beta')}</span>
      </h2>
      <p>{tx('legal_notice.rental.does')}</p>
      <p>{tx('legal_notice.rental.pending')}</p>
      <p>{tx('legal_notice.rental.does_not')}</p>
      <p>
        {tx('legal_notice.rental.beta')} <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  )}

  {employment && (
    <section class="sheet sheet--text">
      <h2 id="al-contrato">
        {tx('legal_notice.employment')}
        {EMPLOYMENT_BETA && <span class="beta">{tx('employment.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.employment.does')}</p>
      <p>{tx('legal_notice.employment.does_not')}</p>
      {EMPLOYMENT_BETA && (
        <p>
          {tx('legal_notice.employment.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {household && (
    <section class="sheet sheet--text">
      <h2 id="al-hogar">
        {tx('legal_notice.household')} <span class="beta">{tx('household.beta')}</span>
      </h2>
      <p>{tx('legal_notice.household.does')}</p>
      <p>{tx('legal_notice.household.does_not')}</p>
      <p>
        {tx('legal_notice.household.beta')} <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  )}

  {credit && (
    <section class="sheet sheet--text">
      <h2 id="al-financiacion">
        {tx('legal_notice.credit')}
        {CREDIT_BETA && <span class="beta">{tx('credit.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.credit.does')}</p>
      <p>{tx('legal_notice.credit.does_not')}</p>
      {CREDIT_BETA && (
        <p>
          {tx('legal_notice.credit.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {insurance && (
    <section class="sheet sheet--text">
      <h2 id="al-seguros">
        {tx('legal_notice.insurance')}
        {INSURANCE_BETA && <span class="beta">{tx('insurance.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.insurance.does')}</p>
      <p>{tx('legal_notice.insurance.does_not')}</p>
      {INSURANCE_BETA && (
        <p>
          {tx('legal_notice.insurance.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {mortgage && (
    <section class="sheet sheet--text">
      <h2 id="al-hipoteca">
        {tx('legal_notice.mortgage')}
        {MORTGAGE_BETA && <span class="beta">{tx('mortgage.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.mortgage.does')}</p>
      <p>{tx('legal_notice.mortgage.does_not')}</p>
      {MORTGAGE_BETA && (
        <p>
          {tx('legal_notice.mortgage.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {bills && (
    <section class="sheet sheet--text">
      <h2 id="al-facturas">
        {tx('legal_notice.bills')}
        {BILLS_BETA && <span class="beta">{tx('bills.beta')}</span>}
      </h2>
      <p>{tx('legal_notice.bills.does')}</p>
      <p>{tx('legal_notice.bills.does_not')}</p>
      {BILLS_BETA && (
        <p>
          {tx('legal_notice.bills.beta')} <a href={`mailto:${email}`}>{email}</a>.
        </p>
      )}
    </section>
  )}

  {erte && (
    <section class="sheet sheet--text">
      <h2 id="al-erte">
        {erteText.legal.title} <span class="beta">{erteText.page.beta}</span>
      </h2>
      <p>{erteText.legal.does}</p>
      <p>{erteText.legal.doesNot}</p>
      <p>
        {erteText.legal.beta} <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  )}

  {documents && (
    <section class="sheet sheet--text">
      <h2 id="condiciones">{tx('legal_notice.conditions')}</h2>
      <p>
        {tx('legal_notice.seller', owner)}{' '}
        {owner.domicilio && <>{tx('legal_notice.seller_address', owner)} </>}
        لأي استفسار بشأن عملية شراء، اكتب إلى <a href={`mailto:${email}`}>{email}</a>.
      </p>
      <ul>
        <li>
          ما تشتريه: تصريح رقمي يدوم {PASS_DAYS} يومًا من تاريخ الدفع ولا يصلح إلا في المتصفح الذي
          تدفع منه. خلال هذه المدة يمكنك إعادة مراجعتك أو تصحيحها، وقراءة ما يصل إلى {PASS_READS} من
          حِزم المستندات، وأن تنزّل، كلما أردت ومن دون أن تدفع مرة أخرى، تقريرًا بصيغة PDF بمراجعة
          تسويتك النهائية <bdi>(finiquito)</bdi> وقالب رسالة «recibí no conforme» (استلمت، دون
          موافقة)، بأرقامك إذا كان هناك شيء ناقص. يُنشأ التقرير والرسالة على جهازك ببيانات مراجعتك،
          التي لا نحفظها في أي مكان.
        </li>
        {rental && <li>{tx('legal_notice.rental.pass', { dias: String(PASS_DAYS) })}</li>}
        {employment && <li>{tx('legal_notice.employment.pass', { dias: String(PASS_DAYS) })}</li>}
        {mortgage && <li>{tx('legal_notice.mortgage.pass', { dias: String(PASS_DAYS) })}</li>}
        {bills && <li>{tx('legal_notice.bills.pass', { dias: String(PASS_DAYS) })}</li>}
        <li>
          أين يصلح: يُحفَظ التصريح في ذلك المتصفح فقط. ويضيع على جهاز آخر، أو في نافذة خاصة، أو إذا
          حذفت بيانات التصفح.
        </li>
        <li>
          السعر: 4,99 € شاملًا ضريبة القيمة المضافة <bdi>(IVA)</bdi>. دفعة واحدة بالبطاقة أو عبر
          Bizum في صفحة Stripe، من دون اشتراك ولا اقتطاعات لاحقة.
        </li>
        <li>
          التسليم: فوري، عند العودة من الدفع؛ نزِّل عندها التقرير والرسالة. إذا لم ترَ التنزيلات،
          فإن «هل دفعت بالفعل؟» في النتيجة يسترجع التصريح، ولكن فقط في المتصفح الذي دفعت منه.
        </li>
        <li>
          حق العدول <bdi>(desistimiento)</bdi>: إنه محتوى رقمي يُسلَّم فورًا. قبل الدفع نطلب منك أن
          تؤشّر على أنك تريد استلامه الآن وأنك تعلم أنك بذلك تفقد حق العدول البالغ 14 يومًا، المنصوص
          عليه في النص المُعاد صياغته للقانون العام للدفاع عن المستهلكين والمستخدمين
          <bdi>
            (art. 103.m del texto refundido de la Ley General para la Defensa de los Consumidores y
            Usuarios)
          </bdi>
          .
        </li>
        <li>
          إذا تعطّل شيء ما، مثلًا إذا لم تتمكّن من تنزيل التقرير أو اقتُطع منك المبلغ مرتين، اكتب
          إلى
          <a href={`mailto:${email}`}>{email}</a> ويُردّ المبلغ الذي يقتضيه الأمر.
        </li>
        <li>
          يقدّم التقرير معلومات عامة عن القانون وليس استشارة قانونية. والرسالة قالب: استخدامه أو عدم
          استخدامه قرارك.
        </li>
      </ul>
    </section>
  )}

  <section class="sheet sheet--text">
    <h2 id="al-errores">{tx('legal_notice.errors')}</h2>
    <p>
      تُقارَن التعويضات <bdi>(indemnizaciones)</bdi> بحالات محسوبة بحاسبة CGPJ. إذا رأيت رقمًا لا
      يتوافق مع القانون، يمكنك الكتابة إلى <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </section>
</div>
