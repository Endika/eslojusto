---
// source: 176e7bb53168
import CaseLink from '../../components/CaseLink.astro';
import { itemRange, objective, severanceMonths } from '../../content/examples';
import { euroRange, euros } from '../../content/format';
import type { Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const severance = itemRange(objective, 'severance');
const notice = itemRange(objective, 'employer_notice');
const salary = itemRange(objective, 'pending_salary');
const holidays = itemRange(objective, 'holiday_pay');
const extraPay = itemRange(objective, 'extra_pay');
const unfair = objective.unfairReference;
const months =
  severanceMonths(
    objective.items.find((p) => p.item.id === 'severance')?.item.calculation ?? [],
  )[0] ?? 0;
if (!severance || !notice || !salary || !holidays || !extraPay || unfair === null)
  throw new Error('Incomplete example');
---

<section class="sheet sheet--text">
  <h3 id="do-20-dias">20 يومًا عن كل سنة، بحدّ أقصى 12 راتبًا شهريًا</h3>
  <p>
    في الفصل لأسباب موضوعية <bdi>(despido objetivo)</bdi>، تلتزم الشركة بأن تضع تحت تصرفك، مع رسالة
    الفصل، تعويضًا <bdi>(indemnización)</bdi> قدره 20 يومًا من الراتب عن كل سنة عمل، بحدّ أقصى 12
    راتبًا شهريًا <bdi>(art. 53.1.b ET)</bdi>. يحتسب دليل CGPJ، بعد STS 651/2026، ذلك الحد بـ360
    يومًا. تُحسب المدة بالأشهر، وجزء الشهر يُحتسب شهرًا كاملًا.
  </p>
  <p class="folio">
    Art. <span>53.1.b</span> ET
  </p>
</section>

<section class="sheet sheet--text">
  <h3 id="do-preaviso">15 يومًا من الإشعار المسبق، أو دفع مقابلها</h3>
  <p>
    بين الرسالة والفصل يلزم أن تمرّ 15 يومًا من الإشعار المسبق <bdi>(preaviso)</bdi>
    <bdi>(art. 53.1.c ET)</bdi>. الأيام التي لا تمنحها الشركة تُدفع. تسألك الحاسبة عن عدد الأيام
    التي مُنحت لك وتحسب الأيام الناقصة.
  </p>
  <p class="folio">
    Art. <span>53.1.c</span> ET
  </p>
</section>

<section class="sheet sheet--text">
  <h3 id="do-ejemplo">مثال محلول</h3>
  <p>
    شخص يتقاضى 1.500&nbsp;€ إجمالًا في الشهر، مع دفعتين إضافيتين قيمة كل منهما 1.500&nbsp;€، يعمل من
    3 مايو 2018 إلى 20 يوليو 2026. استفاد هذا العام من 10 أيام من الإجازة، ولا تمنحه الشركة إشعارًا
    مسبقًا. هذه أرقام الحاسبة:
  </p>
  <ul>
    <li>
      التعويض: {euroRange(severance)} ({months} شهرًا × 20 / 12 ={' '}
      {String((months * 20) / 12).replace('.', ',')} يوم).
    </li>
    <li>الإشعار المسبق غير الممنوح: {euroRange(notice)}.</li>
    <li>راتب يوليو: {euroRange(salary)}.</li>
    <li>أيام الإجازة غير المستفاد منها: {euroRange(holidays)}.</li>
    <li>الدفعة الإضافية لعيد الميلاد المتراكمة منذ 1 يوليو: {euroRange(extraPay)}.</li>
  </ul>
  <p class="example">
    <span class="example__label">إذا أُعلن أن الفصل غير مبرَّر</span> بالتواريخ نفسها، يكون التعويض{' '}
    {euros(unfair)}، بمعدل 33 يومًا عن كل سنة. تعرض لك المراجعة هذا الرقم بجانب رقم الفصل لأسباب
    موضوعية.
  </p>
</section>

<section class="sheet sheet--text">
  <h3 id="do-diferencia">الفصل لأسباب موضوعية أو الفصل غير المبرَّر</h3>
  <p>
    يمكن الطعن في الفصل لأسباب موضوعية كما يُطعن في الفصل التأديبي <bdi>(art. 53.3 ET)</bdi>. إذا
    أُعلن أنه غير مبرَّر <bdi>(improcedente)</bdi>، يُحسب التعويض بمعدل 33 يومًا عن كل سنة، بحدّ
    أقصى 720 يومًا: تجد ذلك في صفحة <CaseLink lang={lang} id="unfair_dismissal" />. مهلة الطعن فيه
    20 يوم عمل رسمي <bdi>(art. 59.3 ET)</bdi>.
  </p>
  <p class="folio">
    Art. <span>53 · 56 · 59</span> ET
  </p>
</section>
