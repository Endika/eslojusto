---
// source: f63abb595478
import { NORMS } from '../../engine/rental/data/norms';
import { depositExample, rentalPagesCopy } from '../../content/rental-pages';
import { formatEuros } from '../../content/rent-indices';
import { link, type Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { review: REVIEW, pages: RENTAL_PAGES, pageDecree } = rentalPagesCopy(lang);

const ex = depositExample();
// Until the Congress votes the decree down, the insurance ban stands as pending.
const banStands = NORMS.rdl29_2026.status !== 'repealed';
const href = (path: string) => link(lang, path.replace(/^\//, ''));
---

<section class="sheet sheet--text" aria-labelledby="fianza-legal">
  <h2 id="fianza-legal">Garanția: o chirie lunară</h2>
  <p>
    Garanția (fianza) este obligatorie și, la închirierea unei locuințe, este egală cu o chirie
    lunară, în bani (art. 36.1 LAU).
  </p>
  <p>
    Când se termină contractul și predai cheile, trebuie să ți se restituie în termen de o lună:{' '}
    <a href={href(RENTAL_PAGES.deposit_return.path)}>{RENTAL_PAGES.deposit_return.name}</a>.
  </p>
  <p class="folio">
    Art. <span>36.1</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="garantia-adicional">
  <h2 id="garantia-adicional">Alte garanții: până la încă două chirii lunare</h2>
  <p>
    În plus față de garanție, contractul poate cere o altă garanție: mai mulți bani sau o
    fidejusiune (aval). În contractele semnate din 6 martie 2019 pe cel mult cinci ani, sau pe cel
    mult șapte dacă proprietarul este o firmă, această garanție suplimentară nu poate depăși două
    chirii lunare (art. 36.5 LAU).
  </p>
  <p>Verificarea compară cu plafonul banii pe care i-ai plătit.</p>
  {banStands && (
    <p>
      Potrivit decretului, proprietarul nu mai poate să îți ceară o asigurare împotriva neplății
      chiriei (seguro de impago): o explică <a href="#seguro">secțiunea despre asigurare</a>, mai
      jos.
    </p>
  )}
  <p class="folio">
    Art. <span>36.5</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="adelantado">
  <h2 id="adelantado">În avans: o chirie lunară</h2>
  <p>În avans, proprietarul nu poate cere mai mult de o chirie lunară (art. 17 LAU).</p>
  <p class="folio">
    Art. <span>17</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="seguro">
  <h2 id="seguro">
    {banStands
      ? 'Asigurarea împotriva neplății chiriei: decretul interzice să ți se ceară'
      : 'Asigurarea împotriva neplății chiriei'}
  </h2>
  <p>{pageDecree('deposit', 'rental.page.decree.insurance')}</p>
  <p class="folio">
    Art. <span>36.5</span> LAU · RDL 29/2026
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="ejemplo">
  <h2 id="ejemplo">Exemplu rezolvat</h2>
  <p>
    La o chirie de {formatEuros(ex.rent)}, un proprietar cere {formatEuros(ex.asked)} în bani
    înainte de mutare: garanția și garanții suplimentare.
  </p>
  <p class="example">
    <span class="example__label">Calculul</span> Garanția este o chirie lunară,{' '}
    {formatEuros(ex.rent)}, iar garanția suplimentară poate fi de două, {formatEuros(2 * ex.rent)}.
    Maximul este {formatEuros(ex.allowed)}. Ți se cer {formatEuros(ex.asked)}:{' '}
    {formatEuros(ex.over)} peste plafon.
  </p>
  <p class="folio">
    Art. <span>36.1 · 36.5</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="revision">
  <h2 id="revision">Verifică ce ți s-a cerut</h2>
  <p>
    <a href={href(REVIEW.path)}>Verificarea închirierii</a> compară cu aceste plafoane garanția,
    garanțiile suplimentare și plata în avans din contractul tău și îți spune cu cât depășește
    fiecare plafon.
  </p>
</section>
