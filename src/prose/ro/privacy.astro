import { t, type Key } from '../../i18n';
import { link, type Lang } from '../../i18n/languages';
import { DOCUMENTS } from '../../documents/config';
import { OUTAGE_KEY } from '../../documents/outage';
import { STORAGE_KEYS } from '../../documents/pass';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tx = (key: Key) => t(lang, key);

const email = 'hola@eslojusto.es';
// Reading documents and the pass exist only in a build with their API; so do their paragraphs.
const documents = DOCUMENTS !== null;

// One entry per thing that is stored or processed; a new tool adds a row here.
const stored = [
  {
    what: tx('privacy.data_review'),
    where:
      'Doar în browserul tău, cât timp pagina este deschisă. Calculul se face pe dispozitivul tău: datele calendaristice, salariul tău, cifrele lichidării tale finale (finiquito), copiii aflați în întreținerea ta și celelalte contracte ale tale nu se trimit la niciun server și nici nu se păstrează. Când închizi sau reîncarci pagina, dispar.',
  },
  { what: tx('privacy.rental.data_review'), where: tx('privacy.rental.data_review_where') },
  {
    what: tx('privacy.employment.data_review'),
    where: tx('privacy.employment.data_review_where'),
  },
  {
    what: tx('privacy.household.data_review'),
    where: tx('privacy.household.data_review_where'),
  },
  { what: tx('privacy.credit.data_review'), where: tx('privacy.credit.data_review_where') },
  {
    what: tx('privacy.insurance.data_review'),
    where: tx('privacy.insurance.data_review_where'),
  },
  {
    what: tx('privacy.mortgage.data_review'),
    where: tx('privacy.mortgage.data_review_where'),
  },
  { what: tx('privacy.bills.data_review'), where: tx('privacy.bills.data_review_where') },
  ...(documents
    ? [{ what: tx('privacy.bills.data_year'), where: tx('privacy.bills.data_year_where') }]
    : []),
  {
    what: tx('privacy.data_analytics'),
    where:
      'Câteva evenimente scurte cu coduri și intervale, care se trimit la PostHog cât timp folosești pagina (detaliile, mai jos). Identificatorul vizualizării paginii există doar în memoria ei: nu se scrie pe dispozitivul tău și se pierde când o închizi sau o reîncarci.',
  },
  ...(documents
    ? [
        {
          what: tx('privacy.data_documents'),
          where:
            'Doar dacă alegi să îți încarci documentele (scrisoarea de concediere, lichidarea finală, fluturașii de salariu, adeverința de la firmă (certificado de empresa), un acord sau un proces-verbal de conciliere (acta de conciliación) ori istoricul de muncă (vida laboral)) și îți dai consimțământul. Fișierele PDF se transformă în imagini ale paginilor lor în browserul tău, fără să iasă din el, iar înainte să trimită ceva, pagina verifică, tot în browserul tău, dacă vreo fotografie pare întunecată, neclară sau mică. Aceste imagini și fotografiile ajung criptate la un server al eslojusto.es din Amazon Web Services, în Spania (regiunea eu-south-2), care le transmite unui model de IA (Claude, de la Anthropic) prin Amazon Bedrock, în interiorul Uniunii Europene. Modelul de IA indică ce tip de document este fiecare pagină, copiază datele cerute de formular, iar ce s-a citit se întoarce în browserul tău. Nu se păstrează nimic: documentele există doar în memoria serverului cât timp sunt citite, iar jurnalele lor, care se păstrează 14 zile, conțin doar date tehnice: rezultatul, numărul de pagini, cât a durat, cât text a procesat modelul de IA și câțiva indicatori de funcționare, cum ar fi dacă a fost nevoie de o a doua citire, câte informații nu coincideau între documente (fără să spună care sau valorile lor) ori câte pagini nu au putut fi citite și de ce (de exemplu, neclare sau din altă țară). Niciodată conținutul sau ceva care te identifică.',
        },
        {
          what: tx('privacy.rental.data_documents'),
          where: tx('privacy.rental.data_documents_where'),
        },
        {
          what: tx('privacy.rental.data_letters'),
          where: tx('privacy.rental.data_letters_where'),
        },
        {
          what: tx('privacy.employment.data_documents'),
          where: tx('privacy.employment.data_documents_where'),
        },
        {
          what: tx('privacy.employment.data_letters'),
          where: tx('privacy.employment.data_letters_where'),
        },
        {
          what: tx('privacy.credit.data_documents'),
          where: tx('privacy.credit.data_documents_where'),
        },
        {
          what: tx('privacy.credit.data_letters'),
          where: tx('privacy.credit.data_letters_where'),
        },
        {
          what: tx('privacy.insurance.data_documents'),
          where: tx('privacy.insurance.data_documents_where'),
        },
        {
          what: tx('privacy.insurance.data_letters'),
          where: tx('privacy.insurance.data_letters_where'),
        },
        {
          what: tx('privacy.mortgage.data_documents'),
          where: tx('privacy.mortgage.data_documents_where'),
        },
        {
          what: tx('privacy.mortgage.data_letters'),
          where: tx('privacy.mortgage.data_letters_where'),
        },
        {
          what: tx('privacy.bills.data_documents'),
          where: tx('privacy.bills.data_documents_where'),
        },
        {
          what: tx('privacy.bills.data_letters'),
          where: tx('privacy.bills.data_letters_where'),
        },
        {
          what: tx('privacy.data_pass'),
          where: `În spațiul de stocare local (localStorage) al browserului tău, și doar dacă le folosești: un contor semnat al citirilor tale gratuite din ziua respectivă („${STORAGE_KEYS.quota}”); dacă cumperi permisul (pase), permisul și citirile care îi mai rămân („${STORAGE_KEYS.pass}”) și codul fiecărei plăți pe care o începi, cu un număr aleatoriu pe care îl cunoaște doar browserul tău, ca să poți recupera permisul („${STORAGE_KEYS.checkout}”; fiecare plată se elimină după 7 zile dacă nu a fost finalizată sau când îi expiră permisul). Nu conțin numele tău și nimic din documentele tale și ies de pe dispozitivul tău doar la următoarea citire, pentru a recupera permisul sau pentru a-l verifica înainte să îți arate calculul detaliat al verificării tale, raportul sau scrisoarea. Le primește serverul eslojusto.es din AWS, care întreabă Stripe despre plată. Permisul expirat și contorul dintr-o zi anterioară se șterg singure data următoare când pagina le consultă, iar totul se șterge când ștergi datele acestui site din browserul tău; de aceea permisul este valabil doar în acest browser și se pierde pe alt dispozitiv, într-o fereastră privată sau când le ștergi. Dacă citirea nu este disponibilă, fila reține acest lucru timp de o oră în spațiul ei de stocare a sesiunii („${OUTAGE_KEY}”, doar cu ora), ca să nu ți-o ofere între timp.`,
        },
        {
          what: tx('privacy.data_checkout'),
          where: `Dacă plătești, răspunsurile din verificarea ta se păstrează în spațiul de stocare a sesiunii (sessionStorage) al acelei file cât timp ești pe pagina de plată, ca să îți fie arătat rezultatul când te întorci. La facturile la electricitate se păstrează astfel răspunsurile pentru fiecare factură din anul tău pe care ai verificat-o deja, fără amprenta codului punctului de consum. Nu ies de pe dispozitivul tău și se șterg când te întorci sau când închizi fila.`,
        },
      ]
    : []),
  {
    what: tx('privacy.data_theme'),
    where:
      'În spațiul de stocare local (localStorage) al browserului tău, și doar dacă apeși butonul temei. Nu iese niciodată de pe dispozitivul tău. Se șterge când ștergi datele acestui site din browserul tău.',
  },
  {
    what: tx('privacy.data_server'),
    where:
      'Site-ul este găzduit pe GitHub Pages. GitHub înregistrează adresa IP și datele tehnice ale fiecărei vizite, ca orice server web.',
  },
];

// The allowlist (src/analytics/sanitize.ts) and the event catalogue (src/analytics/events.ts), in
// plain words. Keep all three in step: the analytics e2e asserts the exact keys.
const tracked = [
  {
    when: 'La fiecare eveniment',
    what: 'Data și ora fiecărui eveniment și un număr aleatoriu care există doar cât timp pagina este deschisă. Adresa paginii fără parametri: domeniul, calea și pasul la care te afli. Browserul tău și versiunea lui, și sistemul tău (Windows, Android…). Tipul de dispozitiv (computer, telefon mobil sau tabletă) și dimensiunea ferestrei. Domeniul site-ului de pe care vii (de exemplu „www.google.com”), fără adresa completă. Dacă ajungi de pe un link de campanie, sursa, mediul și numele ei (utm_source, utm_medium, utm_campaign), doar când sunt un cod scurt din litere, cifre și cratime. Și trei date tehnice ale PostHog: cheia proiectului eslojusto.es, versiunea codului său și un indicator care îi cere să nu creeze niciun profil.',
  },
  {
    when: 'Când deschizi o pagină',
    what: 'Faptul că ai deschis-o și limba principală a browserului tău, doar partea generală: „ja”, nu „ja-JP”.',
  },
  {
    when: 'Când părăsești o pagină',
    what: 'Cât timp ai stat pe pagină și până unde ai derulat.',
  },
  {
    when: 'Dacă folosești traducătorul browserului',
    what: 'Limba în care traduci pagina, de exemplu „ar”.',
  },
  {
    when: 'La fiecare pas al verificării',
    what: 'Faptul că îl deschizi și, când îl termini, cât timp ți-a luat, pe un interval larg: sub 10 secunde, de la 10 la 30, de la 30 la 60, de la 60 la 180 sau peste 180. Dacă te întorci înapoi, de la ce pas la care.',
  },
  {
    when: 'Dacă o informație nu este acceptată',
    what: 'Numele câmpului, de exemplu „data plecării”. Niciodată ce ai scris în el.',
  },
  {
    when: 'Dacă deschizi un ajutor',
    what: 'Ce întrebare frecventă deschizi sau la ce componentă te uiți la „Cum se calculează”.',
  },
  {
    when: 'Când verifici',
    what: 'Motivul încetării contractului, tipul contractului pe durată determinată, cum primești plățile suplimentare (pagas extra) și dacă îți socotești concediul în zile lucrătoare sau calendaristice și, dacă sunt lucrătoare, dacă lucrezi 5, 6 sau alt număr de zile pe săptămână, așa cum le alegi în opțiuni. Câte componente au cifra din lichidarea ta finală și câte ies sub minimul legal, coincid cu el, îl depășesc sau nu pot fi verificate. Dacă ți se reține pentru preaviz mai mult decât maximul. Dacă se arată cât s-ar plăti la o concediere nejustificată (improcedente), fără cifră. Dacă rezultatul apare ca rezumat sau cu calculul detaliat al permisului. Dacă diferența este zero, sub 100 €, între 100 și 500 €, între 500 și 2.000 € sau mai mare. De câte ori ai făcut verificarea pe această pagină, cât timp ți-a luat, pe intervale, și, dacă verifici din nou, numele câmpurilor pe care le-ai schimbat. Despre șomaj, doar dacă estimarea nu se aplică motivului tău, dacă are cifre sau apare fără ele și câte alte contracte ai adăugat, pe un interval: 0, 1, 2 sau 3 ori mai multe. Niciodată câți copii ai în întreținere și nicio dată a acelor contracte. Despre ERTE (șomaj tehnic temporar) și despre dacă ți s-a plătit, doar numele întrebării dacă o schimbi, niciodată răspunsul. Ce bifezi despre o posibilă concediere nulă (sarcină, concedii speciale (permisos), concediu medical…) nu se trimite niciodată, nici chiar dacă ai bifat ceva.',
  },
  {
    when: 'Când apeși „Ia-o de la capăt”',
    what: 'Faptul că l-ai apăsat.',
  },
  {
    when: tx('privacy.rental.tracked_sheets'),
    what: tx('privacy.rental.tracked_sheets_what'),
  },
  {
    when: tx('privacy.rental.tracked_scope'),
    what: tx('privacy.rental.tracked_scope_what'),
  },
  {
    when: tx('privacy.rental.tracked_review'),
    what: tx('privacy.rental.tracked_review_what'),
  },
  {
    when: tx('privacy.employment.tracked_sheets'),
    what: tx('privacy.employment.tracked_sheets_what'),
  },
  {
    when: tx('privacy.employment.tracked_scope'),
    what: tx('privacy.employment.tracked_scope_what'),
  },
  {
    when: tx('privacy.employment.tracked_review'),
    what: tx('privacy.employment.tracked_review_what'),
  },
  {
    when: tx('privacy.household.tracked_sheets'),
    what: tx('privacy.household.tracked_sheets_what'),
  },
  {
    when: tx('privacy.household.tracked_scope'),
    what: tx('privacy.household.tracked_scope_what'),
  },
  {
    when: tx('privacy.household.tracked_review'),
    what: tx('privacy.household.tracked_review_what'),
  },
  {
    when: tx('privacy.credit.tracked_sheets'),
    what: tx('privacy.credit.tracked_sheets_what'),
  },
  {
    when: tx('privacy.credit.tracked_scope'),
    what: tx('privacy.credit.tracked_scope_what'),
  },
  {
    when: tx('privacy.credit.tracked_review'),
    what: tx('privacy.credit.tracked_review_what'),
  },
  {
    when: tx('privacy.insurance.tracked_sheets'),
    what: tx('privacy.insurance.tracked_sheets_what'),
  },
  {
    when: tx('privacy.insurance.tracked_scope'),
    what: tx('privacy.insurance.tracked_scope_what'),
  },
  {
    when: tx('privacy.insurance.tracked_review'),
    what: tx('privacy.insurance.tracked_review_what'),
  },
  {
    when: tx('privacy.mortgage.tracked_sheets'),
    what: tx('privacy.mortgage.tracked_sheets_what'),
  },
  {
    when: tx('privacy.mortgage.tracked_scope'),
    what: tx('privacy.mortgage.tracked_scope_what'),
  },
  {
    when: tx('privacy.mortgage.tracked_review'),
    what: tx('privacy.mortgage.tracked_review_what'),
