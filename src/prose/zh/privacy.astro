// The allowlist (src/analytics/sanitize.ts) and the event catalogue (src/analytics/events.ts), in
// plain words. Keep all three in step: the analytics e2e asserts the exact keys.
const tracked = [
  {
    when: '每个统计事件',
    what: '每个统计事件的日期和时间，以及一个只在页面打开期间存在的随机数。不带参数的页面地址：域名、路径和您所在的页。您的浏览器及其版本，以及您的系统（Windows、Android…）。设备类型（电脑、手机或平板）和窗口大小。您来自的网站的域名（例如«www.google.com»），不含完整地址。如果您通过推广链接进入，统计其来源、媒介和名称（utm_source、utm_medium、utm_campaign），仅当它们是由字母、数字和连字符组成的简短代码时。还有 PostHog 的三项技术数据：eslojusto.es 项目的密钥、其代码的版本，以及一个要求它不创建任何用户档案的标记。',
  },
  {
    when: '打开页面时',
    what: '您打开了该页面，以及您浏览器的主要语言，只统计其通用部分：«ja»，而不是«ja-JP»。',
  },
  {
    when: '离开页面时',
    what: '您在页面上停留了多长时间，以及您向下滚动到了哪里。',
  },
  {
    when: '如果您使用浏览器的翻译功能',
    what: '您将页面翻译成的语言，例如«ar»。',
  },
  {
    when: '核查的每一页',
    what: '您打开了该页；完成该页时，统计您用了多长时间，按较宽的区间：少于10秒、10至30秒、30至60秒、60至180秒，或超过180秒。如果您返回上一步，统计是从哪一页回到哪一页。',
  },
  {
    when: '如果某个数据未被接受',
    what: '字段的名称，例如“离职日期”。绝不包括您在其中填写的内容。',
  },
  {
    when: '如果您打开帮助',
    what: '您打开了哪个常见问题，或者您查看了哪一项的“计算方法”。',
  },
  {
    when: '核查时',
    what: '合同终止的原因、定期合同的类型、您领取额外工资（pagas extra）的方式、您的年假按排班工作日（laborables）还是自然日（naturales）计算，如果按排班工作日计算，您每周工作5天、6天还是其他天数，均按您在选项中的选择统计。有多少项填入了您离职结算中的数字，以及有多少项低于、等于、高于法定标准或无法核查。扣除的提前通知期是否超过上限。是否显示了不当解雇（improcedente）需支付的金额（不含数字）。结果显示为概要还是通行证的详细内容。本次访问是先逐项显示核对过程还是直接显示结果：随机决定，两种方式各占一半访问，且不会保存。差额是零、低于100 €、100至500 €、500至2.000 €，还是更高。您在本页面核查了几次、按区间计的用时，以及如果您再次核查，您修改过的字段名称。关于失业金（paro），只统计该估算是否不适用于您的原因、是否给出了数字，以及您添加了多少份其他合同，按区间统计：0、1、2，或3及以上。绝不包括您需要抚养的子女人数，也不包括这些合同的任何日期。关于 ERTE 以及是否已向您付款，如果您修改了答案，只统计问题的名称，绝不统计答案。您就可能的无效解雇（nulo）所勾选的内容（怀孕、各类假期、病假…）绝不会发送，即使您勾选了某一项也不会。',
  },
  {
    when: '点击“重新开始”时',
    what: '您点击了该按钮。',
  },
  {
    when: tx('privacy.rental.tracked_sheets'),
    what: tx('privacy.rental.tracked_sheets_what'),
  },
  {
