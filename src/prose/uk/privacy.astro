// source: 09f730db2222
import { t, type Key } from '../../i18n';
import { link, type Lang } from '../../i18n/languages';
import { DOCUMENTS } from '../../documents/config';
import { OUTAGE_KEY } from '../../documents/outage';
import { STORAGE_KEYS } from '../../documents/pass';
import {
  BILLS_BUILD,
  CREDIT_BUILD,
  EMPLOYMENT_BUILD,
  HOUSEHOLD_BUILD,
  INSURANCE_BUILD,
  MORTGAGE_BUILD,
  RENTAL_BUILD,
} from '../../content/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tx = (key: Key) => t(lang, key);

const email = 'hola@eslojusto.es';
// Reading documents and the pass exist only in a build with their API; so do their paragraphs.
const documents = DOCUMENTS !== null;
// The rental review exists only in a PUBLIC_RENTAL=1 build; so do the paragraphs about it.
const rental = RENTAL_BUILD;
// The contract review exists only in a PUBLIC_EMPLOYMENT=1 build; so do the paragraphs about it.
const employment = EMPLOYMENT_BUILD;
// The household review exists only in a PUBLIC_HOUSEHOLD=1 build; so do the paragraphs about it.
const household = HOUSEHOLD_BUILD;
// The credit and insurance reviews exist only in a PUBLIC_CREDIT=1 or PUBLIC_INSURANCE=1 build; so
// do the paragraphs about each.
const credit = CREDIT_BUILD;
const insurance = INSURANCE_BUILD;
// The mortgage review exists only in a PUBLIC_MORTGAGE=1 build; so do the paragraphs about it.
const mortgage = MORTGAGE_BUILD;
// The bills reviews exist only in a PUBLIC_BILLS=1 build; so do the paragraphs about them.
const bills = BILLS_BUILD;

// One entry per thing that is stored or processed; a new tool adds a row here.
const stored = [
  {
    what: tx('privacy.data_review'),
    where:
      'Лише у вашому браузері, поки сторінка відкрита. Розрахунок виконується на вашому пристрої: ваші дати, ваша зарплата, суми вашого остаточного розрахунку, ваші діти на утриманні та ваші інші договори не надсилаються на жоден сервер і не зберігаються. Коли ви закриваєте або перезавантажуєте сторінку, вони зникають.',
  },
  ...(rental
    ? [{ what: tx('privacy.rental.data_review'), where: tx('privacy.rental.data_review_where') }]
    : []),
  ...(employment
    ? [
        {
          what: tx('privacy.employment.data_review'),
          where: tx('privacy.employment.data_review_where'),
        },
      ]
    : []),
  ...(household
    ? [
        {
          what: tx('privacy.household.data_review'),
          where: tx('privacy.household.data_review_where'),
        },
      ]
    : []),
  ...(credit
    ? [{ what: tx('privacy.credit.data_review'), where: tx('privacy.credit.data_review_where') }]
    : []),
  ...(insurance
    ? [
        {
          what: tx('privacy.insurance.data_review'),
          where: tx('privacy.insurance.data_review_where'),
        },
      ]
    : []),
  ...(mortgage
    ? [
        {
          what: tx('privacy.mortgage.data_review'),
          where: tx('privacy.mortgage.data_review_where'),
        },
      ]
    : []),
  ...(bills
    ? [
        { what: tx('privacy.bills.data_review'), where: tx('privacy.bills.data_review_where') },
        ...(documents
          ? [{ what: tx('privacy.bills.data_year'), where: tx('privacy.bills.data_year_where') }]
          : []),
      ]
    : []),
  {
    what: tx('privacy.data_analytics'),
    where:
      'Кілька коротких сигналів із кодами і діапазонами, які надсилаються до PostHog, поки ви користуєтеся сторінкою (подробиці нижче). Ідентифікатор переглянутої сторінки існує лише в її пам’яті: він не записується на ваш пристрій і втрачається, коли ви її закриваєте або перезавантажуєте.',
  },
  ...(documents
    ? [
        {
          what: tx('privacy.data_documents'),
          where:
            'Лише якщо ви вирішите завантажити свої документи (лист про звільнення, остаточний розрахунок, ваші розрахункові листи, довідку від роботодавця (certificado de empresa), угоду чи протокол примирення або виписку про трудовий стаж (vida laboral)) і дасте згоду. PDF перетворюються на зображення своїх сторінок у вашому браузері, не залишаючи його, і перш ніж щось надіслати, сторінка перевіряє, також у вашому браузері, чи не виглядає якесь фото темним, розмитим або замалим. Ці зображення і фото передаються в зашифрованому вигляді на сервер eslojusto.es в Amazon Web Services, в Іспанії (регіон eu-south-2), який передає їх моделі ШІ (Claude від Anthropic) через Amazon Bedrock, у межах Європейського Союзу. Модель визначає, який документ на кожній сторінці, копіює дані, яких потребує форма, і зчитане повертається у ваш браузер. Нічого не зберігається: документи існують лише в пам’яті сервера під час зчитування, а його журнали, які зберігаються 14 днів, містять лише технічні дані: результат, кількість сторінок, скільки часу це зайняло, скільки тексту обробила модель і кілька службових позначок, як-от чи знадобилося повторне зчитування, скільки значень не збігалися між документами (без зазначення, яких саме, і їхніх значень) або скільки сторінок не вдалося зчитати і чому (наприклад, розмита або з іншої країни). Ніколи не вміст і нічого, що вас ідентифікує.',
        },
        ...(rental
          ? [
              {
                what: tx('privacy.rental.data_documents'),
                where: tx('privacy.rental.data_documents_where'),
              },
              {
                what: tx('privacy.rental.data_letters'),
                where: tx('privacy.rental.data_letters_where'),
              },
            ]
          : []),
        ...(employment
          ? [
              {
                what: tx('privacy.employment.data_documents'),
                where: tx('privacy.employment.data_documents_where'),
              },
              {
                what: tx('privacy.employment.data_letters'),
                where: tx('privacy.employment.data_letters_where'),
              },
            ]
          : []),
        ...(credit
          ? [
              {
                what: tx('privacy.credit.data_documents'),
                where: tx('privacy.credit.data_documents_where'),
              },
              {
                what: tx('privacy.credit.data_letters'),
                where: tx('privacy.credit.data_letters_where'),
              },
            ]
          : []),
        ...(insurance
          ? [
              {
                what: tx('privacy.insurance.data_documents'),
                where: tx('privacy.insurance.data_documents_where'),
              },
              {
                what: tx('privacy.insurance.data_letters'),
                where: tx('privacy.insurance.data_letters_where'),
              },
            ]
          : []),
        ...(mortgage
          ? [
              {
                what: tx('privacy.mortgage.data_documents'),
                where: tx('privacy.mortgage.data_documents_where'),
              },
              {
                what: tx('privacy.mortgage.data_letters'),
                where: tx('privacy.mortgage.data_letters_where'),
              },
            ]
          : []),
        ...(bills
          ? [
              {
                what: tx('privacy.bills.data_documents'),
                where: tx('privacy.bills.data_documents_where'),
              },
              {
                what: tx('privacy.bills.data_letters'),
                where: tx('privacy.bills.data_letters_where'),
              },
            ]
          : []),
        {
          what: tx('privacy.data_pass'),
          where: `У локальному сховищі (localStorage) вашого браузера, і лише якщо ви ними користуєтеся: підписаний лічильник ваших безкоштовних зчитувань за день («${STORAGE_KEYS.quota}»); якщо ви купуєте абонемент, — абонемент і зчитування, що в ньому залишилися («${STORAGE_KEYS.pass}»), і код кожної оплати, яку ви розпочинаєте, з випадковим числом, яке знає лише ваш браузер, щоб можна було відновити абонемент («${STORAGE_KEYS.checkout}»; кожна оплата видаляється через 7 днів, якщо її не завершено, або коли спливає строк її абонемента). Вони не містять ні вашого імені, ні нічого з ваших документів і залишають ваш пристрій лише з наступним зчитуванням, щоб відновити абонемент або перевірити його, перш ніж показати вам деталі вашої перевірки, звіт або лист. Їх отримує сервер eslojusto.es в AWS, який запитує в Stripe про оплату. Абонемент, строк якого сплив, і лічильник попереднього дня видаляються самі наступного разу, коли сторінка до них звертається, а все видаляється, коли ви видаляєте дані цього сайту у своєму браузері; тому абонемент діє лише в цьому браузері і втрачається на іншому пристрої, у приватному вікні або коли ви їх видаляєте. Якщо зчитування недоступне, вкладка пам’ятає це протягом години у своєму сховищі сеансу («${OUTAGE_KEY}», лише з часом), щоб тим часом не пропонувати його вам.`,
        },
        {
          what: tx('privacy.data_checkout'),
          where: `Якщо ви платите, відповіді вашої перевірки зберігаються у сховищі сеансу (sessionStorage) цієї вкладки, поки ви на сторінці оплати, щоб показати вам результат, коли ви повернетеся.${bills ? ' Для рахунків за електроенергію так само зберігаються відповіді щодо кожного рахунку вашого року, який ви вже перевірили, без відбитка коду точки постачання.' : ''} Вони не залишають вашого пристрою і видаляються, коли ви повертаєтеся або закриваєте вкладку.`,
        },
      ]
    : []),
  {
    what: tx('privacy.data_theme'),
    where:
      'У локальному сховищі (localStorage) вашого браузера, і лише якщо ви натискаєте кнопку теми. Він ніколи не залишає вашого пристрою. Він видаляється, коли ви видаляєте дані цього сайту у своєму браузері.',
  },
  {
    what: tx('privacy.data_server'),
    where:
      'Сайт розміщено на GitHub Pages. GitHub записує IP-адресу і технічні дані кожного відвідування, як будь-який вебсервер.',
  },
];

// The allowlist (src/analytics/sanitize.ts) and the event catalogue (src/analytics/events.ts), in
// plain words. Keep all three in step: the analytics e2e asserts the exact keys.
const tracked = [
  {
    when: 'З кожним сигналом',
    what: 'Дата і час кожного сигналу і випадкове число, яке існує лише поки сторінка відкрита. Адреса сторінки без параметрів: домен, шлях і картка, на якій ви перебуваєте. Ваш браузер і його версія, і ваша система (Windows, Android…). Тип пристрою (комп’ютер, мобільний телефон чи планшет) і розмір вікна. Домен сайту, з якого ви прийшли (наприклад, «www.google.com»), без повної адреси. Якщо ви прийшли за посиланням рекламної кампанії, — її джерело, канал і назва (utm_source, utm_medium, utm_campaign), лише коли це короткий код із літер, цифр і дефісів. І три технічні дані PostHog: ключ проєкту eslojusto.es, версія його коду і позначка, яка просить його не створювати жодного профілю.',
  },
  {
    when: 'Коли ви відкриваєте сторінку',
    what: 'Те, що ви її відкрили, і основна мова вашого браузера, лише загальна частина: «ja», а не «ja-JP».',
  },
  {
    when: 'Коли ви залишаєте сторінку',
    what: 'Скільки часу ви провели на сторінці і докуди її прокрутили.',
  },
  {
    when: 'Якщо ви користуєтеся перекладачем браузера',
    what: 'Мова, на яку ви перекладаєте сторінку, наприклад «ar».',
  },
  {
    when: 'На кожній картці перевірки',
    what: 'Те, що ви її відкриваєте, і, коли ви її завершуєте, скільки часу це зайняло, у широкому діапазоні: менше 10 секунд, від 10 до 30, від 30 до 60, від 60 до 180 або понад 180. Якщо ви повертаєтеся назад, — з якої картки на яку.',
  },
  {
    when: 'Якщо значення не приймається',
    what: 'Назва поля, наприклад «дата звільнення». Ніколи не те, що ви в ньому ввели.',
  },
  {
    when: 'Якщо ви відкриваєте довідку',
    what: 'Яке поширене запитання ви відкриваєте або для якої позиції дивитеся «Як розраховується».',
  },
  {
    when: 'Під час перевірки',
    what: 'Підстава припинення договору, тип строкового договору, як ви отримуєте додаткові виплати (pagas extra) і чи рахуєте ви відпустку в робочих днях за графіком (laborables) чи в календарних днях (naturales), а якщо в робочих — чи працюєте ви 5, 6 чи іншу кількість днів на тиждень, так, як ви обираєте це у варіантах. Скільки позицій містять суму з вашого остаточного розрахунку і скільки з них виходять нижчими, збігаються, вищими або не піддаються перевірці. Чи утримують з вас за попередження більше за максимум. Чи показано, скільки коштувало б необґрунтоване звільнення, без суми. Чи результат показано коротко чи з деталями абонемента. Чи різниця дорівнює нулю, менша за 100 €, від 100 до 500 €, від 500 до 2.000 € чи більша. Скільки разів ви виконали перевірку на цій сторінці, скільки часу це зайняло, у діапазонах, і, якщо ви перевіряєте ще раз, назви полів, які ви змінили. Щодо допомоги по безробіттю — лише те, чи оцінка не застосовується до вашої підстави, чи вона містить суми або виходить без них, і скільки інших договорів ви додали, у діапазоні: 0, 1, 2 або 3 і більше. Ніколи — скільки у вас дітей на утриманні, і жодної дати цих договорів. Щодо ERTE і того, чи вам заплатили, — лише назва запитання, якщо ви змінюєте відповідь, ніколи сама відповідь. Те, що ви позначаєте щодо можливого недійсного звільнення (nulo) (вагітність, відпустки, лікарняний…), не надсилається ніколи, навіть якщо ви щось позначили.',
  },
  {
    when: 'Коли ви натискаєте «Почати спочатку»',
    what: 'Те, що ви натиснули цю кнопку.',
  },
  ...(rental
    ? [
        {
          when: tx('privacy.rental.tracked_sheets'),
          what: tx('privacy.rental.tracked_sheets_what'),
        },
        {
          when: tx('privacy.rental.tracked_scope'),
          what: tx('privacy.rental.tracked_scope_what'),
        },
        {
          when: tx('privacy.rental.tracked_review'),
          what: tx('privacy.rental.tracked_review_what'),
        },
      ]
    : []),
  ...(employment
    ? [
        {
          when: tx('privacy.employment.tracked_sheets'),
          what: tx('privacy.employment.tracked_sheets_what'),
        },
        {
          when: tx('privacy.employment.tracked_scope'),
          what: tx('privacy.employment.tracked_scope_what'),
        },
        {
          when: tx('privacy.employment.tracked_review'),
          what: tx('privacy.employment.tracked_review_what'),
        },
      ]
    : []),
  ...(household
    ? [
        {
          when: tx('privacy.household.tracked_sheets'),
