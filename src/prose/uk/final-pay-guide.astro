---
// source: 169eec130c4d
import FigureTable from '../../components/FigureTable.astro';
import CaseLink from '../../components/CaseLink.astro';
import { faqEntries } from '../../content/faq';
import { bySeniority } from '../../content/examples';
import { wholeEuroRange, wholeEuros } from '../../content/format';
import { LANDINGS, type LandingId } from '../../content/landings';
import { ET, SOURCES, LGSS } from '../../engine/sources';
import { DOCUMENTS } from '../../documents/config';
import { t, type Key } from '../../i18n';
import { link, type Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Reading documents and the pass exist only in a build with their API; so do their paragraphs.
const documents = DOCUMENTS !== null;
const tx = (key: Key) => t(lang, key);

// The guide under the calculator of /finiquito/, in Spanish: headings and labels from the
// dictionary, the prose, the rules and the worked examples here. Another language's guide is a
// translated copy of this file in src/prose/<lang>/.
const causes: { title: string; rule: string; citation: string; page?: LandingId }[] = [
  {
    title: tx('guide.unfair_dismissal'),
    rule: '33 дні за кожен відпрацьований рік, не більше 24 місячних зарплат (720 днів).',
    citation: 'Art. 56 ET',
    page: 'unfair_dismissal',
  },
  {
    title: tx('guide.objective_dismissal'),
    rule: '20 днів за рік, не більше 12 місячних зарплат (360 днів, STS 651/2026, рішення Верховного суду Іспанії). Крім того, 15 днів попередження, а дні, яких роботодавець не надасть, оплачуються.',
    citation: 'Art. 53 ET',
    page: 'objective_dismissal',
  },
  {
    title: tx('guide.collective_dismissal'),
    rule: 'Щонайменше те саме, що й при звільненні з об’єктивних причин: 20 днів за рік, не більше 12 місячних зарплат, і 15 днів попередження. Угода в межах ERE може передбачати більше; перевірка її не знає і показує мінімум.',
    citation: 'Art. 51.2, 51.4 і 53.1 ET',
  },
  {
    title: tx('guide.fixed_term_end'),
    rule: '12 днів за рік, пропорційно до відпрацьованих днів. Якщо договір почався у 2011 році або раніше — 8 днів; у 2012 — 9; у 2013 — 10; у 2014 — 11. Договори заміщення (sustitución) і навчальні (formativos) права на вихідну допомогу не дають, як і договори, підписані до 4 березня 2001 р. Якщо договір тривав понад рік — 15 днів попередження.',
    citation: 'Art. 49.1.c ET і DT 8.ª',
    page: 'fixed_term_end',
  },
  {
    title: tx('guide.resignation'),
    rule: 'Без вихідної допомоги. Якщо ваш колективний договір визначає строк попередження, а ви його не дотримаєтеся, роботодавець може утримати дні, яких бракує.',
    citation: 'Art. 49.1.d ET',
    page: 'resignation',
  },
  {
    title: tx('guide.disciplinary_dismissal'),
    rule: 'Без вихідної допомоги, якщо звільнення визнано обґрунтованим (procedente). Якщо його визнано необґрунтованим (improcedente), допомога розраховується як при необґрунтованому звільненні.',
    citation: 'Art. 55.7 і 56 ET',
  },
];

const unchecked = [
  'Сума нетто: утримання IRPF (податок на доходи фізичних осіб) і внески.',
  'Надбавки, доплати, понаднормові години і комісійні за вашим колективним договором або трудовим договором.',
  'Додаткові виплати понад дві звичайні.',
  'Чи обґрунтована підстава звільнення: це вирішує суд.',
  'Зарплата за час розгляду справи (salarios de tramitación).',
  'Те, що угода в межах ERE додає понад законний мінімум.',
];

// The case pages, in the order of the map: the finiquito ones, then the pages on the benefit.
const caseLinks: readonly LandingId[] = [
  'resignation',
  'unfair_dismissal',
  'objective_dismissal',
  'fixed_term_end',
  'not_agreed',
];

// The same report the result links to.
const workHistoryUrl =
  'https://sede.seg-social.gob.es/wps/portal/sede/sede/Ciudadanos/Informes+y+Certificados/201864';
const benefitSources = [
  SOURCES.lgss267,
  SOURCES.lgss268,
  SOURCES.lgss269,
  SOURCES.lgss270,
  SOURCES.sepeAmounts,
].map(({ citation, url, inForceSince, effectiveFrom }) => ({
  citation,
  url,
  inForce: t(lang, effectiveFrom ? 'client.source.effective_from' : 'client.source.in_force', {
    fecha: inForceSince.split('-').reverse().join('-'),
  }),
}));
---

<article class="guide" data-tone="legal" aria-labelledby="guide-title">
  <header class="guide__head">
    <h2 class="guide__title" id="guide-title">
      {tx('guide.title')}
    </h2>
    <p class="guide__lead">
      Що входить в остаточний розрахунок і звідки береться кожна сума, з відповідною статтею. У
      прикладах — зарплата 1.500&nbsp;€ брутто на місяць і дві додаткові виплати по 1.500&nbsp;€,
      разом 21.000&nbsp;€ на рік.
    </p>
    <p class="guide__sources">
      <span>{tx('guide.updated')}</span>
      <span>
        {tx('guide.sources')}: <a href={ET}>{tx('guide.source_et')}</a> ·{' '}
        <a href={SOURCES.cgpjGuide.url}>{tx('guide.source_cgpj')}</a> ·{' '}
        <a href={LGSS}>{tx('guide.source_lgss')}</a> ·{' '}
        <a href={SOURCES.sepeAmounts.url}>{tx('guide.source_sepe')}</a>
      </span>
      <a href={link(lang, 'aviso-legal/')}>{tx('guide.who')}</a>
    </p>
  </header>

  <div class="guide__sheets">
    <section class="sheet sheet--text">
      <h3 id="g-que-lleva">{tx('guide.what_it_includes')}</h3>
      <p>
        Коли ваш договір закінчується, роботодавець передає вам проєкт розрахункового документа
        (documento de liquidación) із сумами, які вам належать (art. 49.2 ET). Це і є остаточний
        розрахунок (finiquito), і до нього входить те, що ви вже заробили, але ще не отримали:
      </p>
      <ul>
        <li>Зарплата за відпрацьовані дні останнього місяця (art. 26 ET).</li>
        <li>Нарахована і не використана відпустка (art. 38 ET).</li>
        <li>
          Нарахована частина додаткових виплат (pagas extra), якщо вони не розподілені по щомісячних
          розрахункових листах (art. 31 ET).
        </li>
        <li>Дні попередження, яких роботодавець не надав, коли закон його вимагає.</li>
      </ul>
      <p>
        Якщо договір закінчується з правом на вихідну допомогу (indemnización), розрахунковий
        документ може включати і її, але юридично це окрема сума, а не остаточний розрахунок, зі
        своїми правилами і строками. Усі суми брутто, до утримання податку і внесків.
      </p>
      <p class="folio">
        Art. <span>49.2</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-diferencia">{tx('guide.difference')}</h3>
      <p>
        Остаточний розрахунок належить вам щоразу, коли закінчується договір, навіть якщо йдете ви
        самі, бо це гроші, які ви вже заробили. Вихідна допомога компенсує закінчення договору і
        залежить від підстави.
      </p>
      <p>
        Якщо розірвати договір з власної ініціативи (dimisión), права на вихідну допомогу немає
        (art. 49.1.d ET). Дисциплінарне звільнення, визнане обґрунтованим (procedente), його теж не
        дає (art. 55.7 ET); якщо звільнення визнано необґрунтованим, допомога розраховується як при
        необґрунтованому звільненні.
      </p>
      <p class="folio">
        Art. <span>49 · 55.7</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-casos">{tx('guide.cases')}</h3>
      <p>Кожна підстава має свої правила. Ми пояснюємо їх на розібраному прикладі:</p>
      <ul>
        {caseLinks.map((id) => (
          <li>
            <CaseLink lang={lang} id={id} />
          </li>
        ))}
      </ul>
      <p>
        А для допомоги по безробіттю є окрема сторінка: <CaseLink lang={lang} id="benefit" />.
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-salario">{tx('guide.salary')}</h3>
      <p>
        Враховуються відпрацьовані дні місяця, в якому закінчується договір. День може коштувати
        вашу місячну зарплату, поділену на 30 (розрахунковий місяць), або на кількість днів цього
        місяця (календарний місяць). Перевірка показує діапазон між двома розрахунками.
      </p>
      <p class="example">
        <span class="example__label">{tx('guide.example')}</span> Звільнення 15 жовтня: 1.500&nbsp;€
        × 15/30 = 750,00&nbsp;€ або 1.500&nbsp;€ × 15/31 = 725,81&nbsp;€.
      </p>
      <p class="folio">
        Art. <span>26</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-vacaciones">{tx('guide.holidays')}</h3>
      <p>
        Це щонайменше тридцять календарних днів на рік (art. 38.1 ET). Перевірка вважає їх рівними
        22 робочим дням за графіком з понеділка по п’ятницю, 26 — з понеділка по суботу і 30 × дні /
        7 за іншого тижневого графіка: це еквіваленти, а не текст закону. Ваш колективний договір
        або трудовий договір можуть давати більше. Відпустка нараховується з кожним відпрацьованим
        днем, і до остаточного розрахунку входить невикористана відпустка цього року. Багато
        роботодавців рахують її за місяцями (2,5 дня на місяць при 30 днях на рік), а не за днями, і
        перевірка показує діапазон між двома розрахунками. Кожен день оплачується в межах від вашої
        місячної зарплати / 30 до вашої річної зарплати / 365.
      </p>
      <p class="example">
        <span class="example__label">{tx('guide.example')}</span> Звільнення 15 жовтня 2026 р.: 288
        відпрацьованих днів у році. 30 × 288/365 = 23,67 дня нарахованої відпустки. Якщо ви
        використали 15, залишається близько 8,67 дня: від (30 × 288/365 − 15) × 1.500&nbsp;€/30 =
        433,56&nbsp;€ до (30 × 288/365 − 15) × 21.000&nbsp;€/365 = 498,89&nbsp;€.
      </p>
      <p>
        Якщо ви використали більше днів, ніж нараховано, чи можливе утримання, залежить від
        колективного договору.
      </p>
      <p class="folio">
        Art. <span>38</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-pagas">{tx('guide.extra_pay')}</h3>
      <p>
        Закон передбачає дві додаткові виплати на рік, а колективний договір — їхній розмір і
        порядок нарахування. Якщо вони розподілені по ваших щомісячних розрахункових листах, ви вже
        отримували їх щомісяця. Якщо ні, до розрахунку входить частина, нарахована з початку їхнього
        періоду: піврічного (з січня по червень і з липня по грудень) або річного (з липня по
        червень для літньої, з січня по грудень для різдвяної). Рахувати можна за днями або за
        місяцями, і перевірка показує діапазон між двома розрахунками. Якщо ви йдете в місяць, коли
        виплачується одна з них (червень або липень для літньої, грудень для різдвяної), вона може
        вже бути в розрахунковому листі за цей місяць.
      </p>
      <p class="example">
        <span class="example__label">{tx('guide.example')}</span> Різдвяна додаткова виплата
        1.500&nbsp;€ з піврічним періодом і звільнення 15 жовтня: з 1 липня до 15 жовтня минуло 107
        із 184 днів. 1.500&nbsp;€ × 107/184 = 872,28&nbsp;€.
      </p>
      <p class="folio">
        Art. <span>31</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-indemnizacion">{tx('guide.severance')}</h3>
      <p>
        Вона рахується в днях зарплати. Денна зарплата — це ваша річна зарплата разом із додатковими
        виплатами, поділена на 365, як у посібнику CGPJ. У прикладі 21.000&nbsp;€ / 365 ≈
        57,53&nbsp;€. Приклади множать на точне значення, без округлення. При звільненнях
        відпрацьований час рахується в місяцях, і неповний місяць рахується як повний. Якщо вас
        звільняють під час ERTE (тимчасове призупинення або скорочення роботи), розрахунок ведеться
        з повної зарплати до ERTE.
      </p>
      <div class="causes">
        {causes.map(({ title, rule, citation, page }) => (
          <div>
            <h4>{page ? <a href={link(lang, LANDINGS[page].path.slice(1))}>{title}</a> : title}</h4>
            <p>{rule}</p>
            <p class="causes__citation">{citation}</p>
          </div>
        ))}
      </div>
      <p class="example">
        <span class="example__label">Необґрунтоване звільнення</span> з 3 травня 2018 р. до 20 липня
        2026 р.: 98 повних місяців і кілька днів, що рахуються як 99. 33 дні за рік — це 2,75 дня на
        місяць: 99 × 2,75 = 272,25 дня. 21.000&nbsp;€ × 272,25 / 365 = 15.663,70&nbsp;€.
      </p>
      <p class="example">
        <span class="example__label">Звільнення з об’єктивних причин</span> за тих самих дат: 99 ×
        20/12 = 165 днів. 21.000&nbsp;€ × 165 / 365 = 9.493,15&nbsp;€.
      </p>
      <p class="example">
        <span class="example__label">Закінчення строкового договору</span> тривалістю один рік, з 1
        жовтня 2025 р. до 30 вересня 2026 р.: 365 днів × 12/365 = 12 днів. 21.000&nbsp;€ × 12 / 365
        = 690,41&nbsp;€.
      </p>
      <p class="folio">
        Art. <span>49 · 51 · 53 · 56</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-2012">{tx('guide.before_2012')}</h3>
      <p>
        При необґрунтованому звільненні за договором, укладеним до 12 лютого 2012 р., вихідна
        допомога розраховується за двома періодами:
      </p>
      <ul>
        <li>До 11 лютого 2012 р.: 45 днів за рік (3,75 дня на місяць).</li>
        <li>З 12 лютого 2012 р.: 33 дні за рік (2,75 дня на місяць).</li>
      </ul>
      <p>
        Загальна сума обмежена 720 днями, хіба що перший період уже їх перевищує. Тоді рахується
        лише перший період, не більше 42 місячних зарплат (1.260 днів).
      </p>
      <p>
        Договори про сприяння безстроковому найму (fomento de la contratación indefinida), підписані
        до 12 лютого 2012 р., щодо вихідної допомоги з об’єктивних причин підлягають нормі, за якою
        їх підписали; при дисциплінарному звільненні допомога розраховується за цими двома періодами
        (пункт 3). Перевірка не розрізняє цей вид договору.
      </p>
      <p class="example">
        <span class="example__label">{tx('guide.example')}</span> З 1 березня 2010 р. до 15 вересня
        2026 р. Перший період: 24 місяці × 3,75 = 90 днів. Другий період: 176 місяців × 2,75 = 484
        дні. Разом: 574 дні. 21.000&nbsp;€ × 574 / 365 = 33.024,66&nbsp;€.
      </p>
      <p class="folio">
        Перехідне положення <span>11.ª</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-antiguedad">{tx('guide.by_seniority')}</h3>
      <p>
        Остаточний розрахунок — це те, що нараховано за рік і за останній місяць, тож після року
        роботи за договором він перестає зростати. Вихідна допомога, навпаки, зростає з кожним
        відпрацьованим місяцем і залежить від підстави.
      </p>
      <FigureTable id="g-antiguedad-tabla" label={tx('guide.by_seniority')}>
        <Fragment slot="caption">
          Договори, що закінчуються 30 вересня 2026 р., із зарплатою 1.500&nbsp;€ брутто на місяць,
          двома додатковими виплатами по 1.500&nbsp;€, що нараховуються щопівроку (літню вже
          виплачено), і 22 робочими днями відпустки за графіком на рік, жодного з яких не
          використано. Округлено до євро.
        </Fragment>
        <thead>
          <tr>
            <th scope="col">Відпрацьований час</th>
            <th scope="col">Остаточний розрахунок</th>
            <th scope="col">
              Строковий
              <span class="figures-note">12 днів</span>
            </th>
            <th scope="col">
              Об’єктивні причини
              <span class="figures-note">20 днів</span>
            </th>
            <th scope="col">
              Необґрунтоване
              <span class="figures-note">33 дні</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {bySeniority.map(({ label, finalPay, fixedTermLimit, fixedTerm, objective, unfair }) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{wholeEuroRange(finalPay)}</td>
              <td>
                {fixedTerm === null ? '—' : wholeEuros(fixedTerm)}
                {fixedTermLimit === 'sector_agreement' && <sup>1</sup>}
                {fixedTermLimit === 'over' && <sup>2</sup>}
              </td>
              <td>{wholeEuros(objective)}</td>
              <td>{wholeEuros(unfair)}</td>
            </tr>
          ))}
        </tbody>
      </FigureTable>
      <p>
        Остаточний розрахунок складається із зарплати за вересень, відпустки і нарахованої різдвяної
        додаткової виплати, з діапазоном між розрахунком за днями і за місяцями. Інші три стовпці —
        це вихідна допомога за кожною підставою, яка йде окремо: art. 49.1.c ET при закінченні
        строкового договору, arts. 52 і 53.1.b ET при звільненні з об’єктивних причин і art. 56 ET
        при необґрунтованому звільненні. Щоб отримати загальну суму, додайте її до остаточного
        розрахунку.
      </p>
      <p class="table-notes">
        <sup>1</sup> Договір через обставини виробництва (eventual) триває щонайбільше 6 місяців.
        Він досягає одного року, лише якщо цей строк збільшує ваш галузевий колективний договір
        (convenio sectorial) (art. 15.2 ET) або якщо це договір на виконання певної роботи чи
        послуги (obra o servicio), підписаний до 31 грудня 2021 р. (перехідне положення 3.ª Real
        Decreto-ley 32/2021).
      </p>
      <p class="table-notes">
        <sup>2</sup> Договір через обставини виробництва так довго не триває. Договір на виконання
        певної роботи чи послуги, підписаний до 31 грудня 2021 р., тривав щонайбільше 3 роки, або 4,
        якщо цей строк збільшував галузевий колективний договір (art. 15.1.a ET у попередній
        редакції і перехідне положення 3.ª Real Decreto-ley 32/2021), тож жоден такий договір із цим
        стажем не закінчується у вересні 2026 р. Строковий договір, що перевищує свою максимальну
        тривалість, може стати безстроковим (art. 15.4 ET), і тоді його закінчення було б
        звільненням.
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-propuesta">{tx('guide.proposal')}</h3>
      <p>
        Роботодавець передає проєкт розрахункового документа. Закон передбачає, що особа, яка
        працює, може підписати його в присутності когось із представників працівників.
      </p>
      <p>
        Дехто підписує з позначкою «отримав(-ла), не погоджуюся» (recibí no conforme), коли не
        згоден із якоюсь сумою. Ми розповідаємо про це лише для інформації. Що робити в кожній
        ситуації, може оцінити юрист із трудового права, graduado social (консультант із трудового
        права) або профспілка.
      </p>
      <p>
        Що змінюється, а що ні: <CaseLink lang={lang} id="not_agreed" />.
      </p>
      <p class="folio">
        Art. <span>49.2</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-plazos">{tx('guide.deadlines')}</h3>
      <p>
        Для таких сум, як невиплачена зарплата, відпустка, додаткові виплати чи вихідна допомога
        після закінчення строкового договору, строк становить один рік (art. 59.1 ET). Якщо
        роботодавець вам ще не заплатив, на те, що є зарплатою, нараховується пеня за прострочення
        (interés por mora) 10&nbsp;% на рік (art. 29.3 ET); на вихідну допомогу — ні.
      </p>
      <p>
        У разі звільнення (з об’єктивних причин, колективного, необґрунтованого чи дисциплінарного)
        строк, щоб його оскаржити, становить 20 робочих днів (hábiles) (art. 59.3 ET). Хто не згоден
        із вихідною допомогою при звільненні, зазвичай порушує це питання тим самим шляхом, у межах
        цих 20 днів.
      </p>
      <p>
        Строк короткий, і юрист із трудового права, graduado social або профспілка можуть сказати,
        який строк застосовується у вашій ситуації.
      </p>
      <p class="folio">
        Art. <span>29.3 · 59</span> ET
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-no-revisa">{tx('guide.unchecked')}</h3>
      <ul>
        {unchecked.map((text) => (
          <li>{text}</li>
        ))}
      </ul>
      <p>
        Відпустка і додаткові виплати порівнюються із законним мінімумом, з діапазоном між
        розрахунком за днями і за місяцями; ваш колективний договір може передбачати більші суми.
        Позначка «не можна перевірити» з’являється лише тоді, коли бракує даних, без яких законної
        суми немає, як-от строку попередження, якщо розірвати договір з власної ініціативи
        (dimisión), чи кількості використаних днів відпустки.
      </p>
    </section>

    <section class="sheet sheet--text">
      <h2 id="g-paro">{tx('guide.benefit')}</h2>
      <p>
        Коли закінчується договір, крім остаточного розрахунку може бути допомога по безробіттю
        (paro), тобто страхова допомога (prestación contributiva) по безробіттю. Щоб її отримувати,
        договір має закінчитися із законним статусом безробітного (situación legal de desempleo), а
        це залежить від підстави:
      </p>
      <ul>
        <li>
          Звільнення з об’єктивних причин, колективне, необґрунтоване чи дисциплінарне дає цей
          статус (art. 267.1.a LGSS). Дисциплінарне теж зараховується, навіть якщо його визнано
          обґрунтованим або не оскаржено (art. 268.4 LGSS).
        </li>
        <li>
          Закінчення строкового договору — так, хіба що договір припинили ви самі (art. 267.1.a.6.º
          LGSS).
        </li>
        <li>
          Звільнення за власним бажанням (baja voluntaria) — ні (art. 267.2.a LGSS), хіба що ви
          йдете через переведення, через істотну зміну ваших умов праці на шкоду вам (art. 41.3 ET),
          через серйозне порушення з боку роботодавця, як-от коли вам не платять або раз у раз
          платять із запізненням, чи через гендерне або сексуальне насильство (art. 267.1.a.5.º
          LGSS).
        </li>
      </ul>
      <p>
        Крім того, потрібно щонайменше 360 днів сплачених внесків на випадок безробіття за попередні
        6 років, які ви ще не використали для іншої допомоги, і можна підсумовувати кілька місць
        роботи (arts. 266.b і 269 LGSS). Також потрібно бути зареєстрованим у Seguridad Social
        (estar de alta) або в прирівняному статусі, зареєструватися як шукач роботи (demandante de
        empleo), підписати угоду про активність (acuerdo de actividad) і не досягти пенсійного віку
        (art. 266 LGSS).
      </p>
      <p>
        Щоб розрахувати її за вашими даними і побачити повну шкалу:{' '}
        <CaseLink lang={lang} id="benefit" />.
      </p>
      <p class="folio">
        Arts. <span>266 · 267 · 268.4</span> LGSS
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-paro-cuanto">{tx('guide.benefit_amount')}</h3>
      <p>
        База — це середнє значення внесків на випадок безробіття за останні 180 днів, без
        понаднормових годин (art. 270.1 LGSS). Перші 180 днів виплачується 70&nbsp;% бази, а з
        181-го дня — 60&nbsp;% (art. 270.2 LGSS).
      </p>
      <p>
        Для кожного місяця є мінімум і максимум залежно від того, скільки дітей у вас на утриманні
        (art. 270.3 LGSS). У 2026 році, при IPREM 600&nbsp;€, вони такі:
      </p>
      <ul>
        <li>Без дітей на утриманні — від 560&nbsp;€ до 1.225&nbsp;€ на місяць.</li>
        <li>З однією дитиною — від 749&nbsp;€ до 1.400&nbsp;€.</li>
        <li>З двома чи більше — від 749&nbsp;€ до 1.575&nbsp;€.</li>
      </ul>
      <p class="example">
        <span class="example__label">{tx('guide.example')}</span> При 21.000&nbsp;€ на рік база
        становить 21.000&nbsp;€ / 12 = 1.750&nbsp;€ на місяць. 70&nbsp;% — це 1.225&nbsp;€, якраз
        максимум без дітей на утриманні, а 60&nbsp;% — 1.050&nbsp;€.
      </p>
      <p>
        Це суми брутто. З них утримується 4,85&nbsp;% бази на Seguridad Social і відповідний IRPF.
        Суми в цьому посібнику і в перевірці розраховані на повний робочий час; при неповному
        робочому часі вони менші.
      </p>
      <p class="folio">
        Art. <span>270</span> LGSS
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-paro-duracion">{tx('guide.benefit_duration')}</h3>
      <p>
        Залежить від днів сплачених внесків за останні 6 років, які не використано для іншої
        допомоги (art. 269 LGSS):
      </p>
      <ul>
        <li>Від 360 до 539 днів сплачених внесків — 120 днів допомоги (4 місяці).</li>
        <li>
          Кожні додаткові 180 днів внесків додають 60 днів допомоги (2 місяці). Від 540 до 719 — 180
          днів; від 720 до 899 — 240; і так далі.
        </li>
        <li>Від 2.160 днів сплачених внесків — максимум, 720 днів (24 місяці).</li>
      </ul>
      <p class="example">
        <span class="example__label">{tx('guide.example')}</span> Із трьома роками внесків, 1.095
        днів, це 360 днів допомоги (12 місяців).
      </p>
      <p>
        Оплачена і не використана відпустка теж зараховується як період сплати внесків (art. 269.4
        LGSS). Кожен початок роботи, кожне звільнення і дні сплачених внесків наведено в документі:{' '}
        <a href={workHistoryUrl} rel="noopener">
          {tx('result.benefit_work_history_link')}
        </a>
        .
      </p>
      <p class="folio">
        Art. <span>269</span> LGSS
      </p>
    </section>

    <section class="sheet sheet--text">
      <h3 id="g-paro-plazo">{tx('guide.benefit_deadline')}</h3>
      <p>
        Без реєстрації як шукача роботи (demandante de empleo) допомоги по безробіттю немає (art.
        266 LGSS): ви реєструєтеся в службі зайнятості свого автономного співтовариства і подаєте
        заяву на допомогу до SEPE. Заяву подають протягом 15 днів після закінчення договору, робочих
        (hábiles), за тлумаченням SEPE. Якщо ваш остаточний розрахунок оплачує невикористану
        відпустку, строк відлічується від закінчення цих днів (art. 268.1 і 268.3 LGSS). Якщо подати
        заяву пізніше, дні запізнення віднімаються від тривалості допомоги (art. 268.2 LGSS).
      </p>
      <ul class="sources">
        {benefitSources.map(({ citation, url, inForce }) => (
          <li>
            <a href={url}>{citation}</a>
            <span class="sources__in-force">{inForce}</span>
          </li>
        ))}
      </ul>
      <p class="folio">
        Art. <span>268</span> LGSS
      </p>
    </section>

    <section class="sheet sheet--text">
      <h2 id="g-preguntas">{tx('guide.faq')}</h2>
      <div class="faq-list">
        {faqEntries(lang, { documents }).map(({ anchor, question, answer }) => (
          <details class="faq-item" id={anchor} data-help>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</article>

<style>
  .sheet--text .table-notes {
    font-size: 0.875rem;
  }
</style>
