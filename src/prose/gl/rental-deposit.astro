---
// source: f63abb595478
import { NORMS } from '../../engine/rental/data/norms';
import { depositExample, rentalPagesCopy } from '../../content/rental-pages';
import { formatEuros } from '../../content/rent-indices';
import { link, type Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { review: REVIEW, pages: RENTAL_PAGES, pageDecree } = rentalPagesCopy(lang);

const ex = depositExample();
// Until the Congress votes the decree down, the insurance ban stands as pending.
const banStands = NORMS.rdl29_2026.status !== 'repealed';
const href = (path: string) => link(lang, path.replace(/^\//, ''));
---

<section class="sheet sheet--text" aria-labelledby="fianza-legal">
  <h2 id="fianza-legal">A fianza: unha mensualidade</h2>
  <p>
    A fianza é obrigatoria e, nun aluguer de vivenda, é dunha mensualidade de renda en metálico
    (art. 36.1 LAU).
  </p>
  <p>
    Cando remate o contrato e entregues as chaves, teñen que devolvercha nun mes:{' '}
    <a href={href(RENTAL_PAGES.deposit_return.path)}>{RENTAL_PAGES.deposit_return.name}</a>.
  </p>
  <p class="folio">
    Art. <span>36.1</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="garantia-adicional">
  <h2 id="garantia-adicional">Outras garantías: ata dúas mensualidades máis</h2>
  <p>
    Ademais da fianza, o contrato pode pedir outra garantía: máis diñeiro ou un aval. Nos contratos
    asinados desde o 6 de marzo de 2019 de ata cinco anos, ou ata sete se o propietario é unha
    empresa, esa garantía adicional non pode pasar de dúas mensualidades de renda (art. 36.5 LAU).
  </p>
  <p>A revisión compara co límite o diñeiro que pagaches.</p>
  {banStands && (
    <p>
      Segundo o decreto, o propietario xa non pode esixirche un seguro de impagamento: explícao a{' '}
      <a href="#seguro">sección do seguro</a>, máis abaixo.
    </p>
  )}
  <p class="folio">
    Art. <span>36.5</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="adelantado">
  <h2 id="adelantado">Por adiantado: unha mensualidade</h2>
  <p>
    Por adiantado, o propietario non pode esixir máis dunha mensualidade de renda (art. 17 LAU).
  </p>
  <p class="folio">
    Art. <span>17</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="seguro">
  <h2 id="seguro">
    {banStands ? 'Seguro de impagamento: o decreto prohíbe esixircho' : 'Seguro de impagamento'}
  </h2>
  <p>{pageDecree('deposit', 'rental.page.decree.insurance')}</p>
  <p class="folio">
    Art. <span>36.5</span> LAU · RDL 29/2026
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="ejemplo">
  <h2 id="ejemplo">Exemplo resolto</h2>
  <p>
    Cunha renda de {formatEuros(ex.rent)}, un propietario pide {formatEuros(ex.asked)} en diñeiro
    antes de entrar: a fianza e garantías adicionais.
  </p>
  <p class="example">
    <span class="example__label">As contas</span> A fianza é unha mensualidade,{' '}
    {formatEuros(ex.rent)}, e a garantía adicional pode ser de dúas, {formatEuros(2 * ex.rent)}. O
    máximo é {formatEuros(ex.allowed)}. Pídenche {formatEuros(ex.asked)}: {formatEuros(ex.over)} por
    riba do límite.
  </p>
  <p class="folio">
    Art. <span>36.1 · 36.5</span> LAU
  </p>
</section>

<section class="sheet sheet--text" aria-labelledby="revision">
  <h2 id="revision">Comproba o que che pediron</h2>
  <p>
    A <a href={href(REVIEW.path)}>revisión do aluguer</a> compara con estes límites a fianza, as
    garantías e o pagamento por adiantado do teu contrato, e diche canto pasa de cada límite.
  </p>
</section>
