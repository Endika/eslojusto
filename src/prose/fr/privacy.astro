import { t, type Key } from '../../i18n';
import { link, type Lang } from '../../i18n/languages';
import { DOCUMENTS } from '../../documents/config';
import { OUTAGE_KEY } from '../../documents/outage';
import { STORAGE_KEYS } from '../../documents/pass';
const NBSP = ' ';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tx = (key: Key) => t(lang, key);

const email = 'hola@eslojusto.es';
// Reading documents and the pass exist only in a build with their API; so do their paragraphs.
const documents = DOCUMENTS !== null;

// One entry per thing that is stored or processed; a new tool adds a row here.
const stored = [
  {
    what: tx('privacy.data_review'),
    where:
      'Uniquement dans votre navigateur, tant que la page est ouverte. Le calcul se fait sur votre appareil : vos dates, votre salaire, les chiffres de votre solde de tout compte, vos enfants à charge et vos autres contrats ne sont envoyés à aucun serveur et ne sont pas conservés. Quand vous fermez ou rechargez la page, ils disparaissent.',
  },
  { what: tx('privacy.rental.data_review'), where: tx('privacy.rental.data_review_where') },
  {
    what: tx('privacy.employment.data_review'),
    where: tx('privacy.employment.data_review_where'),
  },
  {
    what: tx('privacy.household.data_review'),
    where: tx('privacy.household.data_review_where'),
  },
  { what: tx('privacy.credit.data_review'), where: tx('privacy.credit.data_review_where') },
  {
    what: tx('privacy.insurance.data_review'),
    where: tx('privacy.insurance.data_review_where'),
  },
  {
    what: tx('privacy.mortgage.data_review'),
    where: tx('privacy.mortgage.data_review_where'),
  },
  { what: tx('privacy.bills.data_review'), where: tx('privacy.bills.data_review_where') },
  ...(documents
    ? [{ what: tx('privacy.bills.data_year'), where: tx('privacy.bills.data_year_where') }]
    : []),
  {
    what: tx('privacy.data_analytics'),
    where:
      "Quelques signaux courts, avec des codes et des tranches, envoyés à PostHog pendant que vous utilisez la page (le détail, plus bas). L'identifiant de la page consultée ne vit que dans sa mémoire : il n'est pas écrit sur votre appareil et il est perdu quand vous la fermez ou la rechargez.",
  },
  ...(documents
    ? [
        {
          what: tx('privacy.data_documents'),
          where:
            "Uniquement si vous choisissez d'envoyer vos documents (la lettre de licenciement, le solde de tout compte, vos bulletins de paie, l'attestation employeur, un accord ou un procès-verbal de conciliation ou votre relevé de carrière) et que vous donnez votre consentement. Les PDF sont convertis en images de leurs pages dans votre navigateur, sans en sortir, et avant tout envoi la page vérifie, également dans votre navigateur, si une photo paraît sombre, floue ou petite. Ces images et les photos sont transmises chiffrées à un serveur d'eslojusto.es chez Amazon Web Services, en Espagne (région eu-south-2), qui les transmet à un modèle d'IA (Claude, d'Anthropic) via Amazon Bedrock, dans l'Union européenne. Le modèle indique le type de document de chaque page, recopie les données que demande le formulaire, et ce qui a été lu revient dans votre navigateur. Rien n'est conservé : les documents n'existent que dans la mémoire du serveur pendant la lecture, et ses journaux, conservés 14 jours, ne contiennent que des données techniques : le résultat, le nombre de pages, la durée, la quantité de texte traitée par le modèle et quelques indicateurs de fonctionnement, comme le besoin d'une deuxième lecture, le nombre de données qui ne concordaient pas d'un document à l'autre (sans dire lesquelles ni leurs valeurs) ou le nombre de pages qui n'ont pas pu être lues et pourquoi (par exemple, floue ou d'un autre pays). Jamais le contenu ni rien qui vous identifie.",
        },
        {
          what: tx('privacy.rental.data_documents'),
          where: tx('privacy.rental.data_documents_where'),
        },
        {
          what: tx('privacy.rental.data_letters'),
          where: tx('privacy.rental.data_letters_where'),
        },
        {
          what: tx('privacy.employment.data_documents'),
          where: tx('privacy.employment.data_documents_where'),
        },
        {
          what: tx('privacy.employment.data_letters'),
          where: tx('privacy.employment.data_letters_where'),
        },
        {
          what: tx('privacy.credit.data_documents'),
          where: tx('privacy.credit.data_documents_where'),
        },
        {
          what: tx('privacy.credit.data_letters'),
          where: tx('privacy.credit.data_letters_where'),
        },
        {
          what: tx('privacy.insurance.data_documents'),
          where: tx('privacy.insurance.data_documents_where'),
        },
        {
          what: tx('privacy.insurance.data_letters'),
          where: tx('privacy.insurance.data_letters_where'),
        },
        {
          what: tx('privacy.mortgage.data_documents'),
          where: tx('privacy.mortgage.data_documents_where'),
        },
        {
          what: tx('privacy.mortgage.data_letters'),
          where: tx('privacy.mortgage.data_letters_where'),
        },
        {
          what: tx('privacy.bills.data_documents'),
          where: tx('privacy.bills.data_documents_where'),
        },
        {
          what: tx('privacy.bills.data_letters'),
          where: tx('privacy.bills.data_letters_where'),
        },
        {
          what: tx('privacy.data_pass'),
          where: `Dans le stockage local (localStorage) de votre navigateur, et uniquement si vous les utilisez${NBSP}: un compteur signé de vos lectures gratuites du jour («${NBSP}${STORAGE_KEYS.quota}${NBSP}»)${NBSP}; si vous achetez le pass, le pass et les lectures qui lui restent («${NBSP}${STORAGE_KEYS.pass}${NBSP}») et le code de chaque paiement que vous commencez, avec un nombre aléatoire que seul votre navigateur connaît, pour pouvoir récupérer le pass («${NBSP}${STORAGE_KEYS.checkout}${NBSP}»${NBSP}; chaque paiement est retiré au bout de 7 jours s'il n'a pas été finalisé, ou quand son pass expire). Ils ne contiennent ni votre nom ni rien de vos documents, et ne quittent votre appareil qu'avec la lecture suivante, pour récupérer le pass ou pour le vérifier avant de vous montrer le détail de votre vérification, le rapport ou la lettre. Ils sont reçus par le serveur d'eslojusto.es chez AWS, qui interroge Stripe sur le paiement. Le pass expiré et le compteur d'un jour précédent s'effacent d'eux-mêmes la prochaine fois que la page les consulte, et tout est effacé quand vous effacez les données de ce site dans votre navigateur${NBSP}; c'est pourquoi le pass n'est valable que dans ce navigateur et se perd sur un autre appareil, dans une fenêtre de navigation privée ou quand vous les effacez. Si la lecture n'est pas disponible, l'onglet le garde en mémoire une heure dans son stockage de session («${NBSP}${OUTAGE_KEY}${NBSP}», avec l'heure seulement) pour ne pas vous la proposer entre-temps.`,
        },
        {
          what: tx('privacy.data_checkout'),
          where: `Si vous payez, les réponses de votre vérification sont conservées dans le stockage de session (sessionStorage) de cet onglet pendant que vous êtes sur la page de paiement, pour vous montrer le résultat à votre retour. Pour les factures d'électricité, les réponses de chaque facture de votre année que vous avez déjà vérifiée sont conservées de la même façon, sans l'empreinte du code du point de livraison. Elles ne quittent pas votre appareil et sont effacées à votre retour ou quand vous fermez l'onglet.`,
        },
      ]
    : []),
  {
    what: tx('privacy.data_theme'),
    where:
      'Dans le stockage local (localStorage) de votre navigateur, et uniquement si vous appuyez sur le bouton du thème. Il ne quitte jamais votre appareil. Il est effacé quand vous effacez les données de ce site dans votre navigateur.',
