// The allowlist (src/analytics/sanitize.ts) and the event catalogue (src/analytics/events.ts), in
// plain words. Keep all three in step: the analytics e2e asserts the exact keys.
const tracked = [
  {
    when: 'Avec chaque signal',
    what: "La date et l'heure de chaque signal et un nombre aléatoire qui n'existe que tant que la page est ouverte. L'adresse de la page sans paramètres : le domaine, le chemin et la fiche sur laquelle vous êtes. Votre navigateur et sa version, et votre système (Windows, Android…). Le type d'appareil (ordinateur, mobile ou tablette) et la taille de la fenêtre. Le domaine du site d'où vous venez (par exemple « www.google.com »), sans l'adresse complète. Si vous arrivez par un lien de campagne, sa source, son support et son nom (utm_source, utm_medium, utm_campaign), uniquement s'il s'agit d'un code court composé de lettres, de chiffres et de tirets. Et trois données techniques de PostHog : la clé du projet d'eslojusto.es, la version de son code et un indicateur qui lui demande de ne créer aucun profil.",
  },
  {
    when: "À l'ouverture d'une page",
    what: "Que vous l'avez ouverte et la langue principale de votre navigateur, uniquement la partie générale : « ja », pas « ja-JP ».",
  },
  {
    when: 'En quittant une page',
    what: "Le temps passé sur la page et jusqu'où vous avez fait défiler.",
  },
  {
    when: 'Si vous utilisez le traducteur du navigateur',
    what: 'La langue vers laquelle vous traduisez la page, par exemple « ar ».',
  },
  {
    when: 'Sur chaque fiche de la vérification',
    what: "Que vous l'ouvrez et, quand vous la terminez, le temps que vous y avez passé, dans une tranche large : moins de 10 secondes, de 10 à 30, de 30 à 60, de 60 à 180 ou plus de 180. Si vous revenez en arrière, de quelle fiche vers laquelle.",
  },
  {
    when: "Si une donnée n'est pas acceptée",
    what: 'Le nom du champ, par exemple « date de sortie ». Jamais ce que vous y avez saisi.',
  },
  {
    when: 'Si vous ouvrez une aide',
    what: "Quelle question fréquente vous ouvrez, ou pour quel poste vous consultez « Comment c'est calculé ».",
  },
  {
    when: 'Lors de la vérification',
    what: "Le motif de la fin du contrat, le type de contrat à durée déterminée, la façon dont vous percevez les primes extraordinaires et si vous comptez les congés en jours ouvrés ou en jours calendaires et, s'ils sont ouvrés, si vous travaillez 5, 6 ou un autre nombre de jours par semaine, tels que vous les choisissez dans les options. Combien de postes comportent le chiffre de votre solde de tout compte et combien ressortent en dessous, concordent, au-dessus ou sans pouvoir être vérifiés. Si l'on vous retient plus de préavis que le maximum. Si ce que coûterait un licenciement injustifié est affiché, sans le chiffre. Si le résultat s'affiche en résumé ou avec le détail du pass. Si cette visite montre d'abord les vérifications une à une ou directement le résultat : c'est tiré au hasard, la moitié des visites pour chaque façon, et ce n'est pas conservé. Si l'écart est nul, inférieur à 100 €, de 100 à 500 €, de 500 à 2.000 € ou supérieur. Combien de fois vous avez fait la vérification sur cette page, le temps passé, par tranches, et, si vous la refaites, le nom des champs que vous avez modifiés. Pour le chômage, uniquement si l'estimation ne s'applique pas à votre motif, si elle comporte des chiffres ou si elle s'affiche sans, et combien d'autres contrats vous avez ajoutés, par tranche : 0, 1, 2, ou 3 et plus. Jamais le nombre d'enfants à votre charge ni aucune date de ces contrats. Pour l'ERTE et pour la question de savoir si vous avez été payé, uniquement le nom de la question si vous la modifiez, jamais la réponse. Ce que vous cochez sur un éventuel licenciement nul (grossesse, congés, arrêt maladie…) n'est jamais envoyé, même si vous avez coché quelque chose.",
  },
  {
    when: 'En appuyant sur « Recommencer »',
    what: 'Que vous avez appuyé dessus.',
  },
  {
    when: tx('privacy.rental.tracked_sheets'),
    what: tx('privacy.rental.tracked_sheets_what'),
  },
  {
    when: tx('privacy.rental.tracked_scope'),
    what: tx('privacy.rental.tracked_scope_what'),
  },
  {
    when: tx('privacy.rental.tracked_review'),
    what: tx('privacy.rental.tracked_review_what'),
  },
  {
    when: tx('privacy.employment.tracked_sheets'),
    what: tx('privacy.employment.tracked_sheets_what'),
  },
  {
    when: tx('privacy.employment.tracked_scope'),
    what: tx('privacy.employment.tracked_scope_what'),
  },
  {
    when: tx('privacy.employment.tracked_review'),
    what: tx('privacy.employment.tracked_review_what'),
  },
  {
    when: tx('privacy.household.tracked_sheets'),
    what: tx('privacy.household.tracked_sheets_what'),
  },
  {
    when: tx('privacy.household.tracked_scope'),
    what: tx('privacy.household.tracked_scope_what'),
  },
  {
