// The allowlist (src/analytics/sanitize.ts) and the event catalogue (src/analytics/events.ts), in
// plain words. Keep all three in step: the analytics e2e asserts the exact keys.
const tracked = [
  {
    when: 'Abisu bakoitzarekin',
    what: 'Abisu bakoitzaren data eta ordua, eta orria irekita dagoen bitartean bakarrik existitzen den ausazko zenbaki bat. Orriaren helbidea, parametrorik gabe: domeinua, bidea eta zauden urratsa. Zure nabigatzailea eta haren bertsioa, eta zure sistema (Windows, Android…). Gailu mota (ordenagailua, mugikorra edo tableta) eta leihoaren tamaina. Zatozen webgunearen domeinua (adibidez, «www.google.com»), helbide osoa gabe. Kanpaina-esteka batetik iristen bazara, haren jatorria, bitartekoa eta izena (utm_source, utm_medium, utm_campaign), letrez, zenbakiz eta marratxoz osatutako kode labur bat direnean bakarrik. Eta PostHog zerbitzuaren hiru datu tekniko: eslojusto.es-en proiektuaren gakoa, haren kodearen bertsioa eta profilik ez sortzeko eskatzen dion marka bat.',
  },
  {
    when: 'Orri bat irekitzean',
    what: 'Ireki duzula, eta zure nabigatzailearen hizkuntza nagusia, zati orokorra bakarrik: «ja», ez «ja-JP».',
  },
  {
    when: 'Orri bat uztean',
    what: 'Zenbat denbora egon zinen orrian eta noraino jaitsi zinen.',
  },
  {
    when: 'Nabigatzailearen itzultzailea erabiltzen baduzu',
    what: 'Orria zer hizkuntzatara itzultzen duzun, adibidez «ar».',
  },
  {
    when: 'Berrikuspenaren urrats bakoitzean',
    what: 'Irekitzen duzula eta, amaitzean, zenbat denbora behar izan duzun, tarte zabal batean: 10 segundo baino gutxiago, 10etik 30era, 30etik 60ra, 60tik 180ra edo 180 baino gehiago. Atzera itzultzen bazara, zer urratsetatik zeinetara.',
  },
  {
    when: 'Datu bat onartzen ez bada',
    what: 'Eremuaren izena, adibidez «baja-data». Inoiz ez hor idatzi duzuna.',
  },
  {
    when: 'Laguntza bat irekitzen baduzu',
    what: 'Zer ohiko galdera irekitzen duzun, edo zer kontzepturen «Nola kalkulatzen den» begiratzen duzun.',
  },
  {
    when: 'Berrikustean',
    what: 'Kontratuaren amaieraren kausa, aldi baterako kontratuaren mota, aparteko ordainsariak nola kobratzen dituzun, oporrak lanegunetan edo egun naturaletan zenbatzen dituzun eta, lanegunak badira, astean 5, 6 edo beste egun kopuru bat lan egiten duzun, aukeretan hautatzen dituzun bezala. Zenbat kontzeptuk duten zure kitapeneko zifra, eta horietatik zenbat geratzen diren gutxienekoaren azpitik, zenbat datozen bat, zenbat geratzen diren gainetik eta zenbat ezin diren egiaztatu. Gehienezkoa baino aurreabis gehiago kentzen dizuten. Bidegabeko kaleratze batek zer ordainduko lukeen erakusten den, zifrarik gabe. Emaitza laburpenean ateratzen den edo pasearen xehetasunarekin. Aldea zero den, 100 € baino txikiagoa, 100 eta 500 € artekoa, 500 eta 2.000 € artekoa edo handiagoa. Orri honetan zenbat aldiz berrikusi duzun, zenbat denbora behar izan duzun, tartetan, eta, berriro berrikusten baduzu, aldatu dituzun eremuen izena. Langabeziari dagokionez, estimazioa zure kausari aplikatzen ez zaion, zifrak dituen edo zifrarik gabe ateratzen den bakarrik, eta beste zenbat kontratu gehitu dituzun, tarte batean: 0, 1, 2 edo 3 edo gehiago. Inoiz ez zenbat seme-alaba dituzun zure kargura, ezta kontratu horien datarik ere. ERTEari eta ordaindu dizuten ala ez galderari dagokienez, galderaren izena bakarrik, aldatzen baduzu, inoiz ez erantzuna. Kaleratze deusez posible bati buruz markatzen duzuna (haurdunaldia, baimenak, baja medikoa…) ez da inoiz bidaltzen, ezta zerbait markatu baduzu ere.',
  },
  {
    when: '«Hasi berriro» sakatzean',
    what: 'Sakatu duzula.',
  },
  {
