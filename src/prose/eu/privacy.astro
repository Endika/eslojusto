// source: 625095d4cc94
import { t, type Key } from '../../i18n';
import { link, type Lang } from '../../i18n/languages';
import { DOCUMENTS } from '../../documents/config';
import { OUTAGE_KEY } from '../../documents/outage';
import { STORAGE_KEYS } from '../../documents/pass';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const tx = (key: Key) => t(lang, key);

const email = 'hola@eslojusto.es';
// Reading documents and the pass exist only in a build with their API; so do their paragraphs.
const documents = DOCUMENTS !== null;

// One entry per thing that is stored or processed; a new tool adds a row here.
const stored = [
  {
    what: tx('privacy.data_review'),
    where:
      'Zure nabigatzailean bakarrik, orria irekita dagoen bitartean. Kalkulua zure gailuan egiten da: zure datak, zure soldata, zure kitapenaren zifrak, zure kargurako seme-alabak eta zure beste kontratuak ez dira inongo zerbitzarira bidaltzen, ezta gordetzen ere. Orria ixtean edo berriro kargatzean, desagertu egiten dira.',
  },
  { what: tx('privacy.rental.data_review'), where: tx('privacy.rental.data_review_where') },
  {
    what: tx('privacy.employment.data_review'),
    where: tx('privacy.employment.data_review_where'),
  },
  {
    what: tx('privacy.household.data_review'),
    where: tx('privacy.household.data_review_where'),
  },
  { what: tx('privacy.credit.data_review'), where: tx('privacy.credit.data_review_where') },
  {
    what: tx('privacy.insurance.data_review'),
    where: tx('privacy.insurance.data_review_where'),
  },
  {
    what: tx('privacy.mortgage.data_review'),
    where: tx('privacy.mortgage.data_review_where'),
  },
  { what: tx('privacy.bills.data_review'), where: tx('privacy.bills.data_review_where') },
  ...(documents
    ? [{ what: tx('privacy.bills.data_year'), where: tx('privacy.bills.data_year_where') }]
    : []),
  {
    what: tx('privacy.data_analytics'),
    where:
      'Kodez eta tartez osatutako abisu labur batzuk, orria erabiltzen duzun bitartean PostHog zerbitzura bidaltzen direnak (xehetasuna, behean). Ikusitako orriaren identifikatzailea orriaren memorian bakarrik bizi da: ez da zure gailuan idazten, eta orria ixtean edo berriro kargatzean galtzen da.',
  },
  ...(documents
    ? [
        {
          what: tx('privacy.data_documents'),
          where:
            'Zure dokumentuak igotzea aukeratzen baduzu (kaleratze-gutuna, kitapena, zure nominak, enpresa-ziurtagiria, adiskidetze-akordio edo -akta bat edo zure lan-bizitza) eta baimena ematen baduzu bakarrik. PDFak haien orrialdeen irudi bihurtzen dira zure nabigatzailean, handik atera gabe, eta ezer bidali aurretik orriak begiratzen du, hori ere zure nabigatzailean, argazkiren bat ilun, lauso edo txiki ikusten den. Irudi horiek eta argazkiak zifratuta bidaltzen dira Amazon Web Services-en Espainiako eslojusto.es-en zerbitzari batera (eu-south-2 eskualdea), eta zerbitzari horrek AA eredu bati pasatzen dizkio (Claude, Anthropic-ena, Amazon Bedrock bidez), Europar Batasunaren barruan. AA ereduak orrialde bakoitza zer dokumentu mota den adierazten du, formularioak eskatzen dituen datuak kopiatzen ditu, eta irakurritakoa zure nabigatzailera itzultzen da. Ez da ezer gordetzen: dokumentuak zerbitzariaren memorian bakarrik daude irakurtzen diren bitartean, eta haien erregistroek, 14 egunez gordetzen direnek, datu teknikoak bakarrik dituzte: emaitza, orrialde kopurua, zenbat denbora behar izan zen, AA ereduak zenbat testu prozesatu zuen eta funtzionamendu-marka batzuk, hala nola bigarren irakurketa bat behar izan zen, dokumentuen artean zenbat datu ez zetozen bat (zein ziren edo haien balioak esan gabe) edo zenbat orrialde ezin izan ziren irakurri eta zergatik (adibidez, lausoa edo beste herrialde batekoa). Inoiz ez edukia, ezta zu identifikatzen zaituen ezer ere.',
        },
        {
          what: tx('privacy.rental.data_documents'),
          where: tx('privacy.rental.data_documents_where'),
        },
        {
          what: tx('privacy.rental.data_letters'),
          where: tx('privacy.rental.data_letters_where'),
        },
        {
          what: tx('privacy.employment.data_documents'),
          where: tx('privacy.employment.data_documents_where'),
        },
        {
          what: tx('privacy.employment.data_letters'),
          where: tx('privacy.employment.data_letters_where'),
        },
        {
          what: tx('privacy.credit.data_documents'),
          where: tx('privacy.credit.data_documents_where'),
        },
        {
          what: tx('privacy.credit.data_letters'),
          where: tx('privacy.credit.data_letters_where'),
        },
        {
          what: tx('privacy.insurance.data_documents'),
          where: tx('privacy.insurance.data_documents_where'),
        },
        {
          what: tx('privacy.insurance.data_letters'),
          where: tx('privacy.insurance.data_letters_where'),
        },
        {
          what: tx('privacy.mortgage.data_documents'),
          where: tx('privacy.mortgage.data_documents_where'),
        },
        {
          what: tx('privacy.mortgage.data_letters'),
          where: tx('privacy.mortgage.data_letters_where'),
        },
        {
          what: tx('privacy.bills.data_documents'),
          where: tx('privacy.bills.data_documents_where'),
        },
        {
          what: tx('privacy.bills.data_letters'),
          where: tx('privacy.bills.data_letters_where'),
        },
        {
          what: tx('privacy.data_pass'),
          where: `Zure nabigatzailearen tokiko biltegian (localStorage), eta erabiltzen badituzu bakarrik: eguneko doako irakurketen kontagailu sinatu bat («${STORAGE_KEYS.quota}»); pasea erosten baduzu, pasea eta geratzen zaizkion irakurketak («${STORAGE_KEYS.pass}»), eta hasten duzun ordainketa bakoitzaren kodea, zure nabigatzaileak bakarrik ezagutzen duen ausazko zenbaki batekin, pasea berreskuratu ahal izateko («${STORAGE_KEYS.checkout}»; ordainketa bakoitza 7 egunen buruan kentzen da osatu ez bada, edo haren pasea iraungitzen denean). Ez daramate zure izenik, ezta zure dokumentuetako ezer ere, eta hurrengo irakurketarekin bakarrik ateratzen dira zure gailutik, pasea berreskuratzeko edo hura egiaztatzeko zure berrikuspenaren xehetasuna, txostena edo gutuna erakutsi aurretik. AWSko eslojusto.es-en zerbitzariak jasotzen ditu, eta zerbitzari horrek Stripe-ri galdetzen dio ordainketaz. Iraungitako pasea eta aurreko egun bateko kontagailua bere kabuz ezabatzen dira orriak hurrengo aldiz kontsultatzen dituenean, eta dena ezabatzen da zure nabigatzailean gune honetako datuak ezabatzean; horregatik, paseak nabigatzaile honetan bakarrik balio du, eta beste gailu batean, leiho pribatu batean edo datu horiek ezabatzean galtzen da. Irakurketa erabilgarri ez badago, nabigatzailearen fitxak ordubetez gogoratzen du bere saio-biltegian («${OUTAGE_KEY}», orduarekin bakarrik), bitartean ez eskaintzeko.`,
        },
        {
          what: tx('privacy.data_checkout'),
          where: `Ordaintzen baduzu, zure berrikuspeneko erantzunak fitxa horren saio-biltegian (sessionStorage) gordetzen dira ordainketa-orrian zauden bitartean, itzultzean emaitza erakusteko. Argiaren fakturetan, dagoeneko berrikusi duzun zure urteko faktura bakoitzaren erantzunak gordetzen dira horrela, hornidura-kodearen aztarnarik gabe. Ez dira zure gailutik ateratzen, eta itzultzean edo fitxa ixtean ezabatzen dira.`,
        },
      ]
    : []),
