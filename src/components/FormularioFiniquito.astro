---
import Campo from './Campo.astro';
import { t, type Clave } from '../i18n';
import type { Idioma } from '../i18n/idiomas';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const tx = (clave: Clave) => t(idioma, clave);

const causas = ['dimision', 'fin_temporal', 'objetivo', 'improcedente', 'disciplinario'] as const;
const temporales = ['circunstancias', 'sustitucion', 'formativo'] as const;
const devengos = ['anual', 'semestral', 'no_lo_se'] as const;
const cifras = [
  'salario_pendiente',
  'vacaciones',
  'pagas_extra',
  'indemnizacion',
  'preaviso_empresa',
  'descuento_preaviso',
] as const;

const hijos = [
  ['0', 'hijos.ninguno'],
  ['1', 'hijos.uno'],
  ['2', 'hijos.dos'],
  ['no_dice', 'hijos.no_dice'],
] as const;
const paroDespues = [
  ['si', 'form.si'],
  ['no', 'form.no'],
  ['no_lo_se', 'otros.no_lo_se'],
] as const;
const vidaLaboral =
  'https://sede.seg-social.gob.es/wps/portal/sede/sede/Ciudadanos/Informes+y+Certificados/201864';

const flecha = 'M4 12h15m-6-6 6 6-6 6';
---

<form class="calculadora" id="calculadora" novalidate aria-label={tx('form.aria')}>
  <div class="pila">
    <fieldset class="hoja" id="hoja-causa" data-hoja="causa" aria-labelledby="pregunta-causa">
      <h2 class="pregunta" id="pregunta-causa" tabindex="-1">
        {tx('causa.pregunta')}
      </h2>
      <p class="ayuda">{tx('causa.ayuda')}</p>
      <div class="opciones" data-campo="causa">
        {causas.map((valor) => (
          <div class="opcion">
            <input
              type="radio"
              name="causa"
              id={`causa-${valor}`}
              value={valor}
              aria-describedby={`pista-causa-${valor} error-causa`}
            />
            <label for={`causa-${valor}`}>{tx(`causa.${valor}`)}</label>
            <p class="pista" id={`pista-causa-${valor}`}>
              {tx(`causa.${valor}_pista`)}
            </p>
          </div>
        ))}
        <p class="errata" id="error-causa" data-error-de="causa" hidden></p>
      </div>
    </fieldset>

    <fieldset
      class="hoja"
      id="hoja-temporal"
      data-hoja="temporal"
      aria-labelledby="pregunta-temporal"
    >
      <h2 class="pregunta" id="pregunta-temporal" tabindex="-1">
        {tx('temporal.pregunta')}
      </h2>
      <p class="ayuda">{tx('temporal.ayuda')}</p>
      <div class="opciones" data-campo="tipoTemporal" data-si-causa="fin_temporal">
        {temporales.map((valor) => (
          <div class="opcion">
            <input
              type="radio"
              name="tipoTemporal"
              id={`tipo-${valor}`}
              value={valor}
              aria-describedby={`pista-tipo-${valor} error-tipoTemporal`}
              disabled
            />
            <label for={`tipo-${valor}`}>{tx(`temporal.${valor}`)}</label>
            <p class="pista" id={`pista-tipo-${valor}`}>
              {tx(`temporal.${valor}_pista`)}
            </p>
          </div>
        ))}
        <p class="errata" id="error-tipoTemporal" data-error-de="tipoTemporal" hidden></p>
      </div>
    </fieldset>

    <fieldset class="hoja" id="hoja-fechas" data-hoja="fechas" aria-labelledby="pregunta-fechas">
      <h2 class="pregunta" id="pregunta-fechas" tabindex="-1">
        {tx('fechas.pregunta')}
      </h2>
      <p class="ayuda">{tx('fechas.ayuda')}</p>
      <Campo
        nombre="fechaAlta"
        etiqueta={tx('fechas.alta')}
        pista={tx('fechas.alta_pista')}
        tipo="fecha"
      />
      <Campo
        nombre="fechaBaja"
        etiqueta={tx('fechas.baja')}
        pista={tx('fechas.baja_pista')}
        tipo="fecha"
      />
    </fieldset>

    <fieldset
      class="hoja"
      id="hoja-prorrateo"
      data-hoja="prorrateo"
      aria-labelledby="pregunta-prorrateo"
    >
      <h2 class="pregunta" id="pregunta-prorrateo" tabindex="-1">
        {tx('prorrateo.pregunta')}
      </h2>
      <p class="ayuda" id="pista-pagasProrrateadas">
        {tx('prorrateo.ayuda')}
      </p>
      <div class="fichas" data-campo="pagasProrrateadas">
        <div class="ficha">
          <input
            type="radio"
            name="pagasProrrateadas"
            id="prorrateo-si"
            value="si"
            aria-describedby="pista-pagasProrrateadas error-pagasProrrateadas"
          />
          <label for="prorrateo-si">{tx('form.si')}</label>
        </div>
        <div class="ficha">
          <input
            type="radio"
            name="pagasProrrateadas"
            id="prorrateo-no"
            value="no"
            aria-describedby="pista-pagasProrrateadas error-pagasProrrateadas"
          />
          <label for="prorrateo-no">{tx('form.no')}</label>
        </div>
      </div>
      <p class="errata" id="error-pagasProrrateadas" data-error-de="pagasProrrateadas" hidden></p>
    </fieldset>

    <fieldset class="hoja" id="hoja-salario" data-hoja="salario" aria-labelledby="pregunta-salario">
      <h2 class="pregunta" id="pregunta-salario" tabindex="-1">
        {tx('salario.pregunta')}
      </h2>
      <p class="ayuda">{tx('salario.ayuda')}</p>
      <Campo
        nombre="salarioMensual"
        etiqueta={tx('salario.mensual')}
        pista={tx('salario.mensual_pista_no')}
        tipo="importe"
        atributos={{
          'data-pista-si': tx('salario.mensual_pista_si'),
          'data-pista-no': tx('salario.mensual_pista_no'),
        }}
      />
    </fieldset>

    <fieldset class="hoja" id="hoja-pagas" data-hoja="pagas" aria-labelledby="pregunta-pagas">
      <h2 class="pregunta" id="pregunta-pagas" tabindex="-1">
        {tx('pagas.pregunta')}
      </h2>
      <p class="ayuda">{tx('pagas.ayuda')}</p>
      <div class="pagas" data-si-prorrateo="no" hidden>
        <div class="pareja">
          <Campo
            nombre="numeroPagas"
            etiqueta={tx('pagas.numero')}
            pista={tx('pagas.numero_pista')}
            tipo="dias"
            valor="2"
          />
          <Campo
            nombre="importePaga"
            etiqueta={tx('pagas.importe')}
            pista={tx('pagas.importe_pista')}
            tipo="importe"
          />
        </div>
        <fieldset class="grupo" data-campo="devengoPagas">
          <legend>{tx('pagas.devengo')}</legend>
          <p class="pista" id="pista-devengoPagas">
            {tx('pagas.devengo_pista')}
          </p>
          <div class="fichas">
            {devengos.map((valor) => (
              <div class="ficha">
                <input
                  type="radio"
                  name="devengoPagas"
                  id={`devengo-${valor}`}
                  value={valor}
                  checked={valor === 'no_lo_se'}
                  aria-describedby="pista-devengoPagas error-devengoPagas"
                />
                <label for={`devengo-${valor}`}>{tx(`pagas.${valor}`)}</label>
              </div>
            ))}
          </div>
          <p class="errata" id="error-devengoPagas" data-error-de="devengoPagas" hidden></p>
        </fieldset>
      </div>
    </fieldset>

    <fieldset
      class="hoja"
      id="hoja-vacaciones"
      data-hoja="vacaciones"
      aria-labelledby="pregunta-vacaciones"
    >
      <h2 class="pregunta" id="pregunta-vacaciones" tabindex="-1">
        {tx('vacaciones.pregunta')}
      </h2>
      <div class="pareja">
        <Campo
          nombre="diasVacacionesAnuales"
          etiqueta={tx('vacaciones.anuales')}
          pista={tx('vacaciones.anuales_pista')}
          tipo="dias"
          valor="30"
        />
        <Campo
          nombre="diasVacacionesDisfrutadas"
          etiqueta={tx('vacaciones.disfrutadas')}
          pista={tx('vacaciones.disfrutadas_pista')}
          tipo="dias"
        >
          <div class="casilla">
            <input
              type="checkbox"
              name="diasVacacionesDisfrutadasNoLoSe"
              id="diasVacacionesDisfrutadasNoLoSe"
              value="si"
              data-sin-dato="diasVacacionesDisfrutadas"
            />
            <label for="diasVacacionesDisfrutadasNoLoSe">
              {tx('vacaciones.disfrutadas_no_lo_se')}
            </label>
          </div>
        </Campo>
      </div>
      <Campo
        nombre="diasPreavisoRecibidos"
        etiqueta={tx('vacaciones.preaviso_recibido')}
        pista={tx('vacaciones.preaviso_recibido_pista')}
        tipo="dias"
        atributos={{ 'data-si-causa': 'objetivo fin_temporal', hidden: '' }}
      />
      <div class="pareja" data-si-causa="dimision" hidden>
        <Campo
          nombre="diasPreavisoConvenio"
          etiqueta={tx('vacaciones.preaviso_convenio')}
          pista={tx('vacaciones.preaviso_convenio_pista')}
          tipo="dias"
        />
        <Campo
          nombre="diasPreavisoDados"
          etiqueta={tx('vacaciones.preaviso_dado')}
          pista={tx('vacaciones.preaviso_dado_pista')}
          tipo="dias"
        />
      </div>
      <p class="ayuda ayuda--nota" data-si-causa="improcedente disciplinario" hidden>
        {tx('vacaciones.sin_preaviso')}
      </p>
    </fieldset>

    <fieldset class="hoja" id="hoja-hijos" data-hoja="hijos" aria-labelledby="pregunta-hijos">
      <h2 class="pregunta" id="pregunta-hijos" tabindex="-1">
        {tx('hijos.pregunta')}
      </h2>
      <p class="ayuda ayuda--corta">{tx('hijos.ayuda')}</p>
      <p class="pista pista--hoja" id="pista-hijos">
        {tx('hijos.quien')}
      </p>
      <div class="fichas" data-campo="hijos">
        {hijos.map(([valor, clave]) => (
          <div class="ficha">
            <input
              type="radio"
              name="hijos"
              id={`hijos-${valor}`}
              value={valor}
              aria-describedby="pista-hijos error-hijos"
            />
            <label for={`hijos-${valor}`}>{tx(clave)}</label>
          </div>
        ))}
      </div>
      <p class="errata" id="error-hijos" data-error-de="hijos" hidden></p>
    </fieldset>

    <fieldset class="hoja" id="hoja-otros" data-hoja="otros" aria-labelledby="pregunta-otros">
      <h2 class="pregunta" id="pregunta-otros" tabindex="-1">
        {tx('otros.pregunta')}
      </h2>
      <p class="ayuda" id="pista-otrosContratos">
        {tx('otros.ayuda')}
      </p>
      <div class="fichas" data-campo="otrosContratos">
        {(['no', 'si'] as const).map((valor) => (
          <div class="ficha">
            <input
              type="radio"
              name="otrosContratos"
              id={`otros-${valor}`}
              value={valor}
              checked={valor === 'no'}
              aria-describedby="pista-otrosContratos"
            />
            <label for={`otros-${valor}`}>{tx(`otros.${valor}`)}</label>
          </div>
        ))}
      </div>
      <div class="otros" data-si-otros="si" hidden>
        <fieldset class="grupo" data-campo="paroCobradoDespues">
          <legend>{tx('otros.paro')}</legend>
          <div class="fichas">
            {paroDespues.map(([valor, clave]) => (
              <div class="ficha">
                <input
                  type="radio"
                  name="paroCobradoDespues"
                  id={`paro-despues-${valor}`}
                  value={valor}
                  aria-describedby="error-paroCobradoDespues"
                  disabled
                />
                <label for={`paro-despues-${valor}`}>{tx(clave)}</label>
              </div>
            ))}
          </div>
          <p
            class="errata"
            id="error-paroCobradoDespues"
            data-error-de="paroCobradoDespues"
            hidden
          ></p>
        </fieldset>
        <ol class="otros__lista" data-otros-lista aria-label={tx('otros.lista')}></ol>
        <button class="boton boton--hoja" type="button" data-otro-anadir>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          {tx('otros.anadir')}
        </button>
      </div>
      <p class="pista otros__vida">
        {tx('otros.vida_laboral')}{' '}
        <a href={vidaLaboral} rel="noopener" target="_blank">
          {tx('otros.vida_laboral_enlace')}
        </a>
        .
      </p>
      <template data-plantilla="otro">
        <li class="otro" data-otro>
          <fieldset class="grupo otro__grupo">
            <legend data-otro-leyenda></legend>
            <div class="otro__fechas">
              <div class="campo">
                <label class="campo__etiqueta" data-etiqueta="fechaAlta">
                  {tx('otros.alta')}
                </label>
                <input
                  class="campo__entrada campo__entrada--cifra"
                  type="date"
                  dir="ltr"
                  data-dato="fechaAlta"
                />
              </div>
              <div class="campo">
                <label class="campo__etiqueta" data-etiqueta="fechaBaja">
                  {tx('otros.baja')}
                </label>
                <input
                  class="campo__entrada campo__entrada--cifra"
                  type="date"
                  dir="ltr"
                  data-dato="fechaBaja"
                />
              </div>
            </div>
            <p class="errata" data-errata="fechaAlta" hidden></p>
            <p class="errata" data-errata="fechaBaja" hidden></p>
            <button class="otro__quitar" type="button" data-otro-quitar>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12M18 6 6 18"></path>
              </svg>
              {tx('otros.quitar')}
            </button>
          </fieldset>
        </li>
      </template>
    </fieldset>

    <fieldset
      class="hoja"
      id="hoja-finiquito"
      data-hoja="finiquito"
      aria-labelledby="pregunta-finiquito"
    >
      <h2 class="pregunta" id="pregunta-finiquito" tabindex="-1">
        {tx('cifras.pregunta')}
      </h2>
      <p class="ayuda" id="pista-cifras">
        {tx('cifras.ayuda')}
      </p>
      <div class="cifras">
        {cifras.map((id) => (
          <Campo
            nombre={`cifra_${id}`}
            etiqueta={tx(`cifras.${id}`)}
            tipo="importe"
            fila
            otrasPistas={['pista-cifras']}
            atributos={{ 'data-cifra': id }}
          />
        ))}
      </div>
    </fieldset>
  </div>

  <div class="acciones">
    <div class="acciones__dentro">
      <button class="boton boton--atras" type="button" data-atras hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d={flecha} transform="rotate(180 12 12)"></path>
        </svg>
        {tx('form.atras')}
      </button>
      <button class="boton boton--avanza" type="button" data-siguiente>
        {tx('form.siguiente')}
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d={flecha}></path>
        </svg>
      </button>
      <button class="boton boton--avanza" type="submit" data-revisar hidden>
        {tx('form.revisar')}
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d={flecha}></path>
        </svg>
      </button>
    </div>
  </div>
</form>
