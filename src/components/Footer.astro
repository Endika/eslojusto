---
import { t, type Key } from '../i18n';
import { link, LANGS, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const links = [
  [link(lang, 'aviso-legal/'), t(lang, 'footer.legal_notice')],
  [link(lang, 'privacidad/'), t(lang, 'footer.privacy')],
] as const;
const current = Astro.url.pathname;
// Each section names the norms its figures follow; the legal pages and the home page name none.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const local = current
  .slice(base.length)
  .replace(new RegExp(`^/(${Object.keys(LANGS).join('|')})(?=/)`), '');
const general = ['/', '/privacidad/', '/aviso-legal/'].includes(local);
const note: Key = local.startsWith('/alquiler/')
  ? 'footer.note_rental'
  : local.startsWith('/contrato/')
    ? 'footer.note_employment'
    : local.startsWith('/empleada-de-hogar/')
      ? 'footer.note_household'
      : local.startsWith('/seguros/')
        ? 'footer.note_insurance'
        : local.startsWith('/financiacion/')
          ? 'footer.note_credit'
          : local.startsWith('/hipoteca/')
            ? 'footer.note_mortgage'
            : local.startsWith('/facturas/')
              ? 'footer.note_bills'
              : local.startsWith('/paro/')
                ? 'footer.note_benefit'
                : general
                  ? 'footer.note_general'
                  : 'footer.note';
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__note">{t(lang, note)}</p>
    <nav aria-label={t(lang, 'footer.nav')}>
      <ul class="footer__links">
        {links.map(([href, name]) => (
          <li>
            <a href={href} aria-current={current === href ? 'page' : undefined}>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
