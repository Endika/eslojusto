---
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (key: Key) => t(lang, key);
---

<section class="result" id="resultado" aria-labelledby="result-title" hidden>
  {/* Every state has its own mark beside its words, so none rests on colour alone. */}
  <svg class="marks" aria-hidden="true" focusable="false">
    <symbol id="rental-mark-paid-over" viewBox="0 0 24 24">
      <path d="M12 21V4m-5 5 5-5 5 5M3 14h18"></path>
    </symbol>
    <symbol id="rental-mark-owed" viewBox="0 0 24 24">
      <path d="M4 7h16M4 17h8"></path>
      <path d="M15 17h5" stroke-dasharray="2 2.5" stroke-linecap="butt"></path>
    </symbol>
    <symbol id="rental-mark-over-cap" viewBox="0 0 24 24">
      <path d="M3 9h18M8 20V5m4 15V3m4 17V5"></path>
    </symbol>
    <symbol id="rental-mark-within-limit" viewBox="0 0 24 24">
      <path d="M4 7h16M4 17h16"></path>
    </symbol>
    <symbol id="rental-mark-not-checkable" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8" stroke-dasharray="3 3"></circle>
    </symbol>
    <symbol id="rental-mark-not-applicable-to-date" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M8 12h8"></path>
    </symbol>
    <symbol id="rental-mark-not-entered" viewBox="0 0 24 24">
      <path d="M4 7h16"></path>
      <path d="M4 17h16" stroke-dasharray="2 2.5" stroke-linecap="butt"></path>
    </symbol>
    <symbol id="rental-mark-review-it" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M12 7v6M12 16v1"></path>
    </symbol>
    <symbol id="rental-mark-not-yet-due" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M12 7v5l3 3"></path>
    </symbol>
    <symbol id="rental-mark-depends" viewBox="0 0 24 24">
      <path d="M4 12h6m0 0 8-6m-8 6 8 6"></path>
    </symbol>
    <symbol id="rental-mark-out-of-scope" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="m6.5 6.5 11 11"></path>
    </symbol>
  </svg>

  <header class="result__header">
    <h2 class="result__title" id="result-title" tabindex="-1">
      {tx('rental.result.title')}
    </h2>
    <p class="result__lead" data-lead></p>
  </header>

  <div class="review" data-review>
    <section
      class="item"
      data-out-of-scope
      data-state="out_of_scope"
      aria-labelledby="out-of-scope-title"
      hidden
    >
      <div class="sheet">
        <h3 class="item__title" id="out-of-scope-title">
          {tx('rental.result.out_of_scope')}
        </h3>
        <p class="item__status">
          <svg class="item__mark" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#rental-mark-out-of-scope"></use>
          </svg>
          <span data-out-of-scope-status></span>
        </p>
        <p class="help" data-out-of-scope-reason></p>
      </div>
    </section>

    <section class="item summary" data-in-scope aria-labelledby="summary-title">
      <div class="sheet">
        <h3 class="item__title" id="summary-title">
          {tx('rental.result.summary')}
        </h3>
        <p class="help" data-headline></p>
        <ul class="list" data-totals></ul>
      </div>
    </section>

    <div class="review__items" data-items></div>

    <section class="item" data-in-scope aria-labelledby="information-title">
      <div class="sheet">
        <h3 class="item__title" id="information-title">
          {tx('rental.result.information')}
        </h3>
        <div class="information" data-information></div>
      </div>
    </section>

    <section class="item" data-in-scope aria-labelledby="unchecked-title">
      <div class="sheet">
        <h3 class="item__title" id="unchecked-title">
          {tx('rental.result.unchecked')}
        </h3>
        <ul class="list" data-unchecked></ul>
      </div>
    </section>

    <template data-template="item">
      <section class="item" data-item>
        <span class="item__tab" aria-hidden="true" data-tab-number></span>
        <div class="sheet">
          <h3 class="item__title" data-title></h3>
          <p class="item__status">
            <svg class="item__mark" data-mark viewBox="0 0 24 24" aria-hidden="true">
              <use href="#rental-mark-within-limit"></use>
            </svg>
            <span data-status-text></span>
          </p>
          <p class="item__note" data-depends hidden></p>
          <p class="item__note" data-total-share hidden></p>
          <p class="item__note" data-hint hidden>
            {tx('client.rental.hint.company_landlord')}
          </p>
          <h4 class="rules__title">{tx('rental.result.rules')}</h4>
          <ul class="sources rules" data-rules></ul>
          <div data-detail-slot></div>
        </div>
      </section>
    </template>
    <template data-template="rule">
      <li>
        <a rel="noopener" target="_blank"></a>
        <span class="rules__status" data-rule-status></span>
      </li>
    </template>
    {/* The detail is cloned in only once it may be shown: never present, even hidden, before. */}
    <template data-template="detail">
      <details class="item__detail" data-detail>
        <summary>{tx('rental.result.how')}</summary>
        <div class="readings" data-readings></div>
        <h4 class="rules__title">{tx('rental.result.sources')}</h4>
        <ul class="sources" data-sources></ul>
      </details>
    </template>
    <template data-template="reading">
      <div class="reading">
        <h4 class="reading__title" data-reading-title></h4>
        <dl class="item__figures" data-figures></dl>
        <ol class="list reading__calculation" data-calculation></ol>
      </div>
    </template>
    <template data-template="figure">
      <div>
        <dt></dt>
        <dd></dd>
      </div>
    </template>
    <template data-template="source">
      <li>
        <a rel="noopener" target="_blank"></a>
        <span class="sources__in-force" data-in-force></span>
      </li>
    </template>
    <template data-template="information">
      <details class="information__block">
        <summary data-info-title></summary>
        <p class="help" data-info-text></p>
        <ul class="sources" data-info-links></ul>
      </details>
    </template>
  </div>

  <div class="restart">
    <button class="button button--restart" type="button" data-restart>
      {tx('rental.result.restart')}
    </button>
  </div>
</section>
