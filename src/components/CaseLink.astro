---
import { LANDINGS, landingCopy, type LandingId } from '../content/landings';
import { link, type Lang } from '../i18n/languages';

// A link to a case page, always with that page's own name as its text.
interface Props {
  lang: Lang;
  id: LandingId;
}
const { lang, id } = Astro.props;
---

<a href={link(lang, LANDINGS[id].path.replace(/^\//, ''))}>{landingCopy(lang, id).name}</a>
