---
import PassOffer from './PassOffer.astro';
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  // A build with the documents API offers the letters and, when there is one to sell, the pass.
  documents?: boolean;
}
const { lang, documents = false } = Astro.props;
const tx = (key: Key) => t(lang, key);

// Every state has its own mark beside its words, so none rests on colour alone.
const MARKS: readonly (readonly [string, readonly string[]])[] = [
  ['lender-bears-statute', ['M12 21V4m-5 5 5-5 5 5M3 14h18']],
  ['lender-bears-case-law', ['M12 21V4m-5 5 5-5 5 5']],
  ['not-chargeable', ['M12 21V4m-5 5 5-5 5 5M3 14h18']],
  ['split-explained', ['M8 12h1m3 0h1m3 0h1']],
  ['borrower-bears', ['M4 12h16']],
  ['not-applicable', ['M8 12h8']],
  ['not-applicable-to-date', ['M8 12h8']],
  ['paid-by-bank', ['M4 12h16']],
  ['not-entered', ['M4 7h16']],
  ['review-it', ['M12 7v6M12 16v1']],
  ['above-cap', ['M12 21V4m-5 5 5-5 5 5M3 14h18']],
  ['within-cap', ['M4 12h16']],
  ['not-checkable', ['M8 12h1m3 0h1m3 0h1']],
  ['depends', ['M4 7h16', 'M4 17h8']],
  ['in-deed', ['M5 12l5 5 9-10']],
  ['not-in-deed', ['M8 12h8']],
  ['unreadable', ['M8 12h1m3 0h1m3 0h1']],
];
// Those that sit in a circle, as the other reviews draw them.
const CIRCLED = new Set([
  'split-explained',
  'not-applicable',
  'not-applicable-to-date',
  'review-it',
  'not-checkable',
  'not-in-deed',
  'unreadable',
]);
const channels: readonly Key[] = [
  'mortgage.result.channels_portal',
  'mortgage.result.channels_service',
  'mortgage.result.channels_consumer',
];
---

<section class="result" id="resultado" aria-labelledby="result-title" hidden>
  <svg class="marks" aria-hidden="true" focusable="false">
    {MARKS.map(([id, paths]) => (
      <symbol id={`mortgage-mark-${id}`} viewBox="0 0 24 24">
        {CIRCLED.has(id) && <circle cx="12" cy="12" r="8" />}
        {paths.map((d) => (
          <path d={d} />
        ))}
      </symbol>
    ))}
    <symbol id="mortgage-mark-out-of-scope" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="m6.5 6.5 11 11"></path>
    </symbol>
  </svg>

  <header class="result__header">
    <h2 class="result__title" id="result-title" tabindex="-1">
      {tx('mortgage.result.title')}
    </h2>
    <p class="result__lead" data-lead></p>
  </header>

  <div class="review" data-review>
    <section
      class="item"
      data-out-of-scope
      data-state="out_of_scope"
      aria-labelledby="out-of-scope-title"
      hidden
    >
      <div class="sheet">
        <h3 class="item__title" id="out-of-scope-title">
          {tx('mortgage.result.out_of_scope')}
        </h3>
        <p class="item__status">
          <svg class="item__mark" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#mortgage-mark-out-of-scope"></use>
          </svg>
          <span data-out-of-scope-status></span>
        </p>
        <p class="help" data-out-of-scope-reason></p>
      </div>
    </section>

    {/* The figures by what they rest on, side by side and never added together. */}
    <section class="item" data-in-scope data-totals aria-labelledby="totals-title">
      <div class="sheet">
        <h3 class="item__title" id="totals-title">
          {tx('mortgage.result.totals')}
        </h3>
        <div class="totals">
          <section class="basis" data-total="statute" aria-labelledby="total-statute">
            <h4 class="reading__title" id="total-statute">
              {tx('mortgage.result.total_statute')}
            </h4>
            <p class="basis__amount" data-total-amount></p>
            <p class="item__note">{tx('mortgage.result.total_statute_note')}</p>
            <p class="item__note" data-total-free hidden></p>
          </section>
          <section class="basis" data-total="case_law" aria-labelledby="total-case-law">
            <h4 class="reading__title" id="total-case-law">
              {tx('mortgage.result.total_case_law')}
            </h4>
            <p class="basis__amount" data-total-amount></p>
            <p class="item__note" data-total-interest hidden></p>
            <p class="item__note">{tx('mortgage.result.total_case_law_note')}</p>
            <p class="item__note" data-total-explained hidden>
              {tx('mortgage.result.total_case_law_explained')}
            </p>
          </section>
          <section class="basis" data-total="fees" aria-labelledby="total-fees" hidden>
            <h4 class="reading__title" id="total-fees">
              {tx('mortgage.result.total_fees')}
            </h4>
            <p class="basis__amount" data-total-amount></p>
            <p class="item__note">{tx('mortgage.result.total_fees_note')}</p>
            <p class="item__note" data-total-more hidden>
              {tx('mortgage.result.total_fees_more')}
            </p>
          </section>
        </div>
        <p class="help">{tx('mortgage.result.totals_apart')}</p>
      </div>
    </section>

    <section class="results-group" data-in-scope aria-labelledby="expenses-title">
      <h3 class="results-group__title" id="expenses-title">
        {tx('mortgage.result.expenses')}
      </h3>
      <ul class="list" data-expenses-note></ul>
      <div class="review__items" data-expenses></div>
    </section>

    <section class="results-group" data-in-scope aria-labelledby="fees-title">
      <h3 class="results-group__title" id="fees-title">
        {tx('mortgage.result.fees')}
      </h3>
      <div class="review__items" data-fees></div>
    </section>

    <section class="results-group" data-in-scope aria-labelledby="flags-title">
      <h3 class="results-group__title" id="flags-title">
        {tx('mortgage.result.flags')}
      </h3>
      <p class="results-group__note">{tx('mortgage.result.flags_note')}</p>
      <div class="review__items" data-flags></div>
    </section>

    {documents && <PassOffer lang={lang} review="mortgage" />}

    <section class="item" data-in-scope aria-labelledby="information-title">
      <div class="sheet">
        <h3 class="item__title" id="information-title">
          {tx('mortgage.result.information')}
        </h3>
        <div class="information" data-information></div>
      </div>
    </section>

    <section class="item" data-in-scope aria-labelledby="unchecked-title">
      <div class="sheet">
        <h3 class="item__title" id="unchecked-title">
          {tx('mortgage.result.unchecked')}
        </h3>
        <ul class="list" data-unchecked></ul>
      </div>
    </section>

    <section class="item" aria-labelledby="channels-title">
      <div class="sheet">
        <h3 class="item__title" id="channels-title">
          {tx('mortgage.result.channels')}
        </h3>
        <ul class="list">
          {channels.map((key) => (
            <li>{tx(key)}</li>
          ))}
        </ul>
      </div>
    </section>

    <template data-template="item">
      <section class="item" data-item>
        <span class="item__tab" aria-hidden="true" data-tab-number></span>
        <div class="sheet">
          <h4 class="item__title" data-title></h4>
          <p class="item__status">
            <svg class="item__mark" data-mark viewBox="0 0 24 24" aria-hidden="true">
              <use href="#mortgage-mark-review-it"></use>
            </svg>
            <span data-status-text></span>
          </p>
          <p class="item__note" data-depends hidden></p>
          <h5 class="rules__title" data-how>
            {tx('mortgage.result.how')}
          </h5>
          <ol class="list reading__calculation" data-calculation></ol>
          <div class="readings" data-readings></div>
          <h5 class="rules__title" data-rules-title>
            {tx('mortgage.result.rules')}
          </h5>
          <ul class="sources rules" data-rules></ul>
        </div>
      </section>
    </template>
    <template data-template="reading">
      <div class="reading">
        <h5 class="reading__title" data-reading-title></h5>
        <p class="item__note" data-reading-status></p>
        <ol class="list reading__calculation" data-calculation></ol>
      </div>
    </template>
    <template data-template="rule">
      <li>
        <a rel="noopener" target="_blank"></a>
        <span class="rules__status" data-rule-status></span>
      </li>
    </template>
    <template data-template="information">
      <details class="information__block">
        <summary data-info-title></summary>
        <p class="help" data-info-text></p>
        <ul class="sources sources--wrap" data-info-links></ul>
      </details>
    </template>
  </div>

  <div class="restart">
    <button class="button button--restart" type="button" data-restart>
      {tx('mortgage.result.restart')}
    </button>
  </div>
</section>

<style>
  /* What the law settles and what depends on a judge stand apart: a whole line and a broken one. */
  .totals {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .basis {
    padding: 0.75rem 0.875rem 0.125rem;
    border: 2px solid color-mix(in oklab, var(--sheet-ink) 40%, transparent);
    border-radius: 0.375rem;
  }
  .basis[data-total='case_law'] {
    border-style: dashed;
  }
  .basis__amount {
    margin: 0 0 0.5rem;
    font: 620 1.375rem / 1.2 var(--f-mono);
    font-stretch: 87.5%;
    font-variant-numeric: tabular-nums;
  }
  .results-group {
    display: grid;
    gap: 1rem;
  }
  .results-group__title {
    margin: 0.5rem 0 0;
    color: var(--on-ground);
    font-size: 1.25rem;
    font-weight: 750;
  }
  .results-group__note {
    margin: -0.5rem 0 0;
    color: var(--on-ground);
    font: 400 var(--t-help) / var(--l-help) var(--f-serif);
  }
  .results-group .list:empty {
    display: none;
  }
  .results-group > .list {
    color: var(--on-ground);
  }
  /* What the law puts on the lender, or charged over a cap, stands out in ink; a court's split
     keeps the plain status. */
  .item[data-state='lender_bears_statute'] .item__status,
  .item[data-state='not_chargeable'] .item__status,
  .item[data-state='above_cap'] .item__status,
  .item[data-state='out_of_scope'] .item__status {
    background: var(--sheet-ink);
    color: var(--field-fill);
  }
</style>
