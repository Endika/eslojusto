---
import { t, type Clave } from '../i18n';
import type { Idioma } from '../i18n/idiomas';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const tx = (clave: Clave) => t(idioma, clave);
const vidaLaboral =
  'https://sede.seg-social.gob.es/wps/portal/sede/sede/Ciudadanos/Informes+y+Certificados/201864';
---

<section class="resultado" id="resultado" aria-labelledby="resultado-titulo" hidden>
  <svg class="marcas" aria-hidden="true" focusable="false">
    <symbol id="marca-por-debajo" viewBox="0 0 24 24">
      <path d="M4 7h16M4 17h8"></path>
      <path d="M15 17h5" stroke-dasharray="2 2.5" stroke-linecap="butt"></path>
    </symbol>
    <symbol id="marca-coincide" viewBox="0 0 24 24">
      <path d="M4 7h16M4 17h16"></path>
    </symbol>
    <symbol id="marca-por-encima" viewBox="0 0 24 24">
      <path d="M4 7h12M4 17h16"></path>
    </symbol>
    <symbol id="marca-descuento-mayor" viewBox="0 0 24 24">
      <path d="M12 21V4m-5 5 5-5 5 5M3 14h18"></path>
    </symbol>
    <symbol id="marca-descuento-dentro" viewBox="0 0 24 24">
      <path d="M4 7h16M4 17h16"></path>
    </symbol>
    <symbol id="marca-no-comprobable" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8" stroke-dasharray="3 3"></circle>
    </symbol>
    <symbol id="marca-sin-indemnizacion" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M8 12h8"></path>
    </symbol>
    <symbol id="marca-paro-si" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M12 8v8M8 12h8"></path>
    </symbol>
    <symbol id="marca-sin-cifra-empresa" viewBox="0 0 24 24">
      <path d="M4 7h16"></path>
      <path d="M4 17h16" stroke-dasharray="2 2.5" stroke-linecap="butt"></path>
    </symbol>
  </svg>

  <header class="resultado__cabecera">
    <h2 class="resultado__titulo" id="resultado-titulo" tabindex="-1">
      {tx('resultado.titulo')}
    </h2>
    <p class="resultado__entrada">{tx('resultado.entrada')}</p>
  </header>

  <div class="revision" data-revision>
    <div class="revision__partidas" data-partidas></div>

    <section class="partida paro" data-paro data-tono="vacaciones" aria-labelledby="paro-titulo">
      <span class="partida__pestana" aria-hidden="true">
        04
      </span>
      <div class="hoja">
        <h3 class="partida__titulo" id="paro-titulo">
          {tx('resultado.paro')}
        </h3>
        <p class="partida__nota" data-paro-si>
          {tx('resultado.paro_entrada')}
        </p>
        <p class="partida__estado">
          <svg class="partida__marca" data-paro-marca viewBox="0 0 24 24" aria-hidden="true">
            <use href="#marca-paro-si"></use>
          </svg>
          <span data-paro-estado-texto></span>
        </p>
        <p class="ayuda paro__motivo" data-paro-motivo></p>
        <p class="ayuda" data-paro-no>
          {tx('resultado.paro_causa_justa')}
        </p>
        <div class="paro__bloques" data-paro-si>
          <p class="ayuda">{tx('resultado.paro_requisitos')}</p>
          <h4 class="paro__apartado">{tx('resultado.paro_cuanto')}</h4>
          <p class="ayuda" data-paro-cuantia></p>
          <p class="partida__nota" data-paro-jornada>
            {tx('resultado.paro_jornada')}
          </p>
          <p class="partida__nota" data-paro-sin-hijos hidden></p>
          <p class="partida__nota" data-paro-descuento></p>
          <h4 class="paro__apartado">{tx('resultado.paro_cuanto_tiempo')}</h4>
          <p class="ayuda" data-paro-duracion></p>
          <p class="partida__nota" data-paro-duracion-nota></p>
          <h4 class="paro__apartado">{tx('resultado.paro_cotizado')}</h4>
          <p class="ayuda" data-paro-carencia></p>
          <p class="partida__nota">
            {tx('resultado.paro_vida_laboral')}{' '}
            <a class="paro__enlace" href={vidaLaboral} rel="noopener" target="_blank">
              {tx('resultado.paro_vida_laboral_enlace')}
            </a>
            .
          </p>
          <h4 class="paro__apartado">{tx('resultado.paro_plazo')}</h4>
          <p class="ayuda">{tx('resultado.paro_plazo_texto')}</p>
        </div>
        <details class="partida__detalle">
          <summary>{tx('resultado.como_se_calcula')}</summary>
          <p class="ayuda" data-paro-si>
            {tx('resultado.paro_calculo')}
          </p>
          <ul class="fuentes" data-paro-fuentes></ul>
        </details>
      </div>
    </section>

    <section class="partida" aria-labelledby="no-revisado-titulo">
      <div class="hoja">
        <h3 class="partida__titulo" id="no-revisado-titulo">
          {tx('resultado.no_revisado')}
        </h3>
        <ul class="lista" data-no-revisado></ul>
      </div>
    </section>

    <section class="partida" data-tono="legal" aria-labelledby="propuesta-titulo">
      <span class="partida__pestana" aria-hidden="true">
        ET
      </span>
      <div class="hoja">
        <h3 class="partida__titulo" id="propuesta-titulo">
          {tx('resultado.propuesta')}
        </h3>
        <p class="ayuda">{tx('resultado.propuesta_1')}</p>
        <p class="ayuda">{tx('resultado.propuesta_2')}</p>
        <p class="ayuda">{tx('resultado.propuesta_3')}</p>
        <p class="fuente">
          <a
            href="https://www.boe.es/buscar/act.php?id=BOE-A-2015-11430#a49"
            rel="noopener"
            target="_blank"
          >
            {tx('resultado.propuesta_fuente')}
          </a>
        </p>
      </div>
    </section>

    <template data-plantilla="partida">
      <section class="partida" data-partida>
        <span class="partida__pestana" aria-hidden="true" data-pestana-numero></span>
        <div class="hoja">
          <h3 class="partida__titulo" data-titulo></h3>
          <dl class="partida__cifras" data-cifras>
            <div>
              <dt>{tx('resultado.en_tu_finiquito')}</dt>
              <dd data-empresa></dd>
            </div>
            <div>
              <dt data-rango-etiqueta></dt>
              <dd data-rango></dd>
            </div>
          </dl>
          <p class="partida__nota partida__nota--segun" data-segun hidden>
            <strong>{tx('resultado.segun_tu_dato')}</strong>
            {tx('resultado.segun_tu_dato_nota')}
          </p>
          <p class="partida__estado">
            <svg class="partida__marca" data-marca viewBox="0 0 24 24" aria-hidden="true">
              <use href="#marca-coincide"></use>
            </svg>
            <span data-estado-texto></span>
          </p>
          <p class="fuente partida__cita" data-cita hidden></p>
          <p class="partida__nota" data-convenio hidden>
            {tx('cli.convenio_mejora')}
          </p>
          <p class="partida__nota" data-referencia hidden></p>
          <details class="partida__detalle" data-detalle>
            <summary>{tx('resultado.como_se_calcula')}</summary>
            <p class="ayuda" data-calculo></p>
            <ul class="fuentes" data-fuentes></ul>
          </details>
        </div>
      </section>
    </template>
    <template data-plantilla="fuente">
      <li>
        <a rel="noopener" target="_blank"></a>
        <span class="fuentes__vigencia" data-vigencia hidden></span>
      </li>
    </template>
  </div>

  <div class="reinicio">
    <button class="boton boton--reinicio" type="button" data-reiniciar>
      {tx('resultado.reiniciar')}
    </button>
  </div>
</section>
