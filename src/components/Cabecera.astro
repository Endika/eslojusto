---
import Logo from './Logo.astro';
import { t } from '../i18n';
import { enlace, type Idioma } from '../i18n/idiomas';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
---

<header class="cabecera">
  <a class="marca" href={enlace(idioma)}>
    <Logo class="logo--compacto" />
    <Logo variante="completo" class="logo--completo" />
  </a>
  <button class="tema" type="button" data-tema aria-label={t(idioma, 'cli.tema.a_oscuro')}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <circle
        cx="12"
        cy="12"
        r="8.25"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
      ></circle>
      <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor"></path>
    </svg>
  </button>
</header>
