---
import PassOffer from './PassOffer.astro';
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  // A build with the documents API offers the letters and, when there is one to sell, the pass.
  documents?: boolean;
}
const { lang, documents = false } = Astro.props;
const tx = (key: Key) => t(lang, key);

// Every state has its own mark beside its words, so none rests on colour alone.
const MARKS: readonly (readonly [string, readonly string[]])[] = [
  ['matches', ['M4 7h16M4 17h16']],
  ['contract-lower', ['M12 3v17m-5-5 5 5 5-5']],
  ['contract-higher', ['M12 21V4m-5 5 5-5 5 5']],
  ['contract-missing', ['M8 12h1m3 0h1m3 0h1']],
  ['unsolvable', ['M12 7v6M12 16v1']],
  ['above-general-cap', ['M12 21V4m-5 5 5-5 5 5M3 14h18']],
  ['within-cap', ['M4 12h16']],
  ['charged-without-basis', ['M12 21V4m-5 5 5-5 5 5M3 14h18']],
  ['nothing-charged', ['M4 12h16']],
  ['open', ['M12 7v5l3 3']],
  ['ended', ['M8 12h8']],
  ['not-started', ['M8 12h1m3 0h1m3 0h1']],
  ['review-it', ['M12 7v6M12 16v1']],
  ['not-entered', ['M4 7h16']],
  ['depends', ['M4 7h16', 'M4 17h8']],
  ['above', ['M12 21V4m-5 5 5-5 5 5M3 14h18']],
  ['edge', ['M4 12h16', 'M12 7v10']],
  ['below', ['M12 3v17m-5-5 5 5 5-5M3 10h18']],
  ['distance-only', ['M4 12h16', 'M4 7v10M20 7v10']],
  ['not-published', ['M8 12h1m3 0h1m3 0h1']],
  ['no-data', ['M8 12h1m3 0h1m3 0h1']],
];
// Those that sit in a circle, as the other reviews draw them.
const CIRCLED = new Set([
  'contract-missing',
  'unsolvable',
  'open',
  'ended',
  'not-started',
  'review-it',
  'not-published',
  'no-data',
]);
const channels: readonly Key[] = [
  'credit.result.channels_portal',
  'credit.result.channels_service',
  'credit.result.channels_consumer',
];
---

<section class="result" id="resultado" aria-labelledby="result-title" hidden>
  <svg class="marks" aria-hidden="true" focusable="false">
    {MARKS.map(([id, paths]) => (
      <symbol id={`credit-mark-${id}`} viewBox="0 0 24 24">
        {CIRCLED.has(id) && <circle cx="12" cy="12" r="8" />}
        {paths.map((d) => (
          <path d={d} />
        ))}
      </symbol>
    ))}
    <symbol id="credit-mark-out-of-scope" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="m6.5 6.5 11 11"></path>
    </symbol>
  </svg>

  <header class="result__header">
    <h2 class="result__title" id="result-title" tabindex="-1">
      {tx('credit.result.title')}
    </h2>
    <p class="result__lead" data-lead></p>
  </header>

  <div class="review" data-review>
    <section
      class="item"
      data-out-of-scope
      data-state="out_of_scope"
      aria-labelledby="out-of-scope-title"
      hidden
    >
      <div class="sheet">
        <h3 class="item__title" id="out-of-scope-title">
          {tx('credit.result.out_of_scope')}
        </h3>
        <p class="item__status">
          <svg class="item__mark" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#credit-mark-out-of-scope"></use>
          </svg>
          <span data-out-of-scope-status></span>
        </p>
        <p class="help" data-out-of-scope-reason></p>
      </div>
    </section>

    <div class="review__items" data-items></div>

    {documents && <PassOffer lang={lang} review="credit" />}

    <section class="item" data-in-scope aria-labelledby="information-title">
      <div class="sheet">
        <h3 class="item__title" id="information-title">
          {tx('credit.result.information')}
        </h3>
        <div class="information" data-information></div>
      </div>
    </section>

    <section class="item" data-in-scope aria-labelledby="unchecked-title">
      <div class="sheet">
        <h3 class="item__title" id="unchecked-title">
          {tx('credit.result.unchecked')}
        </h3>
        <ul class="list" data-unchecked></ul>
      </div>
    </section>

    <section class="item" aria-labelledby="channels-title">
      <div class="sheet">
        <h3 class="item__title" id="channels-title">
          {tx('credit.result.channels')}
        </h3>
        <ul class="list">
          {channels.map((key) => (
            <li>{tx(key)}</li>
          ))}
        </ul>
      </div>
    </section>

    <template data-template="item">
      <section class="item" data-item>
        <span class="item__tab" aria-hidden="true" data-tab-number></span>
        <div class="sheet">
          <h3 class="item__title" data-title></h3>
          <p class="item__status">
            <svg class="item__mark" data-mark viewBox="0 0 24 24" aria-hidden="true">
              <use href="#credit-mark-matches"></use>
            </svg>
            <span data-status-text></span>
          </p>
          <p class="item__note" data-depends hidden></p>
          <h4 class="rules__title">{tx('credit.result.how')}</h4>
          <ol class="list reading__calculation" data-calculation></ol>
          <div class="readings" data-readings></div>
          <h4 class="rules__title" data-rules-title>
            {tx('credit.result.rules')}
          </h4>
          <ul class="sources rules" data-rules></ul>
        </div>
      </section>
    </template>
    <template data-template="reading">
      <div class="reading">
        <h4 class="reading__title" data-reading-title></h4>
        <p class="item__note" data-reading-status></p>
        <ol class="list reading__calculation" data-calculation></ol>
      </div>
    </template>
    <template data-template="rule">
      <li>
        <a rel="noopener" target="_blank"></a>
        <span class="rules__status" data-rule-status></span>
      </li>
    </template>
    <template data-template="information">
      <details class="information__block">
        <summary data-info-title></summary>
        <p class="help" data-info-text></p>
        <ul class="sources sources--wrap" data-info-links></ul>
      </details>
    </template>
  </div>

  <div class="restart">
    <button class="button button--restart" type="button" data-restart>
      {tx('credit.result.restart')}
    </button>
  </div>
</section>
