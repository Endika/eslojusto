---
import logo from './logo.json';

interface Props {
  variant?: 'compact' | 'full';
  class?: string;
}
const { variant = 'compact', class: className } = Astro.props;
const v = logo[variant];
const domain = 'domain' in v ? v.domain : null;
---

<svg
  class:list={['logo', className]}
  viewBox={`0 0 ${v.width} ${v.height}`}
  role="img"
  aria-label="eslojusto.es"
  focusable="false"
>
  <g transform={v.mark}>
    <g class="logo__mark" set:html={logo.mark} />
  </g>
  <path d={v.wordmark} fill="currentColor"></path>
  {domain && <path d={domain} fill="currentColor" />}
</svg>
