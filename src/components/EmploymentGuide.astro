---
import FigureTable from './FigureTable.astro';
import { EMPLOYMENT_NORMS } from '../engine/employment/data/norms';
import { MINIMUM_WAGE } from '../engine/employment/data/minimum-wage';
import { formatLongDay } from '../content/rent-indices';
import { employmentGuide, minimumWageSummary } from '../content/employment-guide';
import { employmentFaqEntries } from '../content/employment-faq';
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  // The day the page's rules were last checked, ISO.
  checkedOn: string;
  documents?: boolean;
}
const { lang, checkedOn, documents = false } = Astro.props;
const tx = (key: Key) => t(lang, key);

const tables = { checkedOn, minimumWage: MINIMUM_WAGE };
const blocks = employmentGuide(lang, EMPLOYMENT_NORMS, tables);
const wage = minimumWageSummary(lang, MINIMUM_WAGE, EMPLOYMENT_NORMS, checkedOn);
const latest = wage.lines[0];
if (!latest) throw new Error('The employment guide needs the minimum wage table.');
const faq = employmentFaqEntries(lang, EMPLOYMENT_NORMS, { ...tables, documents });
---

<article class="guide" data-tone="legal" aria-labelledby="guide-title">
  <header class="guide__head">
    <h2 class="guide__title" id="guide-title">
      {tx('employment.guide.title')}
    </h2>
    <p class="guide__lead">{tx('employment.guide.lead')}</p>
    <p class="guide__sources">
      <span>{t(lang, 'employment.reviewed', { fecha: formatLongDay(checkedOn) })}</span>
      <span>
        {tx('employment.guide.sources')}:{' '}
        <a href={EMPLOYMENT_NORMS.et.url}>{tx('employment.guide.source_et')}</a> ·{' '}
        <a href={latest.url}>
          {t(lang, 'employment.guide.source_smi', { anio: String(latest.year) })}
        </a>{' '}
        · <a href={EMPLOYMENT_NORMS.rd723_2026.url}>{tx('employment.guide.source_rd723')}</a>
      </span>
      <a href={link('es', 'aviso-legal/')}>{tx('employment.guide.who')}</a>
    </p>
  </header>

  <div class="guide__sheets">
    {blocks.map(({ id, anchor, title, paragraphs, list, quotes, sources, links }) => (
      <section class="sheet sheet--text" data-guide={id}>
        <h3 id={anchor}>{title}</h3>
        <p>{paragraphs[0]}</p>
        {list.length > 0 && (
          <ul>
            {list.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
        {id === 'minimum_wage' && (
          <>
            <p class="status" role="note">
              {wage.current}
            </p>
            <FigureTable id="g-smi-tabla">
              <Fragment slot="caption">{tx('employment.guide.minimum_wage.table')}</Fragment>
              <thead>
                <tr>
                  <th scope="col">{tx('employment.guide.minimum_wage.year')}</th>
                  <th scope="col">{tx('employment.guide.minimum_wage.monthly')}</th>
                  <th scope="col">{tx('employment.guide.minimum_wage.twelve')}</th>
                  <th scope="col">{tx('employment.guide.minimum_wage.annual')}</th>
                  <th scope="col">{tx('employment.guide.minimum_wage.daily')}</th>
                  <th scope="col">{tx('employment.guide.minimum_wage.norm')}</th>
                </tr>
              </thead>
              <tbody>
                {wage.lines.map((row) => (
                  <tr data-year={row.year}>
                    <th scope="row">{row.year}</th>
                    <td>{row.monthly}</td>
                    <td>{row.twelve}</td>
                    <td>{row.annual}</td>
                    <td>{row.daily}</td>
                    <td>
                      <a href={row.url}>{row.norm}</a>
                      <span class="figures-note rules__status" data-status={row.status.statusCode}>
                        {row.status.status}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </FigureTable>
            <p>{tx('employment.guide.minimum_wage.twelve_note')}</p>
          </>
        )}
        {quotes.map((q) => (
          <>
            {q.lead && <p>{q.lead}</p>}
            <div class="literal">
              <p class="literal__intro">{q.intro}</p>
              <blockquote class="quote">
                <p>«{q.text}»</p>
              </blockquote>
              <p class="literal__link">
                <a href={q.url}>{t(lang, 'employment.guide.quote_link', { cita: q.citation })}</a>
              </p>
            </div>
          </>
        ))}
        {paragraphs.slice(1).map((text) => (
          <p>{text}</p>
        ))}
        <h4 class="rules__title">{tx('employment.guide.norms')}</h4>
        <ul class="sources sources--wrap">
          {sources.map((s) => (
            <li>
              <a href={s.url}>{s.citation}</a>{' '}
              <span class="rules__status" data-status={s.statusCode}>
                {s.status}
              </span>
            </li>
          ))}
          {links.map(({ label, url }) => (
            <li>
              <a href={url}>{label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="sheet sheet--text">
      <h2 id="g-preguntas">{tx('employment.guide.faq')}</h2>
      <div class="faq-list">
        {faq.map(({ anchor, question, answer }) => (
          <details class="faq-item" id={anchor} data-help>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</article>
