---
import PassOffer from './PassOffer.astro';
import { t, type Key } from '../i18n';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  review: 'electricity' | 'telecom';
  // A build with the documents API reads bills and offers the pass; on the electricity review it
  // keeps «tu año» too.
  documents?: boolean;
}
const { lang, review, documents = false } = Astro.props;
const tx = (key: Key) => t(lang, key);

const UP = 'M12 21V4m-5 5 5-5 5 5M3 14h18';
const DOWN = 'M12 3v17m-5-5 5 5 5-5M3 10h18';
const DOTS = 'M8 12h1m3 0h1m3 0h1';
const ALERT = 'M12 7v6M12 16v1';
// Every state has its own mark beside its words, so none rests on colour alone.
const MARKS: readonly (readonly [string, readonly string[]])[] = [
  ['matches', ['M4 7h16M4 17h16']],
  ['within-limit', ['M4 12h16']],
  ['does-not-add-up', ['M4 7h16', 'M7 19 17 5']],
  ['differs-from-official', ['M4 7h16', 'M7 19 17 5']],
  ['above-regulated-price', [UP]],
  ['wrong-rate-for-date', [UP]],
  ['different-base', [UP]],
  ['discount-lower', [DOWN]],
  ['not-allowed-in-pvpc', [UP]],
  ['not-allowed', [UP]],
  ['paid-over', [UP]],
  ['charged-after-exit', [UP]],
  ['above-legal-maximum', ['M12 21V4m-5 5 5-5 5 5']],
  ['tariff-not-allowed', ['M8 12h8']],
  ['not-applicable', ['M8 12h8']],
  ['not-on-bill', ['M4 7h16']],
  ['review-it', [ALERT]],
  ['not-checkable', [DOTS]],
  ['pending-official-data', [DOTS]],
  ['information', ['M12 11v6M12 7v1']],
  ['depends', ['M4 7h16', 'M4 17h8']],
];
// Those that sit in a circle, as the other reviews draw them.
const CIRCLED = new Set([
  'tariff-not-allowed',
  'not-applicable',
  'review-it',
  'not-checkable',
  'pending-official-data',
  'information',
]);
---

<section class="result" id="resultado" aria-labelledby="result-title" hidden>
  <svg class="marks" aria-hidden="true" focusable="false">
    {MARKS.map(([id, paths]) => (
      <symbol id={`bills-mark-${id}`} viewBox="0 0 24 24">
        {CIRCLED.has(id) && <circle cx="12" cy="12" r="8" />}
        {paths.map((d) => (
          <path d={d} />
        ))}
      </symbol>
    ))}
    <symbol id="bills-mark-out-of-scope" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="m6.5 6.5 11 11"></path>
    </symbol>
  </svg>

  <header class="result__header">
    <h2 class="result__title" id="result-title" tabindex="-1">
      {tx('bills.result.title')}
    </h2>
    <p class="result__lead" data-lead></p>
  </header>

  <div class="review" data-review>
    <section
      class="item"
      data-out-of-scope
      data-state="out_of_scope"
      aria-labelledby="out-of-scope-title"
      hidden
    >
      <div class="sheet">
        <h3 class="item__title" id="out-of-scope-title">
          {tx('bills.result.out_of_scope')}
        </h3>
        <p class="item__status">
          <svg class="item__mark" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#bills-mark-out-of-scope"></use>
          </svg>
          <span data-out-of-scope-status></span>
        </p>
        <p class="help" data-out-of-scope-reason></p>
      </div>
    </section>

    {/* What is over the norm and what is charged short, side by side and never set against each
    other. */}
    <section class="item" data-in-scope data-totals aria-labelledby="totals-title">
      <div class="sheet">
        <h3 class="item__title" id="totals-title">
          {tx('bills.result.totals')}
        </h3>
        <p class="totals__amount" data-total-counted></p>
        <p class="item__note">{tx(`bills.result.totals_note.${review}`)}</p>
        <p class="item__note" data-total-up-to hidden></p>
        <p class="item__note totals__under" data-total-under hidden></p>
        <p class="item__note" data-recurring hidden>
          {tx('bills.result.recurring')}
        </p>
      </div>
    </section>

    {/* Right under the totals on the telecom review, so it is not lost among the items. */}
    {documents && review === 'telecom' && (
      <PassOffer lang={lang} review="telecom" offer="client.bills.telecom.pass.offer" />
    )}

    <div class="review__items" data-items></div>

    {documents && review === 'electricity' && (
      <section class="item basket" data-basket aria-labelledby="basket-title" hidden>
        <div class="sheet">
          <h3 class="item__title" id="basket-title" data-basket-title></h3>
          <p class="help">{tx('bills.basket.memory')}</p>
          <ul class="list" data-basket-bills></ul>
          <div data-basket-year hidden>
            <h4 class="rules__title">{tx('bills.basket.year')}</h4>
            <p class="totals__amount" data-basket-counted></p>
            <p class="item__note">{tx('bills.basket.year_note')}</p>
            <p class="item__note" data-basket-up-to hidden></p>
            <p class="item__note totals__under" data-basket-under hidden></p>
            <p class="item__note" data-basket-recurring hidden></p>
            <p class="item__note basket__estimate" data-basket-estimate hidden></p>
          </div>
          <div class="basket__actions">
            <button class="button button--sheet" type="button" data-basket-next hidden></button>
            <button class="button button--sheet" type="button" data-basket-add>
              {tx('bills.basket.add')}
            </button>
          </div>
        </div>
      </section>
    )}

    {documents && review === 'electricity' && (
      <PassOffer lang={lang} review="electricity" offer="client.bills.pass.offer" />
    )}

    {review === 'electricity' ? (
      <section class="item" data-in-scope aria-labelledby="compare-title">
        <div class="sheet">
          <h3 class="item__title" id="compare-title">
            {tx('bills.result.compare')}
          </h3>
          <p class="help">{tx('bills.result.compare_text')}</p>
          <ul class="sources">
            <li>
              <a href="https://comparador.cnmc.gob.es/" rel="noopener" target="_blank">
                {tx('bills.result.compare_link')}
              </a>
            </li>
          </ul>
        </div>
      </section>
    ) : (
      <section class="item" data-in-scope aria-labelledby="channels-title">
        <div class="sheet">
          <h3 class="item__title" id="channels-title">
            {tx('bills.result.channels')}
          </h3>
          <p class="help">{tx('bills.result.channels_text')}</p>
          <ul class="sources">
            <li>
              <a href="https://usuariosteleco.digital.gob.es/" rel="noopener" target="_blank">
                {tx('bills.result.channels_link')}
              </a>
            </li>
          </ul>
        </div>
      </section>
    )}

    <section class="item" data-in-scope aria-labelledby="unchecked-title">
      <div class="sheet">
        <h3 class="item__title" id="unchecked-title">
          {tx('bills.result.unchecked')}
        </h3>
        <ul class="list" data-unchecked></ul>
      </div>
    </section>

    <template data-template="item">
      <section class="item" data-item>
        <span class="item__tab" aria-hidden="true" data-tab-number></span>
        <div class="sheet">
          <h3 class="item__title" data-title></h3>
          <p class="item__status" data-verdict>
            <svg class="item__mark" data-mark viewBox="0 0 24 24" aria-hidden="true">
              <use href="#bills-mark-matches"></use>
            </svg>
            <span data-status-text></span>
          </p>
          <p class="item__note" data-depends hidden></p>
          <h4 class="rules__title">{tx('bills.result.how')}</h4>
          <ol class="list reading__calculation" data-calculation></ol>
          <div class="readings" data-readings></div>
          <h4 class="rules__title" data-rules-title>
            {tx('bills.result.rules')}
          </h4>
          <ul class="sources rules" data-rules></ul>
          <h4 class="rules__title" data-rows-title>
            {tx('bills.result.rows')}
          </h4>
          <ul class="sources rules" data-rows></ul>
        </div>
      </section>
    </template>
    <template data-template="reading">
      <div class="reading">
        <h4 class="reading__title" data-reading-title></h4>
        <p class="item__note" data-reading-status></p>
        <ol class="list reading__calculation" data-calculation></ol>
      </div>
    </template>
    <template data-template="rule">
      <li>
        <a rel="noopener" target="_blank"></a>
        <span class="rules__status" data-rule-status></span>
      </li>
    </template>
  </div>

  <div class="restart">
    <button class="button button--restart" type="button" data-restart>
      {tx('bills.result.restart')}
    </button>
  </div>
</section>

<style>
  .totals__amount {
    margin: 0 0 0.5rem;
    font: 620 1.375rem / 1.2 var(--f-mono);
    font-stretch: 87.5%;
    font-variant-numeric: tabular-nums;
  }
  .basket__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
  }
  /* An estimate, never a figure of the bills: it reads as a note, apart from the total. */
  .basket__estimate {
    font-style: italic;
  }
  /* What is charged short reads as plainly as what is charged over, never smaller. */
  .totals__under {
    font-weight: 620;
  }
  /* A difference in euros the norm backs stands out in ink; a doubt keeps the plain status. */
  .item[data-state='above_regulated_price'] .item__status,
  .item[data-state='wrong_rate_for_date'] .item__status,
  .item[data-state='different_base'] .item__status,
  .item[data-state='discount_lower'] .item__status,
  .item[data-state='not_allowed_in_pvpc'] .item__status,
  .item[data-state='not_allowed'] .item__status,
  .item[data-state='charged_after_exit'] .item__status {
    background: var(--sheet-ink);
    color: var(--field-fill);
  }
</style>
