---
import Logo from './Logo.astro';
import { t } from '../i18n';
import { link, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<header class="header">
  <a class="brand" href={link(lang)}>
    <Logo class="logo--compact" />
    <Logo variant="full" class="logo--full" />
  </a>
  <button
    class="theme-toggle"
    type="button"
    data-theme-toggle
    aria-label={t(lang, 'client.theme.to_dark')}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <circle
        cx="12"
        cy="12"
        r="8.25"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
      ></circle>
      <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor"></path>
    </svg>
  </button>
</header>
