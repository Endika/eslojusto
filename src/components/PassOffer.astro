---
import { t, type Key } from '../i18n';
import { link, type Lang } from '../i18n/languages';
import PassLetter from './PassLetter.astro';

// The pass for the PDF report and the letter, offered in the result when an item falls short, then
// standing out from the result around it. The final pay's is also sold quietly when nothing falls
// short, under words that say there is no need to pay.
// Rendered only in a build with the documents API, with its own styles. On the rental review the
// same pass unlocks each item's detail too, and its letters are two, each shown only when the
// review has figures for it. On the contract and credit reviews the letters that only ask for
// information sit outside the paid part and download without a pass, under their own title when
// there is nothing to sell; so does the mortgage review's request for its documents. The insurance
// review never sells the pass: its one letter only tells the insurer, and a pass already held
// downloads the report. The bills reviews each say in their own words what the pass is for:
// `offer` is the key of that pitch, which the others keep as it was. The electricity review's one
// letter carries figures and sits among the paid downloads; the telecom review's letter about
// leaving after a change of conditions carries none and downloads free, like the contract's.
interface Props {
  lang: Lang;
  review?:
    | 'final_pay'
    | 'rental'
    | 'employment'
    | 'credit'
    | 'insurance'
    | 'mortgage'
    | 'electricity'
    | 'telecom';
  offer?: Key;
}
const { lang, review = 'final_pay', offer } = Astro.props;
const RENTAL: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'rental.pass.title',
  'documents.pass.text': 'rental.pass.text',
  'documents.pass.price': 'rental.pass.price',
  'documents.pass.waiver': 'rental.pass.waiver',
  'documents.pass.paid_help': 'rental.pass.paid_help',
  'documents.pass.letter_note': 'rental.pass.letter_note',
  'documents.letter.legend': 'rental.letter.legend',
  'documents.letter.privacy': 'rental.letter.privacy',
};
const EMPLOYMENT: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'employment.pass.title',
  'documents.pass.text': 'employment.pass.text',
  'documents.pass.price': 'employment.pass.price',
  'documents.pass.waiver': 'employment.pass.waiver',
  'documents.pass.paid_help': 'employment.pass.paid_help',
  'documents.pass.letter_note': 'employment.pass.letter_note',
  'documents.letter.legend': 'employment.letter.legend',
  'documents.letter.privacy': 'employment.letter.privacy',
  'documents.letter.id': 'employment.letter.id',
};
const CREDIT: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'credit.pass.title',
  'documents.pass.text': 'credit.pass.text',
  'documents.pass.price': 'credit.pass.price',
  'documents.pass.letter_note': 'credit.pass.letter_note',
  'documents.letter.legend': 'credit.letter.legend',
  'documents.letter.privacy': 'credit.letter.privacy',
  'documents.letter.id': 'credit.letter.id',
  'documents.letter.company': 'credit.letter.company',
  'documents.letter.reference': 'credit.letter.reference',
};
const INSURANCE: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'insurance.pass.title',
  'documents.pass.text': 'insurance.pass.text',
  'documents.pass.letter_note': 'insurance.pass.letter_note',
  'documents.letter.legend': 'insurance.letter.legend',
  'documents.letter.privacy': 'insurance.letter.privacy',
  'documents.letter.id': 'insurance.letter.id',
  'documents.letter.company': 'insurance.letter.company',
  'documents.letter.reference': 'insurance.letter.reference',
};
const MORTGAGE: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'mortgage.pass.title',
  'documents.pass.text': 'mortgage.pass.text',
  'documents.pass.price': 'mortgage.pass.price',
  'documents.pass.letter_note': 'mortgage.pass.letter_note',
  'documents.letter.legend': 'mortgage.letter.legend',
  'documents.letter.privacy': 'mortgage.letter.privacy',
  'documents.letter.id': 'mortgage.letter.id',
  'documents.letter.company': 'mortgage.letter.company',
  'documents.letter.reference': 'mortgage.letter.reference',
};
const ELECTRICITY: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'bills.pass.title',
  'documents.pass.price': 'bills.pass.price',
  'documents.pass.letter_note': 'bills.pass.letter_note',
  'documents.letter.legend': 'bills.letter.legend',
  'documents.letter.privacy': 'bills.letter.privacy',
  'documents.letter.id': 'bills.letter.id',
  'documents.letter.company': 'bills.letter.company',
  'documents.letter.reference': 'bills.letter.reference',
};
const TELECOM: Partial<Record<Key, Key>> = {
  'documents.pass.title': 'bills.telecom.pass.title',
  'documents.pass.price': 'bills.pass.price',
  'documents.pass.letter_note': 'bills.telecom.pass.letter_note',
  'documents.letter.legend': 'bills.telecom.letter.legend',
  'documents.letter.privacy': 'bills.telecom.letter.privacy',
  'documents.letter.id': 'bills.letter.id',
  'documents.letter.company': 'bills.telecom.letter.company',
  'documents.letter.reference': 'bills.telecom.letter.reference',
};
const OWN: Partial<Record<Key, Key>> = {
  final_pay: {},
  rental: RENTAL,
  employment: EMPLOYMENT,
  credit: CREDIT,
  insurance: INSURANCE,
  mortgage: MORTGAGE,
  electricity: ELECTRICITY,
  telecom: TELECOM,
}[review];
const tx = (key: Key) =>
  t(lang, key === 'documents.pass.text' && offer ? offer : (OWN[key] ?? key));
// The title and lead shown when only the free letters are on offer.
const FREE_ONLY = {
  employment: ['employment.letters.title', 'employment.letters.text'],
  credit: ['credit.letters.title', 'credit.letters.text'],
  insurance: ['insurance.letters.title', 'insurance.letters.text'],
  mortgage: ['mortgage.letters.title', 'mortgage.letters.text'],
  telecom: ['bills.telecom.letters.title', 'bills.telecom.letters.text'],
} as const satisfies Record<string, readonly [Key, Key]>;
const freeOnly = review in FREE_ONLY ? FREE_ONLY[review as keyof typeof FREE_ONLY] : null;
// The title and lead when nothing is to claim and the pass is still sold, quietly.
const QUIET = {
  final_pay: ['documents.pass.quiet_title', 'documents.pass.quiet_text'],
  rental: ['documents.pass.quiet_title', 'rental.pass.quiet_text'],
  employment: ['documents.pass.quiet_title', 'employment.pass.quiet_text'],
  credit: ['documents.pass.quiet_title', 'documents.pass.quiet_report_text'],
  mortgage: ['documents.pass.quiet_title', 'documents.pass.quiet_report_text'],
  electricity: ['documents.pass.quiet_title', 'documents.pass.quiet_report_text'],
  telecom: ['documents.pass.quiet_title', 'documents.pass.quiet_report_text'],
} as const satisfies Partial<Record<string, readonly [Key, Key]>>;
const quiet = review in QUIET ? QUIET[review as keyof typeof QUIET] : null;
// The title that says what the pass shows, while it is still to buy with something to claim.
const CLAIM = {
  final_pay: 'documents.pass.claim_title',
  rental: 'rental.pass.claim_title',
  employment: 'employment.pass.claim_title',
} as const satisfies Partial<Record<string, Key>>;
const claim = review in CLAIM ? CLAIM[review as keyof typeof CLAIM] : null;
---

<section class="item pass" data-pass-offer aria-labelledby="pass-title" hidden>
  <span class="item__tab pass__tab" aria-hidden="true">
    €
  </span>
  <div class="sheet">
    <h3 class="item__title" id="pass-title">
      {claim ? (
        <>
          <span data-pass-unheld>{tx(claim)}</span>
          <span data-pass-held hidden>
            {tx('documents.pass.title')}
          </span>
        </>
      ) : (
        <span data-pass-pitch>{tx('documents.pass.title')}</span>
      )}
      {freeOnly && (
        <span data-pass-free-only hidden>
          {tx(freeOnly[0])}
        </span>
      )}
      {quiet && (
        <span data-pass-quiet hidden>
          {tx(quiet[0])}
        </span>
      )}
    </h3>
    <p class="help" data-pass-pitch>
      {tx('documents.pass.text')}
    </p>
    {freeOnly && (
      <p class="help" data-pass-free-only hidden>
        {tx(freeOnly[1])}
      </p>
    )}
    {quiet && (
      <p class="help" data-pass-quiet hidden>
        {tx(quiet[1])}
      </p>
    )}
    <div data-pass-buy>
      <p class="item__note">{tx('documents.pass.price')}</p>
      <div class="checkbox">
        <input
          type="checkbox"
          id="pass-waiver"
          name="passWaiver"
          value="yes"
          aria-describedby="error-passWaiver"
        />
        <label for="pass-waiver">{tx('documents.pass.waiver')}</label>
      </div>
      <p class="errata" id="error-passWaiver" data-pass-waiver-error hidden></p>
      <p class="source">
        <a href={`${link(lang, 'aviso-legal/')}#condiciones`}>{tx('documents.pass.conditions')}</a>
      </p>
      <div class="pass__captcha" data-pass-captcha></div>
      <div class="pass__actions">
        <button class="button button--sheet" type="button" data-pass-pay>
          {tx('documents.pass.pay')}
        </button>
      </div>
      <details class="item__detail" data-pass-recover>
        <summary>{tx('documents.pass.paid_question')}</summary>
        <p class="help">{tx('documents.pass.paid_help')}</p>
        <button class="button button--sheet" type="button" data-pass-recover-button>
          {tx('documents.pass.recover')}
        </button>
      </details>
    </div>
    <div data-pass-downloads hidden>
      <p class="help" data-pass-validity></p>
      <div class="pass__actions">
        <button class="button button--sheet" type="button" data-download="report">
          {tx('documents.pass.download_report')}
        </button>
      </div>
      {!freeOnly && <PassLetter review={review} tx={tx} />}
    </div>
    {freeOnly && <PassLetter review={review} tx={tx} />}
    <p class="pass__status" role="status" aria-live="polite" data-pass-status></p>
    <p class="errata" role="alert" data-pass-error hidden></p>
    <button class="button button--sheet" type="button" data-pass-verify-retry hidden>
      {tx('documents.pass.verify_retry')}
    </button>
  </div>
</section>

<style is:inline>
  .pass:not([data-pass-mode='claim']) .pass__tab {
    display: none;
  }
  .pass__tab {
    font-size: 0.8125rem;
  }
  .pass[data-pass-mode='claim'] > .sheet {
    outline: 2px solid var(--ground);
    outline-offset: -2px;
  }
  .pass[data-pass-mode='claim'] [data-pass-pay] {
    min-block-size: 3.25rem;
    padding-inline: 1.25rem;
    border-color: var(--sheet-ink);
    background: var(--sheet-ink);
    color: var(--field-fill);
    font-size: 1.0625rem;
  }
  .pass[data-pass-mode='claim'] [data-pass-pay]:hover {
    background: color-mix(in oklab, var(--sheet-ink) 86%, var(--ground));
  }
  .pass__captcha:empty {
    display: none;
  }
  .pass__captcha {
    margin-top: 0.75rem;
    max-inline-size: 100%;
    overflow: hidden;
  }
  .pass__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .pass .checkbox {
    align-items: flex-start;
    margin-top: 0.5rem;
  }
  .pass .checkbox label {
    font: 400 0.9375rem / 1.4 var(--f-serif);
  }
  .pass__status:empty {
    display: none;
  }
  .pass__status {
    margin: 0.5rem 0 0;
    font: 400 var(--t-small) / 1.4 var(--f-serif);
  }
  .pass .field {
    margin-top: 0.5rem;
  }
  .pass__letter {
    margin: 1.25rem 0 0;
  }
  .pass__letter .field__input {
    max-inline-size: 24rem;
  }
</style>
