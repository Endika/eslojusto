---
import { createHash } from 'node:crypto';
import '@fontsource-variable/golos-text';
import golosLatin from '@fontsource-variable/golos-text/files/golos-text-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/martian-mono/standard.css';
import monoLatin from '@fontsource-variable/martian-mono/files/martian-mono-latin-standard-normal.woff2?url';
import '@fontsource-variable/noto-kufi-arabic';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, clientStrings } from '../i18n';
import { LANGS, link, publishedLangs, type Lang } from '../i18n/languages';
import { contentSecurityPolicy } from './csp';
import { DOCUMENTS } from '../documents/config';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: Lang;
  // The languages this page exists in; hreflang lists the published ones among them.
  langs?: readonly Lang[];
  section?: string;
  // One schema.org node, or several, which go out as a single @graph.
  structuredData?: object | readonly object[];
  // A page that must never be indexed, such as the 404.
  noindex?: boolean;
  // A page with the calculator talks to the documents API, when the build has one.
  calculator?: boolean;
}
const {
  title,
  description,
  path,
  lang = 'es',
  langs = publishedLangs(),
  section = 'cause',
  structuredData,
  noindex = false,
  calculator = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, '');
const url = (i: Lang) => new URL(link(i, path.replace(/^\//, '')), Astro.site);
const canonical = url(lang);
const { dir, published } = LANGS[lang];
// An unpublished language (only ar-test, under TEST_RTL=1) and a noindex page (the 404) are
// never indexed nor announced; the 404 is served at any address, so it names no canonical.
const indexable = published && !noindex;
const alternates = indexable ? langs.filter((i) => LANGS[i].published) : [];
const OG_LOCALE: Partial<Record<Lang, string>> = { es: 'es_ES' };
const ogLocale = OG_LOCALE[lang];
// The browser scripts' strings, as data: the CSP does not apply to a JSON block.
const clientStringsJson = JSON.stringify(
  clientStrings(lang, {
    documents: DOCUMENTS !== null,
    rental: path === '/alquiler/',
    employment: path === '/contrato/',
    household: path === '/empleada-de-hogar/',
    insurance: path === '/seguros/',
    credit: path === '/financiacion/',
  }),
).replace(/</g, '\\u003c');
const socialImage = new URL(`${root}/og.png`, Astro.site);
// A JSON-LD block is data, not script, so the CSP does not apply; `<` is escaped so it can't close the tag.
const graph = Array.isArray(structuredData)
  ? { '@context': 'https://schema.org', '@graph': structuredData }
  : structuredData;
const jsonLd = graph && JSON.stringify(graph).replace(/</g, '\\u003c');

// Runs before first paint so the stored or system theme never flashes; the CSP allows it by hash.
const initialTheme = `(()=>{const d=document.documentElement;d.classList.add('js');let t=null;try{t=localStorage.getItem('tema')}catch(e){}if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';d.dataset.theme=t})()`;
const themeHash = `'sha256-${createHash('sha256').update(initialTheme).digest('base64')}'`;
const csp = contentSecurityPolicy({
  themeHash,
  analytics: Boolean(import.meta.env.PUBLIC_POSTHOG_KEY),
  // Only the calculator talks to the documents API and Turnstile; every other page stays closed.
  documents: calculator ? (DOCUMENTS?.origins ?? null) : null,
});
// This page in the other published languages, for the bar that offers the browser's language.
// Only Spanish is published today, so the list is empty and the bar never shows.
const otherLangs =
  lang === 'es'
    ? alternates
        .filter((i) => i !== lang)
        .map((i) => ({ code: i, name: LANGS[i].name, url: url(i).pathname }))
    : [];
const otherLangsJson = JSON.stringify(otherLangs).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <script is:inline set:html={initialTheme} />
    <title>{title}</title>
    {/* The faces of the first screen's headings, text and citations, fetched alongside the HTML
    rather than after the CSS, so their swap lands before the first paint and moves nothing. */}
    <link rel="preload" href={golosLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!indexable && <meta name="robots" content="noindex" />}
    {alternates.map((i) => (
      <link rel="alternate" hreflang={i} href={url(i)} />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={url('es')} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    <meta property="og:site_name" content="eslojusto.es" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(lang, 'meta.og_image_alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline id="client-strings" type="application/json" set:html={clientStringsJson} />
    {otherLangs.length > 0 && (
      <script is:inline id="other-languages" type="application/json" set:html={otherLangsJson} />
    )}
  </head>
  <body data-section={section}>
    <slot name="tabs" />
    <div class="ground">
      <Header lang={lang} />
      <slot />
    </div>
    <Footer lang={lang} />
    <script>
      import '../scripts/theme';
      import '../scripts/analytics';
    </script>
  </body>
</html>
