---
import type { GetStaticPaths } from 'astro';
import { MORTGAGE_BUILD } from '../../../content/sections';
import { langPaths, type Lang } from '../../../i18n/languages';

export const getStaticPaths = (() => (MORTGAGE_BUILD ? langPaths() : [])) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;

// The literal switch, as on /hipoteca/: a build without it carries none of the page's code.
/* eslint-disable no-restricted-syntax -- a fixed path into src/views, not a boundary escape */
const Mortgage =
  import.meta.env.PUBLIC_MORTGAGE === '1'
    ? (await import('../../../views/Mortgage.astro')).default
    : null;
/* eslint-enable no-restricted-syntax */
---

{Mortgage && <Mortgage lang={lang} />}
