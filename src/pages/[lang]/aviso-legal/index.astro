---
import type { GetStaticPaths } from 'astro';
import LegalPage from '../../../views/LegalPage.astro';
import { langPaths, type Lang } from '../../../i18n/languages';
import { prose } from '../../../prose';

export const getStaticPaths = langPaths satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const Prose = prose(lang, 'legal-notice');
---

<LegalPage page="legal_notice" lang={lang}>
  <Prose lang={lang} />
</LegalPage>
