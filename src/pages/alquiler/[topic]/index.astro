---
import type { GetStaticPaths } from 'astro';
import RentalTopic from '../../../views/RentalTopic.astro';
import DepositProse from '../../../prose/es/rental-deposit.astro';
import DepositReturnProse from '../../../prose/es/rental-deposit_return.astro';
import ChargesProse from '../../../prose/es/rental-charges.astro';
import { RENTAL_PAGES, RENTAL_PAGE_IDS, type RentalPageId } from '../../../content/rental-pages';

export const getStaticPaths = (() =>
  RENTAL_PAGE_IDS.map((id) => ({
    params: { topic: RENTAL_PAGES[id].slug },
    props: { id },
  }))) satisfies GetStaticPaths;

const { id } = Astro.props as { id: RentalPageId };
---

<RentalTopic id={id} lang="es">
  {id === 'deposit' && <DepositProse lang="es" />}
  {id === 'deposit_return' && <DepositReturnProse lang="es" />}
  {id === 'charges' && <ChargesProse lang="es" />}
</RentalTopic>
